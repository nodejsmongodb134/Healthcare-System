# ─── Server ───
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ─── Database ───
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DBNAME

# ─── Auth ───
JWT_SECRET=change_me
SESSION_SECRET=change_me
CSRF_SECRET=change_me

# ─── Encryption (DO NOT ROTATE — loses all encrypted data) ───
ENCRYPTION_KEY=generate_with_64_hex_chars

# ─── Email (Brevo) ───
BREVO_API_KEY=xkeysib-your-key-here
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=Healthcare System

# ─── SMS (httpSMS) ───
HTTPSMS_API_KEY=your-httpsms-key
HTTPSMS_FROM_NUMBER=+264xxxxxxxxx
SMS_ENABLED=true

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Debug ───
DEBUG_CSRF=false
