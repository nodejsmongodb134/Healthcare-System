<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Palm Valley Medical Center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/jpeg" href="/images/palmvalley-logo.jpg">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px 0;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        .card {
            border-radius: 24px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.35);
            border: none;
            overflow: hidden;
        }
        .card-body { padding: 0; }

        /* ========== FULL-WIDTH LOGO BANNER ========== */
        .logo-banner {
            width: 100%;
            background: #ffffff;
            border-bottom: 1px solid #edf2f7;
            overflow: hidden;
            line-height: 0;
        }
        .logo-banner img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        /* ========== CONTENT AREA ========== */
        .content-area { padding: 36px 40px 32px; }

        /* ========== HEADING ========== */
        .page-title {
            text-align: center;
            color: #1a202c;
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .page-subtitle {
            text-align: center;
            color: #4a5568;
            font-size: 0.85rem;
            letter-spacing: 0.2px;
            margin-bottom: 26px;
        }
        .page-subtitle .accent {
            color: #0e9f6e;
            font-weight: 700;
        }

        /* ========== BUTTONS ========== */
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(102,126,234,0.35);
            transition: transform 0.15s, box-shadow 0.2s;
            font-size: 1rem;
        }
        .btn-primary:hover,
        .btn-primary:focus {
            background: linear-gradient(135deg, #5a67d8 0%, #6b3fa0 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(102,126,234,0.45);
        }
        .btn-outline-secondary {
            color: #1a4d5c;
            border-color: #1a4d5c;
            border-width: 2px;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            font-size: 1rem;
            transition: transform 0.15s, background 0.2s, color 0.2s;
        }
        .btn-outline-secondary:hover,
        .btn-outline-secondary:focus {
            background: #1a4d5c;
            border-color: #1a4d5c;
            color: #fff;
            transform: translateY(-2px);
        }

        /* ========== TRUST STRIP ========== */
        .trust-strip {
            display: flex;
            justify-content: center;
            gap: 22px;
            margin-top: 26px;
            padding-top: 22px;
            border-top: 1px solid #edf2f7;
            flex-wrap: wrap;
        }
        .trust-item {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #718096;
            font-size: 0.78rem;
        }
        .trust-item i { color: #0e9f6e; font-size: 1rem; }

        /* ========== FOOTER ========== */
        .pv-footer {
            text-align: center;
            color: rgba(255,255,255,0.85);
            margin-top: 18px;
            font-size: 0.78rem;
        }
        .pv-footer i { color: #ffd166; margin-right: 4px; }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 575.98px) {
            body { padding: 10px 0; }
            .card { border-radius: 18px; margin: 0 10px; }
            .content-area { padding: 24px 20px 22px; }
            .page-title { font-size: 1.05rem; }
            .page-subtitle { font-size: 0.78rem; margin-bottom: 20px; }
            .btn-primary, .btn-outline-secondary { font-size: 0.95rem; padding: 0.6rem 1rem; }
            .trust-strip { gap: 14px; }
            .trust-item { font-size: 0.72rem; }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .content-area { padding: 32px 32px 28px; }
        }
        @media (min-width: 992px) {
            .content-area { padding: 40px 44px 36px; }
        }
        @media (prefers-reduced-motion: reduce) {
            * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card">

                    <!-- ===================== FULL-WIDTH LOGO BANNER ===================== -->
                    <div class="logo-banner">
                        <img src="/images/palmvalley-logo.jpg"
                             alt="Palm Valley Medical Center">
                    </div>

                    <!-- ===================== CONTENT AREA ===================== -->
                    <div class="content-area">

                        <p class="page-title">
                            <i class="bi bi-heart-pulse"></i> Welcome
                        </p>
                        <p class="page-subtitle">
                            Compassionate care, <span class="accent">booked in seconds</span>.
                        </p>

                        <%- include('./partials/flash') %>

                        <div class="d-grid gap-3">
                            <a href="/auth/login" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i> Login
                            </a>
                            <a href="/auth/register" class="btn btn-outline-secondary">
                                <i class="bi bi-person-plus"></i> Register
                            </a>
                        </div>

                        <!-- ===================== TRUST STRIP ===================== -->
                        <div class="trust-strip">
                            <div class="trust-item">
                                <i class="bi bi-shield-check"></i> Secure &amp; private
                            </div>
                            <div class="trust-item">
                                <i class="bi bi-clock-history"></i> 24/7 booking
                            </div>
                            <div class="trust-item">
                                <i class="bi bi-geo-alt"></i> Windhoek, Namibia
                            </div>
                        </div>

                    </div><!-- /.content-area -->

                </div>

                <p class="pv-footer">
                    <i class="bi bi-heart-pulse"></i>
                    &copy; <%= new Date().getFullYear() %> Palm Valley Medical Center &mdash; All rights reserved
                </p>

            </div>
        </div>
    </div>
</body>
</html>