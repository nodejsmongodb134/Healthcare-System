<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 8px 0;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        }
        .navbar-brand {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .navbar-brand i {
            font-size: 1.2rem;
        }
        .navbar-text {
            font-size: 0.8rem;
        }
        .navbar .btn-outline-light {
            border-width: 1.5px;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        /* mobile nav adjustments */
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text {
                font-size: 0.7rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.75rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
            border: none;
            background: #fff;
            transition: box-shadow 0.2s ease;
        }
        .card:hover {
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
        }
        .card h4 {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h4 i {
            color: #667eea;
            font-size: 1.2rem;
        }
        .card hr {
            margin: 0.75rem 0 1rem 0;
            opacity: 0.6;
        }
        /* card padding responsive */
        .card.p-4 {
            padding: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-4 {
                padding: 1rem !important;
            }
            .card h4 {
                font-size: 0.95rem;
            }
            .card h4 i {
                font-size: 1rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-4 {
                padding: 1.75rem !important;
            }
        }

        /* ===== INFO ROWS ===== */
        .info-row {
            display: flex;
            padding: 10px 0;
            border-bottom: 1px solid #f0f2f6;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .info-row:last-of-type {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #4a5568;
            min-width: 100px;
            flex-shrink: 0;
            font-size: 0.85rem;
            letter-spacing: 0.2px;
        }
        .info-value {
            flex: 1;
            color: #1a202c;
            word-break: break-word;
            font-size: 0.85rem;
        }
        /* responsive info rows */
        @media (max-width: 575.98px) {
            .info-row {
                flex-direction: column;
                padding: 8px 0;
                gap: 2px;
            }
            .info-label {
                min-width: auto;
                width: 100%;
                font-size: 0.75rem;
                color: #718096;
                font-weight: 600;
            }
            .info-value {
                width: 100%;
                font-size: 0.82rem;
                padding-bottom: 2px;
            }
            .info-row:last-of-type {
                border-bottom: none;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .info-label {
                min-width: 80px;
                font-size: 0.8rem;
            }
            .info-value {
                font-size: 0.82rem;
            }
        }
        @media (min-width: 768px) and (max-width: 991.98px) {
            .info-label {
                min-width: 110px;
                font-size: 0.85rem;
            }
            .info-value {
                font-size: 0.85rem;
            }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.3px;
            line-height: 1.5;
        }
        .status-pending {
            background: #fff3cd;
            color: #856404;
        }
        .status-confirmed {
            background: #28a745;
            color: #fff;
        }
        .status-cancelled {
            background: #dc3545;
            color: #fff;
        }
        .status-completed {
            background: #17a2b8;
            color: #fff;
        }
        /* fallback for unknown status */
        .status-unknown {
            background: #e2e8f0;
            color: #2d3748;
        }
        @media (max-width: 575.98px) {
            .status-badge {
                font-size: 0.7rem;
                padding: 3px 12px;
            }
            .info-value .status-badge {
                display: inline-block;
                margin-top: 1px;
            }
        }

        /* ===== BUTTONS ===== */
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 500;
            padding: 0.4rem 1.2rem;
            font-size: 0.82rem;
            border-radius: 30px;
            transition: all 0.2s ease;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                padding: 0.35rem 1rem;
                font-size: 0.75rem;
                width: 100%;
                justify-content: center;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }
            .mt-3 .btn-secondary {
                width: 100%;
            }
        }

        /* ===== GRID / COLUMN RESPONSIVE ===== */
        .row .col-md-6 {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }
        @media (max-width: 575.98px) {
            .row .col-md-6 {
                padding-left: 0;
                padding-right: 0;
            }
            .row .col-md-6:first-child {
                margin-bottom: 4px;
            }
            .row .col-md-6:last-child {
                margin-top: 4px;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .row .col-md-6 {
                padding-left: 0.5rem;
                padding-right: 0.5rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== UTILITY ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }

        /* ===== BADGE ROLE ===== */
        .badge-role {
            font-size: 0.6rem;
            padding: 0.2rem 0.5rem;
            font-weight: 500;
            letter-spacing: 0.2px;
        }

        /* ===== RESPONSIVE FINE-TUNE ===== */
        @media (max-width: 575.98px) {
            /* ensure status badge is always visible and not cut off */
            .info-value .status-badge {
                font-size: 0.7rem;
                padding: 3px 12px;
            }
            /* back button full width */
            .mt-3 .btn-secondary {
                width: 100%;
                justify-content: center;
            }
        }

        /* ===== ANIMATIONS ===== */
        .card {
            transition: transform 0.15s ease, box-shadow 0.2s ease;
        }

        /* ===== PRINT / REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a {
            touch-action: manipulation;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                min-height: 44px;
            }
            .navbar .btn-outline-light {
                min-height: 32px;
                min-width: 44px;
            }
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <div class="navbar-nav ms-auto align-items-center flex-nowrap">
                <span class="navbar-text text-white me-2 me-sm-3 d-flex align-items-center">
                    <i class="bi bi-person-circle me-1"></i>
                    <span class="d-none d-sm-inline"><%= user.name %></span>
                    <span class="d-inline d-sm-none"><%= user.name.split(' ')[0] %></span>
                    <span class="badge bg-light text-dark ms-2 badge-role"><%= user.role %></span>
                </span>
                <a href="/admin/appointments" class="btn btn-outline-light btn-sm me-1 me-sm-2">
                    <i class="bi bi-arrow-left"></i>
                    <span class="d-none d-sm-inline">Back</span>
                </a>
                <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-sm-inline">Logout</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="container mt-3 mt-sm-4">

        <div class="card p-3 p-sm-4">

            <!-- Header -->
            <h4>
                <i class="bi bi-calendar-check"></i>
                Appointment Details
            </h4>
            <hr />

            <!-- Two-column info -->
            <div class="row">
                <!-- Left column -->
                <div class="col-md-6">
                    <div class="info-row">
                        <span class="info-label">Patient</span>
                        <span class="info-value"><%= appointment.patientName %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value"><%= appointment.patientEmail %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Phone</span>
                        <span class="info-value"><%= appointment.patientPhone %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Date</span>
                        <span class="info-value"><%= new Date(appointment.date).toLocaleDateString() %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Time</span>
                        <span class="info-value"><%= appointment.time %></span>
                    </div>
                </div>

                <!-- Right column -->
                <div class="col-md-6">
                    <div class="info-row">
                        <span class="info-label">Status</span>
                        <span class="info-value">
                            <span class="status-badge status-<%= appointment.status %>">
                                <%= appointment.status %>
                            </span>
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Description</span>
                        <span class="info-value"><%= appointment.description %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Created</span>
                        <span class="info-value"><%= new Date(appointment.createdAt).toLocaleString() %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Updated</span>
                        <span class="info-value"><%= new Date(appointment.updatedAt).toLocaleString() %></span>
                    </div>
                </div>
            </div>

            <!-- Back button -->
            <div class="mt-3">
                <a href="/admin/appointments" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Appointments
                </a>
            </div>

        </div>
        <!-- /.card -->

    </div>
    <!-- /.container -->

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>