<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f4f7fc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
        }
        .navbar-brand i {
            font-size: 1.3rem;
            margin-right: 6px;
        }
        .navbar-text {
            font-weight: 500;
            font-size: 0.85rem;
        }
        .navbar-text .badge {
            font-weight: 600;
            padding: 0.3rem 0.65rem;
        }
        .navbar .btn-outline-light {
            border-width: 2px;
            font-weight: 600;
            padding: 0.25rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 1rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            background: #ffffff;
            transition: box-shadow 0.3s ease;
            overflow: hidden;
        }
        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }
        .card h4 {
            font-weight: 700;
            color: #1a202c;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
        }
        .card h4 i {
            color: #667eea;
            font-size: 1.3rem;
        }
        .card hr {
            opacity: 0.2;
            margin: 0.75rem 0 1.25rem 0;
        }

        /* card padding responsive */
        .card.p-4 {
            padding: 1.75rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-4 {
                padding: 1.25rem !important;
            }
            .card h4 {
                font-size: 1rem;
            }
            .card h4 i {
                font-size: 1.1rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-4 {
                padding: 2rem !important;
            }
        }
        @media (min-width: 992px) {
            .card.p-4 {
                padding: 2.25rem !important;
            }
        }

        /* ===== INFO ROWS ===== */
        .info-row {
            display: flex;
            padding: 10px 0;
            border-bottom: 1px solid #edf2f7;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .info-row:last-of-type {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #4a5568;
            min-width: 120px;
            flex-shrink: 0;
            font-size: 0.85rem;
            letter-spacing: 0.2px;
            padding-top: 2px;
        }
        .info-value {
            flex: 1;
            color: #1a202c;
            word-break: break-word;
            font-size: 0.85rem;
        }

        /* responsive info rows */
        @media (max-width: 575.98px) {
            .info-row {
                flex-direction: column;
                padding: 8px 0;
                gap: 2px;
            }
            .info-label {
                min-width: auto;
                width: 100%;
                font-size: 0.75rem;
                color: #718096;
                font-weight: 600;
                padding-top: 0;
            }
            .info-value {
                width: 100%;
                font-size: 0.82rem;
                padding-bottom: 2px;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .info-label {
                min-width: 90px;
                font-size: 0.8rem;
            }
            .info-value {
                font-size: 0.82rem;
            }
        }
        @media (min-width: 768px) and (max-width: 991.98px) {
            .info-label {
                min-width: 110px;
                font-size: 0.85rem;
            }
            .info-value {
                font-size: 0.85rem;
            }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.3px;
            line-height: 1.5;
        }
        .status-unread {
            background: #dc3545;
            color: #fff;
        }
        .status-read {
            background: #17a2b8;
            color: #fff;
        }
        .status-replied {
            background: #28a745;
            color: #fff;
        }
        /* fallback */
        .status-unknown {
            background: #e2e8f0;
            color: #2d3748;
        }
        @media (max-width: 575.98px) {
            .status-badge {
                font-size: 0.7rem;
                padding: 3px 12px;
            }
            .info-value .status-badge {
                display: inline-block;
                margin-top: 1px;
            }
        }

        /* ===== BUTTONS ===== */
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 600;
            padding: 0.4rem 1.4rem;
            font-size: 0.82rem;
            border-radius: 40px;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                width: 100%;
                justify-content: center;
                min-height: 44px;
                font-size: 0.78rem;
                padding: 0.35rem 1rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== UTILITIES ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
        .gap-2 {
            gap: 0.5rem !important;
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/messages" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card p-4">

                <!-- Header -->
                <h4><i class="bi bi-envelope"></i> Message Details</h4>
                <hr />

                <!-- Message Info -->
                <div class="info-row">
                    <span class="info-label">From</span>
                    <span class="info-value"><%= message.patientName %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value"><%= message.patientEmail %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value"><%= message.patientPhone %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Subject</span>
                    <span class="info-value"><%= message.subject %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Message</span>
                    <span class="info-value"><%= message.message %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Status</span>
                    <span class="info-value">
                        <span class="status-badge status-<%= message.status %>"><%= message.status %></span>
                    </span>
                </div>

                <!-- Nurse Reply (if any) -->
                <% if (message.nurseReply) { %>
                    <div class="info-row">
                        <span class="info-label">Nurse Reply</span>
                        <span class="info-value"><%= message.nurseReply %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Replied by</span>
                        <span class="info-value"><%= message.nurseName || 'Nurse' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Reply Date</span>
                        <span class="info-value"><%= message.replyDate ? new Date(message.replyDate).toLocaleString() : 'N/A' %></span>
                    </div>
                <% } %>

                <!-- Back Button -->
                <div class="mt-3">
                    <a href="/admin/messages" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Messages
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>