<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f4f7fc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
        }
        .navbar-brand i {
            font-size: 1.3rem;
            margin-right: 6px;
        }
        .navbar-text {
            font-weight: 500;
            font-size: 0.85rem;
        }
        .navbar-text .badge {
            font-weight: 600;
            padding: 0.3rem 0.65rem;
        }
        .navbar .btn-outline-light {
            border-width: 2px;
            font-weight: 600;
            padding: 0.25rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 1rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            background: #ffffff;
            transition: box-shadow 0.3s ease;
        }
        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }
        .card h4 {
            font-weight: 700;
            color: #1a202c;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
        }
        .card h4 i {
            color: #667eea;
            font-size: 1.3rem;
        }
        .card hr {
            opacity: 0.2;
            margin: 0.75rem 0 1.25rem 0;
        }

        /* card padding responsive */
        .card.p-3.p-md-4 {
            padding: 1.25rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-3.p-md-4 {
                padding: 1rem !important;
            }
            .card h4 {
                font-size: 1rem;
            }
            .card h4 i {
                font-size: 1.1rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-3.p-md-4 {
                padding: 1.75rem !important;
            }
        }
        @media (min-width: 992px) {
            .card.p-3.p-md-4 {
                padding: 2rem !important;
            }
        }

        /* ===== TABLE ===== */
        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            max-height: 600px;
            overflow-y: auto;
        }
        .table-responsive::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }

        .table {
            font-size: 0.82rem;
            margin-bottom: 0;
            min-width: 700px;
        }
        .table th {
            font-weight: 700;
            color: #4a5568;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.65rem 0.6rem;
            white-space: nowrap;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .table td {
            padding: 0.5rem 0.6rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }
        .table tbody tr:hover {
            background: #f7f9fc;
        }
        .table .text-truncate {
            max-width: 120px;
            display: inline-block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.2px;
            line-height: 1.6;
        }
        .status-active,
        .status-confirmed,
        .status-delivered,
        .status-replied {
            background: #28a745;
            color: #fff;
        }
        .status-inactive,
        .status-cancelled,
        .status-unread {
            background: #dc3545;
            color: #fff;
        }
        .status-pending,
        .status-on-leave {
            background: #ffc107;
            color: #856404;
        }
        .status-completed,
        .status-in-transit,
        .status-read {
            background: #17a2b8;
            color: #fff;
        }
        .status-unknown {
            background: #e2e8f0;
            color: #2d3748;
        }
        .badge-verified {
            background: #28a745;
            color: #fff;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.65rem;
        }
        .badge-unverified {
            background: #ffc107;
            color: #856404;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.65rem;
        }

        @media (max-width: 575.98px) {
            .table {
                font-size: 0.7rem;
                min-width: 550px;
            }
            .table th,
            .table td {
                padding: 0.3rem 0.4rem;
            }
            .table th {
                font-size: 0.65rem;
            }
            .status-badge {
                font-size: 0.6rem;
                padding: 2px 10px;
            }
            .table .text-truncate {
                max-width: 80px;
            }
            .table-responsive {
                max-height: 400px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .table {
                font-size: 0.78rem;
                min-width: 620px;
            }
            .table th,
            .table td {
                padding: 0.4rem 0.5rem;
            }
        }

        /* ===== ACTION BUTTONS ===== */
        .action-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 3px;
        }
        .action-group .btn {
            border-radius: 30px;
            padding: 0.2rem 0.5rem;
            font-size: 0.7rem;
            min-height: 30px;
            min-width: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-width: 1.5px;
            transition: all 0.15s ease;
        }
        .action-group .btn i {
            font-size: 0.8rem;
        }
        .action-group .btn-outline-primary {
            color: #667eea;
            border-color: #d1d9f5;
        }
        .action-group .btn-outline-primary:hover {
            background: #667eea;
            color: #fff;
            border-color: #667eea;
        }
        .action-group .btn-outline-warning {
            color: #d69e2e;
            border-color: #f6e5c3;
        }
        .action-group .btn-outline-warning:hover {
            background: #d69e2e;
            color: #fff;
            border-color: #d69e2e;
        }
        .action-group .btn-outline-danger {
            color: #e53e3e;
            border-color: #f5d0d0;
        }
        .action-group .btn-outline-danger:hover {
            background: #e53e3e;
            color: #fff;
            border-color: #e53e3e;
        }
        .action-group .btn-outline-secondary {
            color: #718096;
            border-color: #e2e8f0;
        }
        .action-group .btn-outline-secondary:hover {
            background: #718096;
            color: #fff;
            border-color: #718096;
        }
        .action-group .btn-outline-info {
            color: #17a2b8;
            border-color: #b8e4ed;
        }
        .action-group .btn-outline-info:hover {
            background: #17a2b8;
            color: #fff;
            border-color: #17a2b8;
        }

        /* Action dropdown toggle */
        .action-group .dropdown-toggle::after {
            display: none;
        }
        .action-group .dropdown-menu {
            border-radius: 12px;
            border: none;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            padding: 0.25rem 0;
            min-width: 140px;
        }
        .action-group .dropdown-menu .dropdown-item {
            font-size: 0.78rem;
            padding: 0.4rem 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #2d3748;
            transition: background 0.15s ease;
        }
        .action-group .dropdown-menu .dropdown-item i {
            font-size: 0.9rem;
            width: 18px;
            text-align: center;
        }
        .action-group .dropdown-menu .dropdown-item:hover {
            background: #667eea;
            color: #fff;
        }
        .action-group .dropdown-menu .dropdown-item.danger:hover {
            background: #e53e3e;
            color: #fff;
        }

        /* Mobile action buttons */
        @media (max-width: 575.98px) {
            .action-group .btn {
                padding: 0.15rem 0.35rem;
                font-size: 0.6rem;
                min-height: 26px;
                min-width: 26px;
            }
            .action-group .btn i {
                font-size: 0.7rem;
            }
            .action-group {
                gap: 2px;
            }
            .action-group .dropdown-menu .dropdown-item {
                font-size: 0.7rem;
                padding: 0.3rem 0.8rem;
            }
            .action-group .dropdown-menu .dropdown-item i {
                font-size: 0.8rem;
                width: 16px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .action-group .btn {
                padding: 0.2rem 0.4rem;
                font-size: 0.65rem;
                min-height: 28px;
                min-width: 28px;
            }
            .action-group .btn i {
                font-size: 0.75rem;
            }
        }

        /* ===== BUTTONS ===== */
        .btn {
            border-radius: 40px;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            font-size: 0.82rem;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-primary {
            background: #667eea;
            border-color: #667eea;
        }
        .btn-primary:hover {
            background: #5a67d8;
            border-color: #5a67d8;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.25);
        }
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }

        @media (max-width: 575.98px) {
            .btn {
                font-size: 0.75rem;
                padding: 0.4rem 1rem;
                min-height: 38px;
                width: 100%;
            }
            .back-wrapper .btn-secondary {
                width: 100%;
                justify-content: center;
            }
        }

        /* ===== ALERT ===== */
        .alert {
            border-radius: 12px;
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
            animation: slideDown 0.4s ease-out;
            border: none;
        }
        .alert-success {
            background: #c6f6d5;
            color: #22543d;
        }
        .alert-danger {
            background: #fed7d7;
            color: #9b2c2c;
        }
        .alert i {
            margin-right: 6px;
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (max-width: 575.98px) {
            .alert {
                font-size: 0.75rem;
                padding: 0.5rem 0.75rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .dropdown-item {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== UTILITIES ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
        .back-wrapper {
            margin-top: 1.25rem;
        }
        @media (max-width: 575.98px) {
            .back-wrapper {
                margin-top: 0.75rem;
            }
        }

        /* ===== NO RECORDS ===== */
        .no-records {
            padding: 2.5rem 1rem;
            text-align: center;
            color: #a0aec0;
        }
        .no-records i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: 0.5rem;
            opacity: 0.5;
        }
        @media (max-width: 575.98px) {
            .no-records {
                padding: 1.5rem 0.5rem;
                font-size: 0.8rem;
            }
            .no-records i {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="card p-3 p-md-4">

        <!-- Header -->
        <h4><i class="bi bi-list-ul"></i> <%= title %></h4>
        <hr />

        <!--------- Flash Messages -------------->

        <%- include('../partials/flash') %>


        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <% if (type === 'appointments') { %>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Status</th>
                            <th>Description</th>
                        <% } else if (type === 'messages') { %>
                            <th>From</th>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Date</th>
                        <% } else if (type === 'orders') { %>
                            <th>Patient</th>
                            <th>Prescription</th>
                            <th>Status</th>
                            <th>Location</th>
                            <th>Date</th>
                        <% } else if (type === 'patients') { %>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Verified</th>
                            <th>Joined</th>
                        <% } else if (type === 'drivers') { %>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th>Vehicle</th>
                        <% } else if (type === 'nurses') { %>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Verified</th>
                            <th>Joined</th>
                        <% } %>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (items.length === 0) { %>
                        <tr>
                            <td colspan="10">
                                <div class="no-records">
                                    <i class="bi bi-inbox"></i>
                                    No records found
                                </div>
                            </td>
                        </tr>
                    <% } %>
                    <% items.forEach((item, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>

                        <!-- ===== DYNAMIC COLUMNS ===== -->
                        <% if (type === 'appointments') { %>
                            <td><%= item.patientName %></td>
                            <td><%= new Date(item.date).toLocaleDateString() %></td>
                            <td><%= item.time %></td>
                            <td><span class="status-badge status-<%= item.status %>"><%= item.status %></span></td>
                            <td><span class="text-truncate" title="<%= item.description %>"><%= item.description %></span></td>
                        <% } else if (type === 'messages') { %>
                            <td><%= item.patientName %></td>
                            <td><span class="text-truncate" title="<%= item.subject %>"><%= item.subject %></span></td>
                            <td><span class="status-badge status-<%= item.status %>"><%= item.status %></span></td>
                            <td><%= new Date(item.createdAt).toLocaleDateString() %></td>
                        <% } else if (type === 'orders') { %>
                            <td><%= item.patientName %></td>
                            <td><span class="text-truncate" title="<%= item.prescriptionName %>"><%= item.prescriptionName %></span></td>
                            <td><span class="status-badge status-<%= item.status %>"><%= item.status %></span></td>
                            <td><span class="text-truncate" title="<%= item.location %>"><%= item.location %></span></td>
                            <td><%= new Date(item.orderDate).toLocaleDateString() %></td>
                        <% } else if (type === 'patients') { %>
                            <td><%= item.name %></td>
                            <td><%= item.email %></td>
                            <td><span class="<%= item.isVerified ? 'badge-verified' : 'badge-unverified' %>"><%= item.isVerified ? 'Yes' : 'No' %></span></td>
                            <td><%= new Date(item.createdAt).toLocaleDateString() %></td>
                        <% } else if (type === 'drivers') { %>
                            <td><%= item.name %></td>
                            <td><%= item.email %></td>
                            <td><%= item.phone %></td>
                            <td><span class="status-badge status-<%= item.status %>"><%= item.status %></span></td>
                            <td><%= item.vehicleType || 'N/A' %></td>
                        <% } else if (type === 'nurses') { %>
                            <td><%= item.name %></td>
                            <td><%= item.email %></td>
                            <td><span class="<%= item.isVerified ? 'badge-verified' : 'badge-unverified' %>"><%= item.isVerified ? 'Yes' : 'No' %></span></td>
                            <td><%= new Date(item.createdAt).toLocaleDateString() %></td>
                        <% } %>

                        <!-- ===== ACTIONS COLUMN ===== -->
                        <td>
                            <div class="action-group justify-content-center">

                                <!-- View -->
                                <a href="/admin/<%= (function(){ let p='#'; if(type==='patients') p='patients'; else if(type==='nurses') p='nurses'; else if(type==='drivers') p='drivers'; else if(type==='appointments') p='appointments'; else if(type==='messages') p='messages'; else if(type==='orders') p='orders'; return p; })() %>/<%= item._id %>"
                                class="btn btn-outline-primary" title="View">
                                <i class="bi bi-eye"></i>
                                <span class="d-none d-sm-inline">View</span>
                            </a>

                            <!-- ===== DRIVER-SPECIFIC ACTIONS ===== -->
                            <% if (type === 'drivers') { %>

                                <!-- Edit -->
                                <a href="/admin/drivers/edit/<%= item._id %>" class="btn btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-sm-inline">Edit</span>
                                </a>

                                <!-- Delete -->
                                <form action="/admin/drivers/delete/<%= item._id %>" method="POST" style="display:inline;"
                                onsubmit="return confirm('Delete this driver?')">
                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-sm-inline">Delete</span>
                                </button>
                            </form>

                            <!-- Reset Password -->
                            <form action="/admin/drivers/reset-password/<%= item._id %>" method="POST" style="display:inline;"
                            onsubmit="return confirm('Reset password for this driver?')">
                            <button type="submit" class="btn btn-outline-secondary" title="Reset Password">
                                <i class="bi bi-key"></i>
                                <span class="d-none d-sm-inline">Reset</span>
                            </button>
                        </form>

                        <!-- Status Dropdown -->
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-info dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false" title="Change Status">
                            <i class="bi bi-toggle-on"></i>
                            <span class="d-none d-sm-inline">Status</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#" onclick="changeStatus('<%= item._id %>', 'active')">
                                <i class="bi bi-check-circle text-success"></i> Active
                            </a></li>
                            <li><a class="dropdown-item" href="#" onclick="changeStatus('<%= item._id %>', 'on-leave')">
                                <i class="bi bi-clock text-warning"></i> On Leave
                            </a></li>
                            <li><a class="dropdown-item" href="#" onclick="changeStatus('<%= item._id %>', 'inactive')">
                                <i class="bi bi-x-circle text-danger"></i> Inactive
                            </a></li>
                        </ul>
                    </div>

                <% } else { %>

                    <!-- For non-driver types: show a simple action menu -->
                    <div class="btn-group" role="group">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" title="More actions">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/admin/<%= (function(){ let p='#'; if(type==='patients') p='patients'; else if(type==='nurses') p='nurses'; else if(type==='appointments') p='appointments'; else if(type==='messages') p='messages'; else if(type==='orders') p='orders'; return p; })() %>/<%= item._id %>">
                            <i class="bi bi-eye"></i> View
                        </a></li>
                        <% if (type === 'appointments' || type === 'orders' || type === 'messages') { %>
                            <li><a class="dropdown-item" href="#" onclick="alert('Edit functionality coming soon')">
                                <i class="bi bi-pencil"></i> Edit
                            </a></li>
                        <% } %>
                        <% if (type === 'patients' || type === 'nurses') { %>
                            <li><a class="dropdown-item" href="#" onclick="alert('Toggle status coming soon')">
                                <i class="bi bi-toggle-on"></i> Toggle Status
                            </a></li>
                        <% } %>
                    </ul>
                </div>

            <% } %>

        </div>
    </td>
</tr>
<% }) %>
</tbody>
</table>
</div>

<!-- Back Button -->
<div class="back-wrapper">
    <a href="/admin/dashboard" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

</div>
</div>

<!-- ===== SCRIPTS ===== -->
<script>
    // ===== CHANGE DRIVER STATUS =====
    function changeStatus(id, status) {
        if (confirm(`Change driver status to "${status}"?`)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/admin/drivers/status/${id}`;
                // Auto-injected CSRF token
                var _csrfMeta = document.querySelector('meta[name="csrf-token"]');
                if (_csrfMeta) {
                    var _csrfInput = document.createElement('input');
                    _csrfInput.type = 'hidden';
                    _csrfInput.name = '_csrf';
                    _csrfInput.value = _csrfMeta.getAttribute('content');
                    form.appendChild(_csrfInput);
                }
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'status';
            input.value = status;
            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    }

    // ===== AUTO-DISMISS FLASH MESSAGES =====
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.alert').forEach(a => {
            setTimeout(() => {
                a.style.transition = 'opacity 0.5s ease';
                a.style.opacity = '0';
                setTimeout(() => a.style.display = 'none', 500);
            }, 5000);
        });
    });
</script>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>