<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f4f7fc;
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
        }
        .navbar-brand i {
            font-size: 1.3rem;
            margin-right: 6px;
        }
        .navbar-text {
            font-weight: 500;
            font-size: 0.85rem;
        }
        .navbar-text .badge {
            font-weight: 600;
            padding: 0.3rem 0.65rem;
        }
        .navbar .btn-outline-light {
            border-width: 2px;
            font-weight: 600;
            padding: 0.25rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 1rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== ALERT ===== */
        .alert {
            border-radius: 14px;
            font-size: 0.85rem;
            padding: 0.75rem 1.25rem;
            animation: slideDown 0.4s ease-out;
            border: none;
        }
        .alert-info {
            background: #e8edff;
            color: #2d3b7a;
            border-left: 4px solid #667eea;
        }
        .alert-info h4 {
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 0.15rem;
        }
        .alert-info p {
            font-size: 0.85rem;
            opacity: 0.85;
            margin-bottom: 0;
        }
        .alert-info i {
            color: #667eea;
            font-size: 1.2rem;
            margin-right: 8px;
        }
        .alert-success {
            background: #c6f6d5;
            color: #22543d;
        }
        .alert-danger {
            background: #fed7d7;
            color: #9b2c2c;
        }
        .alert i {
            margin-right: 6px;
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (max-width: 575.98px) {
            .alert {
                font-size: 0.75rem;
                padding: 0.6rem 0.9rem;
                border-radius: 12px;
            }
            .alert-info h4 {
                font-size: 0.9rem;
            }
            .alert-info p {
                font-size: 0.75rem;
            }
            .alert-info i {
                font-size: 1rem;
            }
        }

        /* ===== EXPORT CARDS ===== */
        .export-card {
            background: #ffffff;
            border: none;
            border-radius: 18px;
            padding: 1.5rem 1rem;
            text-align: center;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }
        .export-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #667eea, #764ba2);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .export-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 40px rgba(102, 126, 234, 0.12);
        }
        .export-card:hover::before {
            opacity: 1;
        }

        .export-icon {
            font-size: 3.2rem;
            color: #667eea;
            line-height: 1;
            margin-bottom: 0.5rem;
            transition: transform 0.3s ease;
        }
        .export-card:hover .export-icon {
            transform: scale(1.05);
        }

        .export-card h5 {
            font-weight: 700;
            font-size: 0.95rem;
            color: #1a202c;
            margin-bottom: 0.2rem;
            letter-spacing: -0.2px;
        }
        .export-card .small {
            font-size: 0.75rem;
            color: #a0aec0;
            margin-bottom: 1rem;
            flex-grow: 1;
        }

        /* ===== BUTTONS ===== */
        .btn {
            border-radius: 40px;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            font-size: 0.8rem;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-primary {
            background: #667eea;
            border-color: #667eea;
        }
        .btn-primary:hover {
            background: #5a67d8;
            border-color: #5a67d8;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.3);
        }
        .btn-primary i {
            font-size: 0.9rem;
        }
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            font-size: 0.8rem;
            border-radius: 40px;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }

        /* export card button - inherit from card */
        .export-card .btn {
            width: 100%;
            max-width: 200px;
        }

        @media (max-width: 575.98px) {
            .btn,
            .btn-secondary {
                font-size: 0.75rem;
                padding: 0.4rem 1rem;
                min-height: 38px;
                width: 100%;
                max-width: 100%;
            }
            .export-card .btn {
                max-width: 100%;
            }
            .export-card {
                padding: 1.25rem 0.75rem;
                border-radius: 14px;
            }
            .export-icon {
                font-size: 2.6rem;
            }
            .export-card h5 {
                font-size: 0.85rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .export-card {
                padding: 1.5rem 1rem;
            }
            .export-icon {
                font-size: 2.8rem;
            }
            .export-card .btn {
                max-width: 100%;
            }
        }
        @media (min-width: 992px) {
            .export-card .btn {
                max-width: 180px;
            }
        }

        /* ===== GRID ===== */
        .row.g-4 {
            --bs-gutter-y: 1.25rem;
            --bs-gutter-x: 1.25rem;
        }
        @media (max-width: 575.98px) {
            .row.g-4 {
                --bs-gutter-y: 0.75rem;
                --bs-gutter-x: 0.75rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== BACK BUTTON WRAPPER ===== */
        .back-wrapper {
            margin-top: 1.5rem;
        }
        @media (max-width: 575.98px) {
            .back-wrapper {
                margin-top: 1rem;
            }
            .back-wrapper .btn-secondary {
                width: 100%;
                justify-content: center;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
            .export-card:hover {
                transform: none !important;
            }
            .export-card:hover::before {
                opacity: 0 !important;
            }
        }

        /* ===== COUNTER BADGE (optional extra) ===== */
        .export-card .count-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #edf2f7;
            color: #4a5568;
            font-size: 0.6rem;
            font-weight: 700;
            padding: 0.15rem 0.6rem;
            border-radius: 20px;
            letter-spacing: 0.3px;
        }
        @media (max-width: 575.98px) {
            .export-card .count-badge {
                top: 8px;
                right: 8px;
                font-size: 0.5rem;
                padding: 0.1rem 0.5rem;
            }
        }

        /* ===== RESPONSIVE CARD HEIGHTS ===== */
        .export-card .card-body-inner {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        /* ===== MISC ===== */
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-0 {
            margin-bottom: 0 !important;
        }
        .text-muted {
            color: #a0aec0 !important;
        }
    </style>
    <link rel="stylesheet" href="/css/admin-responsive.css">
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">

    <!-- Header Alert -->
    <div class="alert alert-info d-flex align-items-start gap-2">
        <i class="bi bi-download mt-1"></i>
        <div>
            <h4 class="h5">Export Data</h4>
            <p class="mb-0">Download CSV files for offline analysis and reporting.</p>
        </div>
    </div>

    <!--------- Flash Messages -------------->

    <%- include('../partials/flash') %>


    <!-- Export Cards Grid -->
    <div class="row g-3 g-md-4">

        <!-- Patients -->
        <div class="col-6 col-md-3">
            <div class="export-card">
                <div class="count-badge">CSV</div>
                <div class="export-icon"><i class="bi bi-people"></i></div>
                <h5>Patients</h5>
                <p class="small text-muted">Export all patient data</p>
                <a href="/admin/export/patients" class="btn btn-primary btn-sm">
                    <i class="bi bi-download"></i> Download CSV
                </a>
            </div>
        </div>

        <!-- Appointments -->
        <div class="col-6 col-md-3">
            <div class="export-card">
                <div class="count-badge">CSV</div>
                <div class="export-icon"><i class="bi bi-calendar-check"></i></div>
                <h5>Appointments</h5>
                <p class="small text-muted">Export all appointments</p>
                <a href="/admin/export/appointments" class="btn btn-primary btn-sm">
                    <i class="bi bi-download"></i> Download CSV
                </a>
            </div>
        </div>

        <!-- Orders -->
        <div class="col-6 col-md-3">
            <div class="export-card">
                <div class="count-badge">CSV</div>
                <div class="export-icon"><i class="bi bi-prescription"></i></div>
                <h5>Orders</h5>
                <p class="small text-muted">Export all orders</p>
                <a href="/admin/export/orders" class="btn btn-primary btn-sm">
                    <i class="bi bi-download"></i> Download CSV
                </a>
            </div>
        </div>

        <!-- Messages -->
        <div class="col-6 col-md-3">
            <div class="export-card">
                <div class="count-badge">CSV</div>
                <div class="export-icon"><i class="bi bi-envelope"></i></div>
                <h5>Messages</h5>
                <p class="small text-muted">Export all messages</p>
                <a href="/admin/export/messages" class="btn btn-primary btn-sm">
                    <i class="bi bi-download"></i> Download CSV
                </a>
            </div>
        </div>

    </div>

    <!-- Back Button -->
    <div class="back-wrapper">
        <a href="/admin/dashboard" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

</div>

<!-- ===== SCRIPTS ===== -->
<script>
    // Auto-dismiss flash messages
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.alert:not(.alert-info)').forEach(a => {
            setTimeout(() => {
                a.style.transition = 'opacity 0.5s ease';
                a.style.opacity = '0';
                setTimeout(() => a.style.display = 'none', 500);
            }, 5000);
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>