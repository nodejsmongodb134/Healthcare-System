<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 8px 0;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        }
        .navbar-brand {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .navbar-brand i {
            font-size: 1.2rem;
        }
        .navbar-text {
            font-size: 0.8rem;
        }
        .navbar .btn-outline-light {
            border-width: 1.5px;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        /* mobile nav adjustments */
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text {
                font-size: 0.7rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.75rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
            border: none;
            background: #fff;
            transition: box-shadow 0.2s ease;
        }
        .card:hover {
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
        }
        .card .p-3 {
            padding: 1.25rem !important;
        }
        .card .p-md-4 {
            padding: 1.75rem !important;
        }
        @media (max-width: 575.98px) {
            .card .p-3 {
                padding: 1rem !important;
            }
            .card .p-md-4 {
                padding: 1rem !important;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card .p-3 {
                padding: 1.5rem !important;
            }
            .card .p-md-4 {
                padding: 1.75rem !important;
            }
        }

        /* ===== TITLE & BADGE ===== */
        .card h4.h5 {
            font-size: 1.05rem;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h4.h5 i {
            color: #667eea;
            font-size: 1.2rem;
        }
        .badge.bg-secondary {
            background: #6c757d !important;
            font-weight: 500;
            font-size: 0.75rem;
            padding: 0.3rem 0.7rem;
            border-radius: 20px;
        }
        .card hr {
            margin: 0.75rem 0 1rem 0;
            opacity: 0.5;
        }

        /* ===== FILTER FORM ===== */
        .filter-form .form-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 0.15rem;
        }
        .filter-form .form-control,
        .filter-form .form-select {
            border-radius: 8px;
            border: 1px solid #d1d5db;
            font-size: 0.82rem;
            padding: 0.3rem 0.6rem;
            height: auto;
            min-height: 32px;
        }
        .filter-form .form-control:focus,
        .filter-form .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .filter-form .btn-primary {
            background: #667eea;
            border-color: #667eea;
            border-radius: 30px;
            font-weight: 500;
            padding: 0.3rem 1rem;
            font-size: 0.8rem;
            min-height: 38px;
        }
        .filter-form .btn-primary:hover {
            background: #5a6fd6;
            border-color: #5a6fd6;
        }
        .filter-form .btn-primary i {
            font-size: 0.9rem;
        }
        /* filter form responsiveness */
        @media (max-width: 575.98px) {
            .filter-form .row.g-3 {
                --bs-gutter-y: 0.5rem;
            }
            .filter-form .form-label {
                font-size: 0.7rem;
            }
            .filter-form .form-control,
            .filter-form .form-select {
                font-size: 0.75rem;
                padding: 0.25rem 0.5rem;
                min-height: 34px;
            }
            .filter-form .btn-primary {
                font-size: 0.75rem;
                min-height: 40px;
                width: 100%;
            }
            .filter-form .col-md-2.d-flex.align-items-end {
                align-items: stretch !important;
                margin-top: 0.25rem;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .filter-form .row.g-3 {
                --bs-gutter-x: 0.75rem;
            }
        }

        /* ===== TABLE ===== */
        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            max-height: 600px;
            overflow-y: auto;
        }
        .table-responsive::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }
        .table {
            font-size: 0.82rem;
            margin-bottom: 0;
            min-width: 760px;
        }
        .table th {
            font-weight: 600;
            color: #4a5568;
            white-space: nowrap;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.6rem 0.6rem;
        }
        .table td {
            padding: 0.5rem 0.6rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }
        .table tbody tr:hover {
            background: #f7f9fc;
        }
        .table .badge-action {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.2px;
            display: inline-block;
        }
        /* action badges */
        .badge-create {
            background: #28a745;
            color: #fff;
        }
        .badge-update {
            background: #17a2b8;
            color: #fff;
        }
        .badge-delete {
            background: #dc3545;
            color: #fff;
        }
        .badge-assign {
            background: #fd7e14;
            color: #fff;
        }
        .badge-revoke {
            background: #6f42c1;
            color: #fff;
        }
        .badge-change_password {
            background: #ffc107;
            color: #856404;
        }
        .badge-toggle_status {
            background: #6610f2;
            color: #fff;
        }
        .badge-send_sms {
            background: #20c997;
            color: #fff;
        }
        .badge-login {
            background: #6c757d;
            color: #fff;
        }
        /* fallback */
        .badge-unknown {
            background: #e2e8f0;
            color: #2d3748;
        }
        /* table responsive overrides */
        @media (max-width: 575.98px) {
            .table {
                font-size: 0.7rem;
                min-width: 600px;
            }
            .table th,
            .table td {
                padding: 0.3rem 0.4rem;
            }
            .table .badge-action {
                font-size: 0.6rem;
                padding: 2px 8px;
            }
            .table td .btn-sm {
                font-size: 0.6rem;
                padding: 2px 6px;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .table {
                font-size: 0.75rem;
                min-width: 660px;
            }
            .table th,
            .table td {
                padding: 0.4rem 0.5rem;
            }
        }

        /* ===== PAGINATION ===== */
        .pagination {
            flex-wrap: wrap;
            gap: 2px;
            margin-top: 0.75rem;
        }
        .pagination .page-link {
            border-radius: 30px;
            padding: 0.25rem 0.7rem;
            font-size: 0.8rem;
            border: 1px solid #d1d5db;
            color: #2d3748;
            background: #fff;
            min-width: 36px;
            text-align: center;
            transition: all 0.15s ease;
        }
        .pagination .page-link:hover {
            background: #f0f2f5;
            border-color: #b8c0cc;
        }
        .pagination .page-item.active .page-link {
            background: #667eea;
            border-color: #667eea;
            color: #fff;
        }
        .pagination .page-item.disabled .page-link {
            opacity: 0.5;
            pointer-events: none;
        }
        @media (max-width: 575.98px) {
            .pagination {
                gap: 3px;
            }
            .pagination .page-link {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
                min-width: 32px;
            }
        }

        /* ===== BACK BUTTON ===== */
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 500;
            padding: 0.35rem 1.2rem;
            font-size: 0.8rem;
            border-radius: 30px;
            transition: all 0.2s ease;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                width: 100%;
                justify-content: center;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 0.4rem 1rem;
                font-size: 0.75rem;
            }
        }

        /* ===== MODAL ===== */
        .modal-content {
            border-radius: 16px;
            border: none;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
        }
        .modal-header {
            border-bottom: 1px solid #edf2f7;
            padding: 1rem 1.25rem;
        }
        .modal-header .modal-title {
            font-weight: 600;
            font-size: 1rem;
        }
        .modal-body {
            padding: 1.25rem;
        }
        .modal-body pre {
            background: #f8fafc;
            border-radius: 10px;
            padding: 1rem;
            font-size: 0.82rem;
            white-space: pre-wrap;
            word-wrap: break-word;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #e2e8f0;
        }
        .modal-footer {
            border-top: 1px solid #edf2f7;
            padding: 0.75rem 1.25rem;
        }
        .modal-footer .btn-secondary {
            padding: 0.3rem 1.2rem;
            font-size: 0.8rem;
        }
        @media (max-width: 575.98px) {
            .modal-dialog {
                margin: 0.5rem;
            }
            .modal-body pre {
                font-size: 0.7rem;
                padding: 0.75rem;
            }
        }

        /* ===== FLASH MESSAGES ===== */
        .alert {
            border-radius: 12px;
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
        }
        .alert i {
            margin-right: 6px;
        }
        @media (max-width: 575.98px) {
            .alert {
                font-size: 0.75rem;
                padding: 0.5rem 0.75rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .page-link,
        .filter-form .btn-primary {
            touch-action: manipulation;
        }
        @media (max-width: 575.98px) {
            .btn-secondary,
            .filter-form .btn-primary {
                min-height: 44px;
            }
            .navbar .btn-outline-light {
                min-height: 32px;
                min-width: 44px;
            }
            .page-link {
                min-width: 36px;
                min-height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
        }

        /* ===== UTILITY ===== */
        .text-muted small {
            font-size: 0.7rem;
        }
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                            <span class="badge bg-light text-dark ms-1 badge-role"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">

    <div class="card p-3 p-md-4">

        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h4 class="h5"><i class="bi bi-clock-history"></i> Audit Log</h4>
            <span class="badge bg-secondary"><%= totalCount %> records</span>
        </div>
        <hr />

        <!--------- Flash Messages -------------->

        <%- include('../partials/flash') %>


        <!-- Filters -->
        <form method="GET" action="/admin/audit" class="filter-form row g-2 g-sm-3 mb-3">
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label">User</label>
                <select name="userId" class="form-select form-select-sm">
                    <option value="">All</option>
                    <% users.forEach(u => { %>
                        <option value="<%= u %>" <%= filters.userId === u ? 'selected' : '' %>><%= u %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label">Action</label>
                <select name="action" class="form-select form-select-sm">
                    <option value="">All</option>
                    <% actions.forEach(a => { %>
                        <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label">Entity</label>
                <select name="entityType" class="form-select form-select-sm">
                    <option value="">All</option>
                    <% entityTypes.forEach(e => { %>
                        <option value="<%= e %>" <%= filters.entityType === e ? 'selected' : '' %>><%= e %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label">From</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="<%= filters.startDate || '' %>" />
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <label class="form-label">To</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="<%= filters.endDate || '' %>" />
            </div>
            <div class="col-12 col-sm-4 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-funnel"></i> Filter</button>
            </div>
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Entity</th>
                        <th>Details</th>
                        <th>IP</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (logs.length === 0) { %>
                        <tr><td colspan="6" class="text-center text-muted py-3">No audit records found</td></tr>
                    <% } %>
                    <% logs.forEach(log => { %>
                        <tr>
                            <td><%= new Date(log.timestamp).toLocaleString() %></td>
                            <td><%= log.username %></td>
                            <td><span class="badge-action badge-<%= log.action %>"><%= log.action %></span></td>
                            <td>
                                <%= log.entityType %>
                                <% if (log.entityId) { %><br /><small class="text-muted"><%= log.entityId %></small><% } %>
                            </td>
                            <td>
                                <% if (log.details && Object.keys(log.details).length > 0) { %>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="showDetails('<%= JSON.stringify(log.details).replace(/"/g, '&quot;') %>')">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                <% } else { %>
                                    <span class="text-muted">—</span>
                                <% } %>
                            </td>
                            <td><%= log.ipAddress || 'N/A' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <nav>
                <ul class="pagination pagination-sm justify-content-center">
                    <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="?<%= new URLSearchParams({...filters, page: currentPage - 1}) %>">Previous</a>
                    </li>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="?<%= new URLSearchParams({...filters, page: i}) %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                        <a class="page-link" href="?<%= new URLSearchParams({...filters, page: currentPage + 1}) %>">Next</a>
                    </li>
                </ul>
            </nav>
        <% } %>

        <!-- Back button -->
        <div class="mt-3">
            <a href="/admin/dashboard" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
        </div>

    </div>
    <!-- /.card -->

</div>
<!-- /.container -->

<!-- ===== DETAILS MODAL ===== -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-file-text"></i> Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="detailsContent" style="white-space: pre-wrap; word-wrap: break-word; background: #f8f9fa; padding: 15px; border-radius: 8px; margin:0;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script>
    function showDetails(detailsJson) {
        try {
            const obj = JSON.parse(detailsJson);
            document.getElementById('detailsContent').textContent = JSON.stringify(obj, null, 2);
        } catch (e) {
            document.getElementById('detailsContent').textContent = detailsJson;
        }
        const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
        modal.show();
    }
</script>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>