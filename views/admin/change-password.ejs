<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 8px 0;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        }
        .navbar-brand {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .navbar-brand i {
            font-size: 1.2rem;
        }
        .navbar-text {
            font-size: 0.8rem;
        }
        .navbar .btn-outline-light {
            border-width: 1.5px;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        /* mobile nav adjustments */
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text {
                font-size: 0.7rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.75rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
            border: none;
            background: #fff;
            transition: box-shadow 0.2s ease;
        }
        .card:hover {
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
        }
        .card h4 {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h4 i {
            color: #667eea;
            font-size: 1.2rem;
        }
        .card hr {
            margin: 0.75rem 0 1rem 0;
            opacity: 0.5;
        }

        /* card padding responsive */
        .card.p-4 {
            padding: 1.75rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-4 {
                padding: 1.25rem !important;
            }
            .card h4 {
                font-size: 0.95rem;
            }
            .card h4 i {
                font-size: 1rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-4 {
                padding: 2rem !important;
            }
        }

        /* ===== FORM ===== */
        .form-label {
            font-weight: 600;
            color: #4a5568;
            font-size: 0.85rem;
            margin-bottom: 0.2rem;
        }
        .form-label i {
            margin-right: 4px;
            color: #667eea;
        }
        .form-control {
            border-radius: 8px;
            border: 1px solid #d1d5db;
            font-size: 0.9rem;
            padding: 0.4rem 0.75rem;
            height: auto;
            min-height: 40px;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        .input-group .btn-outline-secondary {
            border-color: #d1d5db;
            border-left: none;
            border-radius: 0 8px 8px 0;
            padding: 0 0.6rem;
            min-height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .input-group .btn-outline-secondary:hover {
            background: #f0f2f5;
        }
        .input-group .btn-outline-secondary i {
            font-size: 1rem;
        }
        @media (max-width: 575.98px) {
            .form-control {
                font-size: 0.8rem;
                padding: 0.35rem 0.6rem;
                min-height: 38px;
            }
            .input-group .btn-outline-secondary {
                min-height: 38px;
                padding: 0 0.5rem;
            }
            .input-group .btn-outline-secondary i {
                font-size: 0.9rem;
            }
            .form-label {
                font-size: 0.8rem;
            }
        }

        /* ===== PASSWORD STRENGTH ===== */
        .password-strength {
            height: 6px;
            margin-top: 6px;
            border-radius: 6px;
            transition: width 0.3s ease, background-color 0.3s ease;
            background-color: #e2e8f0;
            width: 0%;
        }

        /* ===== REQUIREMENTS LIST ===== */
        .password-requirements {
            font-size: 0.8rem;
            color: #4a5568;
        }
        .password-requirements ul {
            padding-left: 0;
            margin-top: 0.25rem;
        }
        .password-requirements ul li {
            list-style: none;
            padding: 2px 0;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .password-requirements ul li i {
            font-size: 0.85rem;
            min-width: 16px;
        }
        .password-requirements .valid {
            color: #28a745;
        }
        .password-requirements .invalid {
            color: #dc3545;
        }
        @media (max-width: 575.98px) {
            .password-requirements {
                font-size: 0.7rem;
            }
            .password-requirements ul li {
                font-size: 0.7rem;
                padding: 1px 0;
            }
            .password-requirements ul li i {
                font-size: 0.75rem;
                min-width: 14px;
            }
            .password-strength {
                height: 5px;
            }
        }

        /* ===== BUTTONS ===== */
        .btn-primary {
            background: #667eea;
            border-color: #667eea;
            border-radius: 30px;
            font-weight: 500;
            padding: 0.4rem 1.4rem;
            font-size: 0.85rem;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-primary:hover {
            background: #5a6fd6;
            border-color: #5a6fd6;
            transform: translateY(-1px);
            box-shadow: 0 2px 12px rgba(102, 126, 234, 0.35);
        }
        .btn-primary i {
            font-size: 0.9rem;
        }
        .btn-outline-secondary {
            border-radius: 30px;
            padding: 0.4rem 1.2rem;
            font-size: 0.85rem;
            border-color: #d1d5db;
            color: #4a5568;
            font-weight: 500;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .btn-outline-secondary:hover {
            background: #f0f2f5;
            border-color: #b8c0cc;
        }
        .btn-outline-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-primary,
            .btn-outline-secondary {
                width: 100%;
                justify-content: center;
                min-height: 44px;
                font-size: 0.8rem;
                padding: 0.3rem 1rem;
            }
            .d-flex.flex-wrap.gap-2 {
                flex-direction: column;
                gap: 0.5rem !important;
            }
            .d-flex.flex-wrap.gap-2 .btn {
                width: 100%;
            }
        }

        /* ===== ALERT ===== */
        .alert {
            border-radius: 12px;
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
            animation: slideDown 0.4s ease-out;
        }
        .alert i {
            margin-right: 6px;
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (max-width: 575.98px) {
            .alert {
                font-size: 0.75rem;
                padding: 0.5rem 0.75rem;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .input-group .btn-outline-secondary {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== MISC ===== */
        .text-muted small {
            font-size: 0.75rem;
        }
        .gap-2 {
            gap: 0.5rem !important;
        }
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card p-4">

                <h4><i class="bi bi-key"></i> Change Password</h4>
                <hr />

                <!--------- Flash Messages -------------->

                <%- include('../partials/flash') %>


                <form action="/admin/change-password" method="POST" id="changePasswordForm">

                    <!-- Current Password -->
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label"><i class="bi bi-lock"></i> Current Password *</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('currentPassword', 'toggleCurrent')" aria-label="Toggle current password visibility">
                                <i class="bi bi-eye" id="toggleCurrent"></i>
                            </button>
                        </div>
                    </div>

                    <!-- New Password -->
                    <div class="mb-3">
                        <label for="newPassword" class="form-label"><i class="bi bi-lock-fill"></i> New Password *</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" onkeyup="validateNewPassword(this.value)" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('newPassword', 'toggleNew')" aria-label="Toggle new password visibility">
                                <i class="bi bi-eye" id="toggleNew"></i>
                            </button>
                        </div>
                        <div class="password-strength" id="passwordStrength"></div>

                        <div class="password-requirements mt-2">
                            <small>Password must contain:</small>
                            <ul>
                                <li id="reqLength" class="invalid"><i class="bi bi-x-circle"></i> At least 6 characters</li>
                                <li id="reqLowercase" class="invalid"><i class="bi bi-x-circle"></i> At least one lowercase letter</li>
                                <li id="reqUppercase" class="invalid"><i class="bi bi-x-circle"></i> At least one uppercase letter</li>
                                <li id="reqNumber" class="invalid"><i class="bi bi-x-circle"></i> At least one number</li>
                                <li id="reqSpecial" class="invalid"><i class="bi bi-x-circle"></i> At least one special character (!@#$%^&amp;*)</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label"><i class="bi bi-check-circle"></i> Confirm New Password *</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required onkeyup="checkPasswordMatch()" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', 'toggleConfirm')" aria-label="Toggle confirm password visibility">
                                <i class="bi bi-eye" id="toggleConfirm"></i>
                            </button>
                        </div>
                        <small id="passwordMatch" class="text-muted"></small>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                        <a href="/admin/dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                        <button type="submit" class="btn btn-primary" id="submitBtn"><i class="bi bi-save"></i> Update Password</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script>
    // Toggle password visibility
    function togglePassword(inputId, toggleId) {
        const input = document.getElementById(inputId);
        const toggle = document.getElementById(toggleId);
        if (input.type === 'password') {
            input.type = 'text';
            toggle.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            toggle.className = 'bi bi-eye';
        }
    }

    // Validate new password
    function validateNewPassword(password) {
        const hasLength = password.length >= 6;
        const hasLowercase = /[a-z]/.test(password);
        const hasUppercase = /[A-Z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSpecial = /[!@#$%^&*]/.test(password);

        updateRequirement('reqLength', hasLength);
        updateRequirement('reqLowercase', hasLowercase);
        updateRequirement('reqUppercase', hasUppercase);
        updateRequirement('reqNumber', hasNumber);
        updateRequirement('reqSpecial', hasSpecial);

        updatePasswordStrength(password);
        checkPasswordMatch();
    }

    function updateRequirement(id, isValid) {
        const el = document.getElementById(id);
        const text = el.textContent.replace(/[✓✗]/g, '').trim();
        if (isValid) {
            el.className = 'valid';
            el.innerHTML = '<i class="bi bi-check-circle"></i> ' + text;
        } else {
            el.className = 'invalid';
            el.innerHTML = '<i class="bi bi-x-circle"></i> ' + text;
        }
    }

    function updatePasswordStrength(password) {
        const bar = document.getElementById('passwordStrength');
        let strength = 0;
        if (password.length >= 6) strength++;
        if (/[a-z]/.test(password)) strength++;
        if (/[A-Z]/.test(password)) strength++;
        if (/[0-9]/.test(password)) strength++;
        if (/[!@#$%^&*]/.test(password)) strength++;

        if (password.length === 0) {
            bar.style.backgroundColor = '';
            bar.style.width = '0%';
        } else if (strength <= 2) {
            bar.style.backgroundColor = '#dc3545';
            bar.style.width = '20%';
        } else if (strength === 3) {
            bar.style.backgroundColor = '#ffc107';
            bar.style.width = '50%';
        } else if (strength === 4) {
            bar.style.backgroundColor = '#17a2b8';
            bar.style.width = '75%';
        } else {
            bar.style.backgroundColor = '#28a745';
            bar.style.width = '100%';
        }
    }

    function checkPasswordMatch() {
        const newPwd = document.getElementById('newPassword').value;
        const confirmPwd = document.getElementById('confirmPassword').value;
        const match = document.getElementById('passwordMatch');
        if (confirmPwd.length === 0) {
            match.textContent = '';
            match.className = 'text-muted';
            return;
        }
        if (newPwd === confirmPwd) {
            match.textContent = '✓ Passwords match!';
            match.className = 'text-success';
        } else {
            match.textContent = '✗ Passwords do not match';
            match.className = 'text-danger';
        }
    }

    // Form validation
    document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
        const current = document.getElementById('currentPassword').value;
        const newPwd = document.getElementById('newPassword').value;
        const confirm = document.getElementById('confirmPassword').value;

        if (!current || !newPwd || !confirm) {
            e.preventDefault();
            alert('Please fill in all fields');
            return false;
        }
        if (newPwd !== confirm) {
            e.preventDefault();
            alert('Passwords do not match');
            return false;
        }
        // Check strength
        const hasLowercase = /[a-z]/.test(newPwd);
        const hasUppercase = /[A-Z]/.test(newPwd);
        const hasNumber = /[0-9]/.test(newPwd);
        const hasSpecial = /[!@#$%^&*]/.test(newPwd);
        if (!hasLowercase || !hasUppercase || !hasNumber || !hasSpecial) {
            e.preventDefault();
            alert('Password must contain at least one lowercase, uppercase, number, and special character');
            return false;
        }
        return true;
    });

    // Auto-dismiss flash messages
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.alert').forEach(a => {
            setTimeout(() => {
                a.style.transition = 'opacity 0.5s ease';
                a.style.opacity = '0';
                setTimeout(() => a.style.display = 'none', 500);
            }, 5000);
        });
    });
</script>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>