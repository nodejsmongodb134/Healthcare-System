<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f4f7fc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
        }
        .navbar-brand i {
            font-size: 1.3rem;
            margin-right: 6px;
        }
        .navbar-text {
            font-weight: 500;
            font-size: 0.85rem;
        }
        .navbar-text .badge {
            font-weight: 600;
            padding: 0.3rem 0.65rem;
        }
        .navbar .btn-outline-light {
            border-width: 2px;
            font-weight: 600;
            padding: 0.25rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 1rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            background: #ffffff;
            transition: box-shadow 0.3s ease;
        }
        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }
        .card h5 {
            font-weight: 700;
            color: #1a202c;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
        }
        .card h5 i {
            color: #667eea;
            font-size: 1.2rem;
        }
        .card hr {
            opacity: 0.2;
            margin: 0.75rem 0 1rem 0;
        }

        /* card padding responsive */
        .card.p-3 {
            padding: 1.25rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-3 {
                padding: 1rem !important;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-3 {
                padding: 1.5rem !important;
            }
        }

        /* ===== PROFILE INFO ROWS ===== */
        .info-row {
            display: flex;
            padding: 8px 0;
            border-bottom: 1px solid #edf2f7;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .info-row:last-of-type {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #4a5568;
            min-width: 110px;
            flex-shrink: 0;
            font-size: 0.82rem;
        }
        .info-value {
            flex: 1;
            color: #1a202c;
            word-break: break-word;
            font-size: 0.82rem;
        }
        /* responsive info rows */
        @media (max-width: 575.98px) {
            .info-row {
                flex-direction: column;
                padding: 6px 0;
                gap: 2px;
            }
            .info-label {
                min-width: auto;
                width: 100%;
                font-size: 0.75rem;
                color: #718096;
                font-weight: 600;
            }
            .info-value {
                width: 100%;
                font-size: 0.8rem;
                padding-bottom: 2px;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .info-label {
                min-width: 80px;
                font-size: 0.78rem;
            }
            .info-value {
                font-size: 0.8rem;
            }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.2px;
            line-height: 1.5;
        }
        .status-active {
            background: #28a745;
            color: #fff;
        }
        .status-inactive {
            background: #dc3545;
            color: #fff;
        }
        .status-pending {
            background: #ffc107;
            color: #856404;
        }
        .status-confirmed {
            background: #28a745;
            color: #fff;
        }
        .status-cancelled {
            background: #dc3545;
            color: #fff;
        }
        .status-completed {
            background: #17a2b8;
            color: #fff;
        }
        .status-unread {
            background: #dc3545;
            color: #fff;
        }
        .status-read {
            background: #17a2b8;
            color: #fff;
        }
        .status-replied {
            background: #28a745;
            color: #fff;
        }
        .status-on-leave {
            background: #ffc107;
            color: #856404;
        }
        @media (max-width: 575.98px) {
            .status-badge {
                font-size: 0.65rem;
                padding: 3px 10px;
            }
        }

        /* ===== TABS ===== */
        .nav-tabs .nav-link {
            border-radius: 30px 30px 0 0;
            font-weight: 600;
            color: #4a5568;
            padding: 0.5rem 1rem;
            font-size: 0.85rem;
            border: 1px solid transparent;
            transition: all 0.15s ease;
            touch-action: manipulation;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .nav-tabs .nav-link:hover {
            border-color: #e2e8f0 #e2e8f0 #dee2e6;
            background: #f8fafc;
        }
        .nav-tabs .nav-link.active {
            color: #667eea;
            background: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
            box-shadow: 0 -2px 8px rgba(0,0,0,0.02);
        }
        .nav-tabs .nav-link i {
            margin-right: 4px;
        }
        .tab-pane {
            padding: 1rem 0 0 0;
        }
        @media (max-width: 575.98px) {
            .nav-tabs {
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                gap: 2px;
                padding-bottom: 2px;
            }
            .nav-tabs .nav-link {
                font-size: 0.75rem;
                padding: 0.35rem 0.7rem;
                min-height: 34px;
                white-space: nowrap;
            }
            .tab-pane {
                padding: 0.75rem 0 0 0;
            }
        }

        /* ===== TABLES ===== */
        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table {
            font-size: 0.82rem;
            margin-bottom: 0;
            min-width: 480px;
        }
        .table th {
            font-weight: 700;
            color: #4a5568;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.6rem 0.6rem;
            white-space: nowrap;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .table td {
            padding: 0.5rem 0.6rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }
        .table tbody tr:hover {
            background: #f7f9fc;
        }
        @media (max-width: 575.98px) {
            .table {
                font-size: 0.7rem;
                min-width: 380px;
            }
            .table th,
            .table td {
                padding: 0.3rem 0.4rem;
            }
            .table th {
                font-size: 0.65rem;
            }
        }

        /* ===== MESSAGE THREAD ===== */
        .message-thread {
            padding: 0.25rem 0;
        }
        .message-item {
            margin-bottom: 1.5rem;
        }
        .message-item .patient-msg {
            background-color: #f8fafc;
            border-left: 4px solid #667eea;
        }
        .message-item .nurse-reply {
            background-color: #e8f5e9;
            border-left: 4px solid #28a745;
        }
        .message-item .card-body {
            padding: 12px 16px;
        }
        .message-item .card-text {
            white-space: pre-wrap;
            word-wrap: break-word;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }
        .message-item .card-body h6 {
            font-weight: 600;
            font-size: 0.9rem;
        }
        .message-item .card-body .d-flex {
            align-items: center;
            flex-wrap: wrap;
            gap: 4px;
        }
        .message-item .card-body .d-flex strong {
            font-size: 0.85rem;
        }
        .message-item .card-body .d-flex small {
            font-size: 0.7rem;
        }
        .message-item .nurse-reply {
            margin-left: 2rem;
        }
        /* responsive message indentation */
        @media (max-width: 575.98px) {
            .message-item .nurse-reply {
                margin-left: 0.5rem;
            }
            .message-item .card-body {
                padding: 10px 12px;
            }
            .message-item .card-text {
                font-size: 0.8rem;
            }
            .message-item .card-body h6 {
                font-size: 0.85rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .message-item .nurse-reply {
                margin-left: 1.5rem;
            }
        }

        /* ===== BUTTONS ===== */
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 600;
            padding: 0.4rem 1.4rem;
            font-size: 0.82rem;
            border-radius: 40px;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                width: 100%;
                justify-content: center;
                min-height: 44px;
                font-size: 0.78rem;
                padding: 0.35rem 1rem;
            }
            .mt-3 .btn-secondary {
                width: 100%;
            }
        }

        /* ===== CONTAINER & GRID ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        .row.g-4 {
            --bs-gutter-y: 1.25rem;
            --bs-gutter-x: 1.25rem;
        }
        @media (max-width: 575.98px) {
            .row.g-4 {
                --bs-gutter-y: 1rem;
                --bs-gutter-x: 0.75rem;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .nav-link {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== UTILITIES ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
        .text-muted {
            color: #a0aec0 !important;
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="row g-4">

        <!-- Profile Column -->
        <div class="col-12 col-md-4">
            <div class="card p-3">
                <h5><i class="bi bi-person-badge"></i> Nurse Profile</h5>
                <hr />

                <div class="info-row">
                    <span class="info-label">Name</span>
                    <span class="info-value"><%= nurse.name %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value"><%= nurse.email %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Joined</span>
                    <span class="info-value"><%= new Date(nurse.createdAt).toLocaleDateString() %></span>
                </div>

                <% if (profile) { %>
                    <div class="info-row">
                        <span class="info-label">Phone</span>
                        <span class="info-value"><%= profile.phone || 'N/A' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">ID Number</span>
                        <span class="info-value"><%= profile.idNumber || 'N/A' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Qualification</span>
                        <span class="info-value"><%= profile.qualification || 'N/A' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Specialization</span>
                        <span class="info-value"><%= profile.specialization || 'N/A' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Experience</span>
                        <span class="info-value"><%= profile.yearsOfExperience || 0 %> years</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">License</span>
                        <span class="info-value"><%= profile.licenseNumber || 'N/A' %></span>
                    </div>
                <% } else { %>
                    <p class="text-muted mt-2">Profile not completed</p>
                <% } %>
            </div>
        </div>

        <!-- Details Column with Tabs -->
        <div class="col-12 col-md-8">
            <div class="card p-3">
                <!-- Tabs -->
                <ul class="nav nav-tabs" id="nurseTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="appointments-tab" data-bs-toggle="tab" href="#appointments" role="tab">
                            <i class="bi bi-calendar-check"></i> Appointments (<%= appointments.length %>)
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="messages-tab" data-bs-toggle="tab" href="#messages" role="tab">
                            <i class="bi bi-envelope"></i> Messages Replied (<%= messages.length %>)
                        </a>
                    </li>
                    <% if (drivers && drivers.length > 0) { %>
                        <li class="nav-item">
                            <a class="nav-link" id="drivers-tab" data-bs-toggle="tab" href="#drivers" role="tab">
                                <i class="bi bi-truck"></i> Drivers Created (<%= drivers.length %>)
                            </a>
                        </li>
                    <% } %>
                </ul>

                <div class="tab-content">
                    <!-- Appointments Tab -->
                    <div class="tab-pane fade show active" id="appointments" role="tabpanel">
                        <% if (appointments.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr><th>Patient</th><th>Date</th><th>Time</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        <% appointments.forEach(a => { %>
                                        <tr>
                                            <td><%= a.patientName %></td>
                                            <td><%= new Date(a.date).toLocaleDateString() %></td>
                                            <td><%= a.time %></td>
                                            <td><span class="status-badge status-<%= a.status %>"><%= a.status %></span></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-muted py-2">No appointments assigned.</p>
                        <% } %>
                    </div>

                    <!-- Messages Tab - Chat Thread -->
                    <div class="tab-pane fade" id="messages" role="tabpanel">
                        <% if (messages.length > 0) { %>
                            <div class="message-thread">
                                <% messages.forEach(msg => { %>
                                    <div class="message-item">
                                        <!-- Patient Message -->
                                        <div class="card patient-msg mb-2">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between flex-wrap">
                                                    <strong><i class="bi bi-person"></i> <%= msg.patientName %></strong>
                                                    <small class="text-muted"><%= new Date(msg.createdAt).toLocaleString() %></small>
                                                </div>
                                                <h6 class="mt-1"><%= msg.subject %></h6>
                                                <p class="card-text"><%= msg.message %></p>
                                                <span class="status-badge status-<%= msg.status %>"><%= msg.status %></span>
                                            </div>
                                        </div>
                                        <!-- Nurse Reply -->
                                        <% if (msg.nurseReply) { %>
                                            <div class="card nurse-reply mb-2">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between flex-wrap">
                                                        <strong><i class="bi bi-person-badge"></i> <%= msg.nurseName || 'Nurse' %></strong>
                                                        <small class="text-muted"><%= msg.replyDate ? new Date(msg.replyDate).toLocaleString() : 'Replied' %></small>
                                                    </div>
                                                    <p class="card-text"><%= msg.nurseReply %></p>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <div class="text-muted ms-4 small">No reply yet</div>
                                        <% } %>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted py-2">No replied messages.</p>
                        <% } %>
                    </div>

                    <!-- Drivers Tab -->
                    <% if (drivers && drivers.length > 0) { %>
                        <div class="tab-pane fade" id="drivers" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th></tr>
                                    </thead>
                                    <tbody>
                                        <% drivers.forEach(d => { %>
                                        <tr>
                                            <td><%= d.name %></td>
                                            <td><%= d.email %></td>
                                            <td><%= d.phone %></td>
                                            <td><span class="status-badge status-<%= d.status %>"><%= d.status %></span></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a href="/admin/nurses" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Nurses
        </a>
    </div>
</div>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>