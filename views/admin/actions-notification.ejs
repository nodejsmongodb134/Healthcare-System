<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    /* ========== GLOBAL ========== */
    body {
      background: #f0f2f5;
      font-size: 14px;
      line-height: 1.6;
    }
    .navbar {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 10px 0;
    }
    .navbar-brand {
      font-size: 1.1rem;
      font-weight: 600;
    }
    .navbar-text {
      font-size: 0.85rem;
    }
    .btn-outline-light {
      border-color: rgba(255,255,255,0.5);
      color: white;
    }
    .btn-outline-light:hover {
      background: rgba(255,255,255,0.2);
      border-color: white;
    }
    .card {
      border-radius: 15px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.08);
      border: none;
      transition: transform 0.2s;
    }
    .card:hover {
      transform: translateY(-2px);
    }
    .btn-primary {
      background: #667eea;
      border: none;
    }
    .btn-primary:hover {
      background: #5a67d8;
    }
    .btn-success {
      background: #28a745;
      border: none;
    }
    .btn-success:hover {
      background: #218838;
    }
    .btn-warning {
      background: #ffc107;
      border: none;
      color: #856404;
    }
    .btn-warning:hover {
      background: #e0a800;
      color: #856404;
    }
    .btn-outline-secondary {
      color: #667eea;
      border-color: #667eea;
    }
    .btn-outline-secondary:hover {
      background: #667eea;
      color: white;
    }
    .alert {
      animation: slideDown 0.5s ease-out;
    }
    @keyframes slideDown {
      from { opacity:0; transform:translateY(-20px); }
      to { opacity:1; transform:translateY(0); }
    }
    .form-label {
      font-weight: 600;
      color: #555;
    }
    .form-control:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25);
    }

    /* ========== STAT BOX ========== */
    .stat-box {
      text-align: center;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 10px;
    }
    .stat-number {
      font-size: 2rem;
      font-weight: bold;
      color: #667eea;
      line-height: 1.2;
    }

    /* ========== SMS CARD ========== */
    .sms-card {
      border-left: 4px solid #28a745;
    }

    /* ========== RESPONSIVE TWEAKS ========== */
    @media (max-width: 575.98px) {
      body { font-size: 13px; }
      .container { padding-left: 12px; padding-right: 12px; }
      .navbar-brand { font-size: 0.95rem; }
      .navbar-text { font-size: 0.75rem; }
      .card { border-radius: 10px; }
      .card .p-4 { padding: 16px !important; }
      .card .p-3 { padding: 12px !important; }
      .btn { font-size: 0.75rem; padding: 6px 12px; }
      .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
      .form-label { font-size: 0.85rem; }
      .form-control { font-size: 0.9rem; padding: 8px 10px; }
      .stat-number { font-size: 1.6rem; }
      .stat-box { padding: 10px; }
      .alert-info h4 { font-size: 1rem; }
      .alert-info p { font-size: 0.85rem; margin-bottom: 0; }
      .d-grid .btn { width: 100%; margin-bottom: 6px; }
    }

    @media (min-width: 576px) and (max-width: 991.98px) {
      .container { padding-left: 20px; padding-right: 20px; }
      .card .p-4 { padding: 24px !important; }
      .btn { font-size: 0.8rem; padding: 6px 14px; }
      .form-control { font-size: 0.95rem; }
      .stat-number { font-size: 1.8rem; }
    }

    @media (min-width: 992px) {
      .container { padding-left: 40px; padding-right: 40px; }
      .card .p-4 { padding: 32px !important; }
      .btn { font-size: 0.85rem; padding: 8px 20px; }
      .stat-number { font-size: 2.2rem; }
    }
  </style>
</head>
<body>

  <!-- ========== NAVBAR with responsive toggler ========== -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <span class="navbar-text text-white me-3">
              <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
              <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
            </span>
          </li>
          <li class="nav-item">
            <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-2">
              <i class="bi bi-arrow-left"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="btn btn-outline-light btn-sm">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-4">
    <!-- Header -->
    <div class="alert alert-info shadow-sm">
      <h4 class="h5"><i class="bi bi-megaphone"></i> Actions & Notifications</h4>
      <p class="mb-0">Send SMS messages to patients, broadcast campaigns, or trigger appointment reminders.</p>
    </div>

    <!-- Stats -->
    <div class="row g-2 g-md-3 mb-4">
      <div class="col-6 col-md-4">
        <div class="card stat-box">
          <div class="stat-number"><%= totalPatients %></div>
          <small>Total Patients</small>
        </div>
      </div>
      <div class="col-6 col-md-4">
        <div class="card stat-box">
          <div class="stat-number"><%= upcomingAppointments %></div>
          <small>Upcoming Appointments</small>
        </div>
      </div>
      <div class="col-6 col-md-4">
        <div class="card stat-box">
          <div class="stat-number"><%= todaysAppointments %></div>
          <small>Today's Appointments</small>
        </div>
      </div>
    </div>


    <!--------- Flash Messages -------------->

    <%- include('../partials/flash') %>



    <!-- Broadcast to All -->
    <div class="card p-3 p-md-4 mb-4">
      <h5 class="h6"><i class="bi bi-send"></i> Broadcast SMS to All Patients</h5>
      <hr>
      <form action="/admin/notifications/broadcast" method="POST">
        <div class="mb-3">
          <label for="broadcastMessage" class="form-label">Message</label>
          <textarea class="form-control" id="broadcastMessage" name="message" rows="4" placeholder="Enter your broadcast message…" required></textarea>
          <small class="text-muted">Will be sent to all patients who have a phone number.</small>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Send Broadcast</button>
      </form>
    </div>

    <!-- Custom Group -->
    <div class="card p-3 p-md-4 mb-4">
      <h5 class="h6"><i class="bi bi-people"></i> Send to Selected Group</h5>
      <hr>
      <form action="/admin/notifications/custom" method="POST">
        <div class="mb-3">
          <label for="group" class="form-label">Target Group</label>
          <select class="form-control" id="group" name="group" required>
            <option value="all">All Patients</option>
            <option value="upcoming">Patients with Upcoming Appointments (next 7 days)</option>
            <option value="today">Patients with Appointments Today</option>
          </select>
        </div>
        <div class="mb-3">
          <label for="customMessage" class="form-label">Message</label>
          <textarea class="form-control" id="customMessage" name="message" rows="4" placeholder="Enter your custom message…" required></textarea>
        </div>
        <button type="submit" class="btn btn-success"><i class="bi bi-send"></i> Send to Group</button>
      </form>
    </div>

    <!-- Appointment Reminders -->
    <div class="card p-3 p-md-4 mb-4">
      <h5 class="h6"><i class="bi bi-calendar-check"></i> Manual Appointment Reminders</h5>
      <hr>
      <p class="text-muted">Trigger reminders for appointments scheduled <strong>tomorrow</strong>. This is the same as the automated cron job.</p>
      <form action="/admin/notifications/reminders" method="POST">
        <button type="submit" class="btn btn-warning"><i class="bi bi-clock"></i> Send Tomorrow's Reminders Now</button>
      </form>
    </div>

    <!-- Test SMS -->
    <div class="card p-3 p-md-4">
      <h5 class="h6"><i class="bi bi-robot"></i> SMS Connection Test</h5>
      <hr>
      <p class="text-muted">Verify that your SMS provider is configured correctly.</p>
      <a href="/admin/notifications/test-sms" class="btn btn-outline-secondary"><i class="bi bi-check-circle"></i> Test Connection</a>
    </div>
  </div>

  <script>
    // Auto-dismiss flash messages
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.alert').forEach(a => {
        setTimeout(() => {
          a.style.transition = 'opacity 0.5s ease';
          a.style.opacity = '0';
          setTimeout(() => a.style.display = 'none', 500);
        }, 8000);
      });
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>