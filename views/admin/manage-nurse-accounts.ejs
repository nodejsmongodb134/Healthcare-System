<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f4f7fc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
        }
        .navbar-brand i {
            font-size: 1.3rem;
            margin-right: 6px;
        }
        .navbar-text {
            font-weight: 500;
            font-size: 0.85rem;
        }
        .navbar-text .badge {
            font-weight: 600;
            padding: 0.3rem 0.65rem;
        }
        .navbar .btn-outline-light {
            border-width: 2px;
            font-weight: 600;
            padding: 0.25rem 0.8rem;
            font-size: 0.75rem;
            border-radius: 30px;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 1rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARD ===== */
        .card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
            background: #ffffff;
            transition: box-shadow 0.3s ease;
        }
        .card:hover {
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
        }
        .card h4 {
            font-weight: 700;
            color: #1a202c;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
        }
        .card h4 i {
            color: #667eea;
            font-size: 1.3rem;
        }
        .card hr {
            opacity: 0.2;
            margin: 0.75rem 0 1.25rem 0;
        }

        /* card padding responsive */
        .card.p-3.p-md-4 {
            padding: 1.25rem !important;
        }
        @media (max-width: 575.98px) {
            .card.p-3.p-md-4 {
                padding: 1rem !important;
            }
            .card h4 {
                font-size: 1rem;
            }
            .card h4 i {
                font-size: 1.1rem;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .card.p-3.p-md-4 {
                padding: 1.75rem !important;
            }
        }
        @media (min-width: 992px) {
            .card.p-3.p-md-4 {
                padding: 2rem !important;
            }
        }

        /* ===== TABLE ===== */
        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            max-height: 600px;
            overflow-y: auto;
        }
        .table-responsive::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }

        .table {
            font-size: 0.82rem;
            margin-bottom: 0;
            min-width: 700px;
        }
        .table th {
            font-weight: 700;
            color: #4a5568;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.65rem 0.6rem;
            white-space: nowrap;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }
        .table td {
            padding: 0.5rem 0.6rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }
        .table tbody tr:hover {
            background: #f7f9fc;
        }
        @media (max-width: 575.98px) {
            .table {
                font-size: 0.7rem;
                min-width: 550px;
            }
            .table th,
            .table td {
                padding: 0.3rem 0.4rem;
            }
            .table th {
                font-size: 0.65rem;
            }
            .table-responsive {
                max-height: 400px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .table {
                font-size: 0.78rem;
                min-width: 620px;
            }
            .table th,
            .table td {
                padding: 0.4rem 0.5rem;
            }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.2px;
            line-height: 1.6;
        }
        .status-active {
            background: #28a745;
            color: #fff;
        }
        .status-inactive {
            background: #dc3545;
            color: #fff;
        }
        .status-on-leave {
            background: #ffc107;
            color: #856404;
        }
        @media (max-width: 575.98px) {
            .status-badge {
                font-size: 0.6rem;
                padding: 2px 10px;
            }
        }

        /* ===== ACTION BUTTONS ===== */
        .action-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 3px;
        }
        .action-group .btn {
            border-radius: 30px;
            padding: 0.2rem 0.5rem;
            font-size: 0.7rem;
            min-height: 30px;
            min-width: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-width: 1.5px;
            transition: all 0.15s ease;
        }
        .action-group .btn i {
            font-size: 0.8rem;
        }
        .action-group .btn-outline-primary {
            color: #667eea;
            border-color: #d1d9f5;
        }
        .action-group .btn-outline-primary:hover {
            background: #667eea;
            color: #fff;
            border-color: #667eea;
        }
        .action-group .btn-outline-warning {
            color: #d69e2e;
            border-color: #f6e5c3;
        }
        .action-group .btn-outline-warning:hover {
            background: #d69e2e;
            color: #fff;
            border-color: #d69e2e;
        }
        .action-group .btn-outline-info {
            color: #17a2b8;
            border-color: #b8e4ed;
        }
        .action-group .btn-outline-info:hover {
            background: #17a2b8;
            color: #fff;
            border-color: #17a2b8;
        }
        .action-group .btn-outline-secondary {
            color: #718096;
            border-color: #e2e8f0;
        }
        .action-group .btn-outline-secondary:hover {
            background: #718096;
            color: #fff;
            border-color: #718096;
        }
        .action-group .btn-outline-danger {
            color: #e53e3e;
            border-color: #f5d0d0;
        }
        .action-group .btn-outline-danger:hover {
            background: #e53e3e;
            color: #fff;
            border-color: #e53e3e;
        }
        /* Tooltip text on hover - using title attribute already */

        @media (max-width: 575.98px) {
            .action-group .btn {
                padding: 0.15rem 0.35rem;
                font-size: 0.6rem;
                min-height: 26px;
                min-width: 26px;
            }
            .action-group .btn i {
                font-size: 0.7rem;
            }
            .action-group {
                gap: 2px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .action-group .btn {
                padding: 0.2rem 0.4rem;
                font-size: 0.65rem;
                min-height: 28px;
                min-width: 28px;
            }
            .action-group .btn i {
                font-size: 0.75rem;
            }
        }

        /* ===== BUTTONS GENERAL ===== */
        .btn {
            border-radius: 40px;
            font-weight: 600;
            padding: 0.5rem 1.5rem;
            font-size: 0.82rem;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-outline-secondary {
            border-color: #e2e8f0;
            color: #4a5568;
            background: #ffffff;
        }
        .btn-outline-secondary:hover {
            background: #f7fafc;
            border-color: #cbd5e0;
        }
        .btn-sm {
            padding: 0.3rem 0.8rem;
            font-size: 0.75rem;
            min-height: 32px;
        }
        @media (max-width: 575.98px) {
            .btn {
                font-size: 0.75rem;
                padding: 0.4rem 1rem;
                min-height: 38px;
                width: 100%;
            }
            .btn-sm {
                padding: 0.2rem 0.6rem;
                font-size: 0.65rem;
                min-height: 30px;
                width: auto;
            }
            .d-flex.flex-wrap .btn-sm {
                width: auto;
            }
        }

        /* ===== ALERT ===== */
        .alert {
            border-radius: 12px;
            font-size: 0.85rem;
            padding: 0.6rem 1rem;
            animation: slideDown 0.4s ease-out;
            border: none;
        }
        .alert-success {
            background: #c6f6d5;
            color: #22543d;
        }
        .alert-danger {
            background: #fed7d7;
            color: #9b2c2c;
        }
        .alert i {
            margin-right: 6px;
        }
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @media (max-width: 575.98px) {
            .alert {
                font-size: 0.75rem;
                padding: 0.5rem 0.75rem;
            }
        }

        /* ===== MODAL ===== */
        .modal-content {
            border-radius: 16px;
            border: none;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        }
        .modal-header {
            border-bottom: 1px solid #edf2f7;
            padding: 1rem 1.25rem;
        }
        .modal-header .modal-title {
            font-weight: 700;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .modal-header .modal-title i {
            color: #667eea;
        }
        .modal-body {
            padding: 1.25rem;
        }
        .modal-footer {
            border-top: 1px solid #edf2f7;
            padding: 0.75rem 1.25rem;
        }
        .modal-footer .btn {
            min-height: 38px;
        }
        @media (max-width: 575.98px) {
            .modal-dialog {
                margin: 0.5rem;
            }
            .modal-body {
                padding: 0.75rem;
            }
            .modal-footer {
                flex-direction: column;
                gap: 0.5rem;
            }
            .modal-footer .btn {
                width: 100%;
            }
        }

        /* ===== CONTAINER ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .dropdown-item,
        .form-control {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== UTILITIES ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
        .d-flex.flex-wrap .btn-sm {
            margin-bottom: 2px;
        }

        /* ===== HEADER BUTTONS ===== */
        .header-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }
        @media (max-width: 575.98px) {
            .header-actions .btn {
                width: auto;
            }
        }
    </style>
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="card p-3 p-md-4">

        <!-- Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h4 class="h5"><i class="bi bi-person-badge"></i> Nurse Accounts</h4>
            <div class="header-actions">
                <a href="/admin/nurses/create" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle"></i> Add Nurse</a>
                <a href="/admin/dashboard" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Dashboard</a>
            </div>
        </div>
        <hr />

        <!--------- Flash Messages -------------->

        <%- include('../partials/flash') %>


        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Qualification</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (nurses.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No nurses found</td>
                        </tr>
                    <% } %>
                    <% nurses.forEach((nurse, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td><%= nurse.name %></td>
                        <td><%= nurse.email %></td>
                        <td><%= nurse.profile?.phone || 'N/A' %></td>
                        <td><%= nurse.profile?.qualification || 'N/A' %></td>
                        <td>
                            <span class="status-badge <%= nurse.isActive ? 'status-active' : 'status-inactive' %>">
                                <%= nurse.isActive ? 'Active' : 'Inactive' %>
                            </span>
                        </td>
                        <td>
                            <div class="action-group justify-content-center">

                                <!-- View Full Profile -->
                                <a href="/admin/nurses/<%= nurse._id %>" class="btn btn-outline-primary" title="View Full Profile">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-sm-inline">View</span>
                                </a>

                                <!-- Edit -->
                                <a href="/admin/nurses/edit/<%= nurse._id %>" class="btn btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-sm-inline">Edit</span>
                                </a>

                                <!-- Toggle Status -->
                                <form action="/admin/nurses/toggle-status/<%= nurse._id %>" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-outline-info" title="Toggle Active/Inactive">
                                        <i class="bi bi-toggle-on"></i>
                                        <span class="d-none d-sm-inline">Toggle</span>
                                    </button>
                                </form>

                                <!-- Change Password -->
                                <button class="btn btn-outline-secondary" onclick="openPasswordModal('<%= nurse._id %>', '<%= nurse.name %>')" title="Change Password">
                                    <i class="bi bi-key"></i>
                                    <span class="d-none d-sm-inline">Password</span>
                                </button>

                                <!-- Revoke to Patient -->
                                <form action="/admin/nurses/<%= nurse._id %>/revoke" method="POST" style="display:inline;" onsubmit="return confirm('Revoke this nurse? They will become a patient.')">
                                    <button type="submit" class="btn btn-outline-danger" title="Revoke Nurse Access">
                                        <i class="bi bi-person-x"></i>
                                        <span class="d-none d-sm-inline">Revoke</span>
                                    </button>
                                </form>

                                <!-- Delete -->
                                <form action="/admin/users/<%= nurse._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this nurse permanently?')">
                                    <button type="submit" class="btn btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                        <span class="d-none d-sm-inline">Delete</span>
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- ===== CHANGE PASSWORD MODAL ===== -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-key"></i> Change Password for <span id="passwordNurseName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/nurses/change-password/" method="POST" id="passwordForm">
                <input type="hidden" name="nurseId" id="passwordNurseId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="text" class="form-control" id="newPassword" name="newPassword" required minlength="6" placeholder="Enter new password (min 6 chars)">
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script>
    function openPasswordModal(nurseId, nurseName) {
        document.getElementById('passwordNurseId').value = nurseId;
        document.getElementById('passwordNurseName').textContent = nurseName;
        document.getElementById('passwordForm').action = `/admin/nurses/change-password/${nurseId}`;
        const modal = new bootstrap.Modal(document.getElementById('passwordModal'));
        modal.show();
    }

    // Auto-dismiss flash messages
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.alert').forEach(a => {
            setTimeout(() => {
                a.style.transition = 'opacity 0.5s ease';
                a.style.opacity = '0';
                setTimeout(() => a.style.display = 'none', 500);
            }, 5000);
        });
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>