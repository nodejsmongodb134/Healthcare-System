<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: #f4f7fc;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        }
        .navbar-brand { font-size: 1.15rem; font-weight: 700; }
        .navbar-text { font-size: 0.85rem; }
        .navbar .btn-outline-light {
            border-width: 2px; font-weight: 600;
            padding: 0.25rem 0.8rem; font-size: 0.75rem; border-radius: 30px;
        }
        .card {
            border: none; border-radius: 18px;
            box-shadow: 0 4px 16px rgba(0,0,0,0.04);
            background: #fff;
        }
        .card:hover { box-shadow: 0 8px 30px rgba(0,0,0,0.06); }

        /* ========== STAT CARDS ========== */
        .stat-card {
            text-align: center;
            padding: 1.25rem 1rem;
        }
        .stat-number {
            font-size: 2.2rem;
            font-weight: 700;
            color: #667eea;
            line-height: 1.2;
        }
        @media (max-width: 575.98px) {
            .stat-number { font-size: 1.6rem; }
            .stat-card { padding: 0.9rem 0.5rem; }
        }

        /* ========== ANNOUNCEMENT CARD ========== */
        .announcement-card {
            background: #fff;
            border-radius: 14px;
            border-left: 5px solid #667eea;
            padding: 1rem 1.25rem;
            margin-bottom: 0.75rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            transition: all 0.2s;
            cursor: pointer;
        }
        .announcement-card:hover {
            transform: translateX(5px);
            box-shadow: 0 6px 20px rgba(102,126,234,0.15);
        }
        .announcement-subject {
            font-weight: 700;
            color: #1a202c;
            font-size: 1rem;
            margin-bottom: 0.25rem;
        }
        .announcement-preview {
            color: #6b7a8f;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .announcement-meta {
            font-size: 0.78rem;
            color: #a0aec0;
            margin-top: 0.5rem;
        }

        /* ========== STATUS BADGE ========== */
        .status-badge {
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 600;
            display: inline-block;
        }
        .badge-recipients {
            background: #e8edff;
            color: #667eea;
        }
        .badge-nurse {
            background: #e3f9e5;
            color: #28a745;
        }

        /* ========== FILTER BUTTONS ========== */
        .filter-btn {
            border-radius: 20px !important;
            padding: 0.3rem 1rem;
            font-size: 0.78rem;
            font-weight: 500;
            border: 1.5px solid #d0d5dd;
            background: #fff;
            color: #344054;
            transition: all 0.2s ease;
        }
        .filter-btn:hover {
            background: #f5f7fa;
            border-color: #b0b8c4;
        }
        .filter-btn.active {
            background: #667eea;
            color: #fff;
            border-color: #667eea;
        }

        /* ========== MODAL ========== */
        .modal-content { border-radius: 16px; border: none; }
        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 16px 16px 0 0;
        }
        .modal-header .btn-close { filter: brightness(0) invert(1); }
        .modal-body { padding: 1.25rem; }
        .message-content-box {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 1rem;
            border-radius: 8px;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-size: 0.9rem;
            max-height: 300px;
            overflow-y: auto;
        }
        .recipient-row {
            padding: 0.5rem 0.75rem;
            border-bottom: 1px solid #edf2f7;
            font-size: 0.85rem;
        }
        .recipient-row:hover { background: #f7f9fc; }
        .recipient-row:last-child { border-bottom: none; }

        /* ========== EMPTY STATE ========== */
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #a0aec0;
        }
        .empty-state i {
            font-size: 3.5rem;
            opacity: 0.5;
            display: block;
            margin-bottom: 0.5rem;
        }

        /* ========== ALERT ========== */
        .alert { border-radius: 12px; border: none; animation: slideDown 0.4s ease-out; }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-15px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 1rem; }
            .card { border-radius: 14px; }
            .announcement-card { padding: 0.75rem 1rem; }
            .announcement-subject { font-size: 0.92rem; }
            .announcement-preview { font-size: 0.78rem; }
            .btn { font-size: 0.75rem; padding: 5px 12px; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> <%= user.name %>
                            <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/admin/dashboard" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Header -->
        <div class="alert alert-info d-flex align-items-start gap-2">
            <i class="bi bi-megaphone fs-4"></i>
            <div>
                <h4 class="h5 mb-1">Announcements</h4>
                <p class="mb-0">View all broadcast announcements sent to patients by nurses.</p>
            </div>
        </div>

        <!-- Flash Messages -->
        <%- include('../partials/flash') %>

        <!-- Stats -->
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card stat-card">
                    <div class="stat-number"><%= stats.totalAnnouncements %></div>
                    <small class="text-muted">Announcements</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card stat-card">
                    <div class="stat-number"><%= stats.totalMessages %></div>
                    <small class="text-muted">Total Deliveries</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card stat-card">
                    <div class="stat-number"><%= stats.uniqueNurses %></div>
                    <small class="text-muted">Senders</small>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card p-3 mb-3">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div>
                    <strong><i class="bi bi-list-ul"></i> All Announcements</strong>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <div class="input-group" style="max-width: 260px;">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input
                            type="text"
                            id="searchInput"
                            class="form-control form-control-sm"
                            placeholder="Search subject or sender..."
                            oninput="filterAnnouncements()"
                        >
                    </div>
                    <select
                        id="senderFilter"
                        class="form-select form-select-sm"
                        style="max-width: 200px;"
                        onchange="filterAnnouncements()"
                    >
                        <option value="">All senders</option>
                        <% 
                          const senders = [...new Set(announcements.map(a => a.nurseName))];
                          senders.forEach(name => { %>
                            <option value="<%= name %>"><%= name %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>

        <!-- Announcements List -->
        <div id="announcementsList">
            <% if (announcements && announcements.length > 0) { %>
                <% announcements.forEach(function (a) { %>
                    <div
                        class="announcement-card"
                        data-subject="<%= a.subject.toLowerCase() %>"
                        data-nurse="<%= a.nurseName %>"
                        onclick="viewAnnouncement('<%= a._id %>')"
                    >
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="announcement-subject">
                                    <i class="bi bi-megaphone text-primary"></i> <%= a.subject %>
                                </div>
                                <div class="announcement-preview">
                                    <%= a.message.length > 100 ? a.message.substring(0, 100) + '…' : a.message %>
                                </div>
                                <div class="announcement-meta">
                                    <span class="badge-nurse status-badge me-2">
                                        <i class="bi bi-person-badge"></i> <%= a.nurseName || 'Nurse' %>
                                    </span>
                                    <span class="badge-recipients status-badge me-2">
                                        <i class="bi bi-people"></i> <%= a.recipientCount %> recipients
                                    </span>
                                    <span class="text-muted">
                                        <i class="bi bi-clock"></i>
                                        <%= new Date(a.sentAt).toLocaleString() %>
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button
                                    class="btn btn-sm btn-outline-primary"
                                    onclick="event.stopPropagation(); viewAnnouncement('<%= a._id %>')"
                                    title="View details"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>
                                <form
                                    action="/admin/announcements/delete/<%= a._id %>"
                                    method="POST"
                                    onsubmit="event.stopPropagation(); return confirm('Delete this announcement and all <%= a.recipientCount %> delivered copies?');"
                                    style="display:inline;"
                                >
                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Delete"
                                        onclick="event.stopPropagation();"
                                    >
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card empty-state">
                    <i class="bi bi-megaphone"></i>
                    <h5>No Announcements Yet</h5>
                    <p class="mb-0">When nurses send broadcast messages, they will appear here.</p>
                </div>
            <% } %>
        </div>

        <!-- Back -->
        <div class="mt-3">
            <a href="/admin/dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- ========== ANNOUNCEMENT DETAILS MODAL ========== -->
    <div class="modal fade" id="announcementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-megaphone"></i> Announcement Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="announcementModalBody">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== SCRIPTS ========== -->
    <script>
        // Filter announcements by search + sender
        function filterAnnouncements() {
            const q = document.getElementById('searchInput').value.toLowerCase().trim();
            const nurse = document.getElementById('senderFilter').value;
            document.querySelectorAll('.announcement-card').forEach(card => {
                const subject = card.dataset.subject || '';
                const cardNurse = card.dataset.nurse || '';
                const matchesSearch = !q || subject.includes(q) || cardNurse.toLowerCase().includes(q);
                const matchesNurse = !nurse || cardNurse === nurse;
                card.style.display = (matchesSearch && matchesNurse) ? 'block' : 'none';
            });
        }

        // Fetch and show announcement details
        function viewAnnouncement(id) {
            const body = document.getElementById('announcementModalBody');
            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            const modal = new bootstrap.Modal(document.getElementById('announcementModal'));
            modal.show();

            fetch(`/admin/announcements/${id}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        body.innerHTML = '<div class="alert alert-danger">Announcement not found.</div>';
                        return;
                    }
                    const a = data.announcement;
                    let html = `
                        <div class="mb-3">
                            <strong class="text-muted small">Subject</strong>
                            <h5 class="mb-1">${escapeHtml(a.subject)}</h5>
                        </div>
                        <div class="mb-3">
                            <strong class="text-muted small">Message</strong>
                            <div class="message-content-box">${escapeHtml(a.message)}</div>
                        </div>
                        <div class="mb-3 d-flex flex-wrap gap-3">
                            <div>
                                <strong class="text-muted small">Sent by</strong>
                                <div><i class="bi bi-person-badge"></i> ${escapeHtml(a.nurseName || 'Nurse')}</div>
                            </div>
                            <div>
                                <strong class="text-muted small">Sent at</strong>
                                <div><i class="bi bi-clock"></i> ${new Date(a.sentAt).toLocaleString()}</div>
                            </div>
                            <div>
                                <strong class="text-muted small">Recipients</strong>
                                <div><i class="bi bi-people"></i> ${a.recipientCount} patients</div>
                            </div>
                        </div>
                        <hr>
                        <h6><i class="bi bi-person-lines-fill"></i> Recipients (${a.recipients.length})</h6>
                        <div style="max-height: 250px; overflow-y: auto; border: 1px solid #edf2f7; border-radius: 8px;">
                    `;
                    a.recipients.forEach(r => {
                        const statusColor = r.status === 'read' ? 'text-info' : r.status === 'replied' ? 'text-success' : 'text-danger';
                        html += `
                            <div class="recipient-row d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>${escapeHtml(r.name)}</strong>
                                    <br>
                                    <small class="text-muted">${escapeHtml(r.phone)} • ${escapeHtml(r.email)}</small>
                                </div>
                                <span class="small ${statusColor}">
                                    <i class="bi bi-${r.status === 'read' ? 'envelope-open' : r.status === 'replied' ? 'reply-all' : 'envelope'}"></i>
                                    ${r.status}
                                </span>
                            </div>
                        `;
                    });
                    html += `</div>`;
                    body.innerHTML = html;
                })
                .catch(err => {
                    console.error('Error loading announcement:', err);
                    body.innerHTML = '<div class="alert alert-danger">Failed to load details.</div>';
                });
        }

        // Simple HTML escape
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // Auto-dismiss flash messages
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.alert:not(.alert-info)').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => { a.style.display = 'none'; }, 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>