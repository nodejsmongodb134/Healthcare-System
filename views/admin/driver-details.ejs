<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        /* ===== RESET & BASE ===== */
        * {
            box-sizing: border-box;
        }
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            padding-bottom: 2rem;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 8px 0;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
        }
        .navbar-brand {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 0.3px;
        }
        .navbar-brand i {
            font-size: 1.2rem;
        }
        .navbar-text {
            font-size: 0.8rem;
        }
        .navbar .btn-outline-light {
            border-width: 1.5px;
            padding: 0.25rem 0.6rem;
            font-size: 0.75rem;
        }
        .navbar .btn-outline-light i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .navbar-brand {
                font-size: 0.85rem;
            }
            .navbar-text {
                font-size: 0.7rem;
            }
            .navbar .btn-outline-light {
                font-size: 0.7rem;
                padding: 0.2rem 0.5rem;
            }
            .navbar .btn-outline-light i {
                font-size: 0.8rem;
            }
            .navbar-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-end;
                gap: 4px;
                margin-top: 4px;
            }
            .navbar-nav .nav-item {
                display: inline-block;
            }
            .navbar-nav .nav-item .navbar-text {
                display: inline-flex;
                align-items: center;
                gap: 4px;
            }
        }
        @media (max-width: 399px) {
            .navbar .btn-outline-light {
                font-size: 0.6rem;
                padding: 0.15rem 0.4rem;
            }
            .navbar-brand {
                font-size: 0.75rem;
            }
            .navbar-text .badge {
                font-size: 0.55rem;
                padding: 0.15rem 0.4rem;
            }
        }

        /* ===== CARDS ===== */
        .card {
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
            border: none;
            background: #fff;
            transition: box-shadow 0.2s ease;
            height: 100%;
        }
        .card:hover {
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.10);
        }
        .card h5 {
            font-size: 1rem;
            font-weight: 600;
            color: #1a1a2e;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .card h5 i {
            color: #667eea;
            font-size: 1.1rem;
        }
        .card hr {
            margin: 0.75rem 0 1rem 0;
            opacity: 0.5;
        }

        /* ===== PROFILE INFO ROWS ===== */
        .info-row {
            display: flex;
            padding: 8px 0;
            border-bottom: 1px solid #f0f2f6;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .info-row:last-of-type {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #4a5568;
            min-width: 100px;
            flex-shrink: 0;
            font-size: 0.82rem;
        }
        .info-value {
            flex: 1;
            color: #1a202c;
            word-break: break-word;
            font-size: 0.82rem;
        }
        /* responsive info rows */
        @media (max-width: 575.98px) {
            .info-row {
                flex-direction: column;
                padding: 6px 0;
                gap: 2px;
            }
            .info-label {
                min-width: auto;
                width: 100%;
                font-size: 0.75rem;
                color: #718096;
                font-weight: 600;
            }
            .info-value {
                width: 100%;
                font-size: 0.8rem;
                padding-bottom: 2px;
            }
        }
        @media (min-width: 576px) and (max-width: 767.98px) {
            .info-label {
                min-width: 80px;
                font-size: 0.78rem;
            }
            .info-value {
                font-size: 0.8rem;
            }
        }

        /* ===== STATUS BADGE ===== */
        .status-badge {
            display: inline-block;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: capitalize;
            letter-spacing: 0.3px;
            line-height: 1.5;
        }
        .status-active {
            background: #28a745;
            color: #fff;
        }
        .status-inactive {
            background: #dc3545;
            color: #fff;
        }
        .status-on-leave {
            background: #ffc107;
            color: #856404;
        }
        .status-pending {
            background: #ffc107;
            color: #856404;
        }
        .status-in-transit {
            background: #17a2b8;
            color: #fff;
        }
        .status-delivered {
            background: #28a745;
            color: #fff;
        }
        .status-cancelled {
            background: #dc3545;
            color: #fff;
        }
        /* fallback */
        .status-unknown {
            background: #e2e8f0;
            color: #2d3748;
        }
        @media (max-width: 575.98px) {
            .status-badge {
                font-size: 0.7rem;
                padding: 3px 12px;
            }
        }

        /* ===== TABS ===== */
        .nav-tabs .nav-link {
            border-radius: 30px 30px 0 0;
            font-weight: 500;
            color: #4a5568;
            padding: 0.5rem 1.2rem;
            font-size: 0.85rem;
            border: 1px solid transparent;
            transition: all 0.15s ease;
            touch-action: manipulation;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .nav-tabs .nav-link:hover {
            border-color: #e2e8f0 #e2e8f0 #dee2e6;
            background: #f8fafc;
        }
        .nav-tabs .nav-link.active {
            color: #667eea;
            background: #fff;
            border-color: #dee2e6 #dee2e6 #fff;
            box-shadow: 0 -2px 8px rgba(0,0,0,0.02);
        }
        .nav-tabs .nav-link i {
            margin-right: 4px;
        }
        .tab-pane {
            padding: 1rem 0 0 0;
        }
        @media (max-width: 575.98px) {
            .nav-tabs {
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                gap: 2px;
            }
            .nav-tabs .nav-link {
                font-size: 0.75rem;
                padding: 0.4rem 0.8rem;
                min-height: 36px;
                white-space: nowrap;
            }
            .tab-pane {
                padding: 0.75rem 0 0 0;
            }
        }

        /* ===== TABLE ===== */
        .table-responsive {
            border-radius: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table {
            font-size: 0.82rem;
            margin-bottom: 0;
            min-width: 600px;
        }
        .table th {
            font-weight: 600;
            color: #4a5568;
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0.6rem 0.6rem;
            white-space: nowrap;
        }
        .table td {
            padding: 0.5rem 0.6rem;
            vertical-align: middle;
            border-bottom: 1px solid #edf2f7;
        }
        .table tbody tr:hover {
            background: #f7f9fc;
        }
        @media (max-width: 575.98px) {
            .table {
                font-size: 0.7rem;
                min-width: 480px;
            }
            .table th,
            .table td {
                padding: 0.3rem 0.4rem;
            }
        }

        /* ===== BUTTONS ===== */
        .btn-secondary {
            background: #e2e8f0;
            border-color: #d1d7e0;
            color: #2d3748;
            font-weight: 500;
            padding: 0.35rem 1.2rem;
            font-size: 0.82rem;
            border-radius: 30px;
            transition: all 0.2s ease;
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-secondary:hover {
            background: #d1d7e0;
            border-color: #b8c0cc;
            color: #1a202c;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }
        .btn-secondary i {
            font-size: 0.9rem;
        }
        @media (max-width: 575.98px) {
            .btn-secondary {
                width: 100%;
                justify-content: center;
                min-height: 44px;
                font-size: 0.78rem;
            }
        }

        /* ===== CONTAINER & GRID ===== */
        .container {
            padding-left: 16px;
            padding-right: 16px;
        }
        @media (max-width: 575.98px) {
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 24px;
                padding-right: 24px;
            }
        }
        @media (min-width: 992px) {
            .container {
                padding-left: 32px;
                padding-right: 32px;
            }
        }

        /* ===== GRID ROW SPACING ===== */
        .row.g-4 {
            --bs-gutter-y: 1.25rem;
            --bs-gutter-x: 1.25rem;
        }
        @media (max-width: 575.98px) {
            .row.g-4 {
                --bs-gutter-y: 1rem;
                --bs-gutter-x: 0.75rem;
            }
        }

        /* ===== TOUCH TARGETS ===== */
        .btn,
        .navbar .btn-outline-light,
        a,
        .nav-link {
            touch-action: manipulation;
        }

        /* ===== REDUCED MOTION ===== */
        @media (prefers-reduced-motion: reduce) {
            * {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
            }
        }

        /* ===== UTILITIES ===== */
        .mt-3 {
            margin-top: 1rem !important;
        }
        .mt-4 {
            margin-top: 1.5rem !important;
        }
        @media (max-width: 575.98px) {
            .mt-4 {
                margin-top: 1rem !important;
            }
        }
        .mb-3 {
            margin-bottom: 0.75rem !important;
        }
    </style>
    <link rel="stylesheet" href="/css/admin-responsive.css">
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i>
                <span class="d-none d-sm-inline">Appointment Booking</span>
                <span class="d-inline d-sm-none">Bookings</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item d-flex align-items-center">
                    <span class="navbar-text text-white me-2 me-lg-3">
                        <i class="bi bi-person-circle"></i>
                        <%= user.name %>
                        <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                    </span>
                </li>
                <li class="nav-item">
                    <a href="/admin/drivers" class="btn btn-outline-light btn-sm me-1 me-lg-2">
                        <i class="bi bi-arrow-left"></i> <span class="d-none d-sm-inline">Back</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div class="container mt-3 mt-md-4">
    <div class="row g-4">

        <!-- Profile Column -->
        <div class="col-12 col-md-4">
            <div class="card p-3">
                <h5><i class="bi bi-truck"></i> Driver Profile</h5>
                <hr />

                <div class="info-row">
                    <span class="info-label">Name</span>
                    <span class="info-value"><%= driver.name %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value"><%= driver.email %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Phone</span>
                    <span class="info-value"><%= driver.phone %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">ID Number</span>
                    <span class="info-value"><%= driver.idNumber %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Date of Birth</span>
                    <span class="info-value"><%= new Date(driver.dateOfBirth).toLocaleDateString() %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Age</span>
                    <span class="info-value"><%= driver.age || 'N/A' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Status</span>
                    <span class="info-value">
                        <span class="status-badge status-<%= driver.status %>"><%= driver.status %></span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">License</span>
                    <span class="info-value"><%= driver.licenseNumber || 'N/A' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Vehicle</span>
                    <span class="info-value"><%= driver.vehicleType || 'N/A' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Plate</span>
                    <span class="info-value"><%= driver.vehiclePlate || 'N/A' %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Joined</span>
                    <span class="info-value"><%= new Date(driver.createdAt).toLocaleDateString() %></span>
                </div>
            </div>
        </div>

        <!-- Orders Column -->
        <div class="col-12 col-md-8">
            <div class="card p-3">
                <!-- Tabs -->
                <ul class="nav nav-tabs" id="driverTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="orders-tab" data-bs-toggle="tab" href="#orders" role="tab">
                            <i class="bi bi-list-task"></i> Assigned Orders (<%= orders.length %>)
                        </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="orders" role="tabpanel">
                        <% if (orders.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Patient</th>
                                            <th>Prescription</th>
                                            <th>Status</th>
                                            <th>Location</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% orders.forEach(o => { %>
                                        <tr>
                                            <td><%= o.patientName %></td>
                                            <td><%= o.prescriptionName %></td>
                                            <td><span class="status-badge status-<%= o.status %>"><%= o.status %></span></td>
                                            <td><%= o.location.substring(0, 30) %><%= o.location.length > 30 ? '…' : '' %></td>
                                            <td><%= new Date(o.orderDate).toLocaleDateString() %></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p class="text-muted py-2">No orders assigned to this driver.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a href="/admin/drivers" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back to Drivers</a>
    </div>
</div>

<!-- Bootstrap JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>