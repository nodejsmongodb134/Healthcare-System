<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-secondary {
            color: #667eea;
            border-color: #667eea;
        }
        .btn-outline-secondary:hover {
            background: #667eea;
            color: white;
        }

        /* ========== STATUS BADGE ========== */
        .status-badge {
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-pending { background: #ffc107; color: #856404; }
        .status-confirmed { background: #28a745; color: white; }
        .status-cancelled { background: #dc3545; color: white; }
        .status-completed { background: #17a2b8; color: white; }

        /* ========== DETAIL LABELS & VALUES ========== */
        .detail-label {
            font-weight: 600;
            color: #555;
            display: block;
            margin-bottom: 2px;
        }
        .detail-value {
            padding: 8px 12px;
            background: #f8f9fa;
            border-radius: 8px;
            word-break: break-word;
        }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
            .status-badge { font-size: 0.75rem; padding: 4px 10px; }
            .detail-value { padding: 6px 10px; }
            .d-grid .btn { width: 100%; margin-bottom: 6px; }
            .d-md-flex { flex-direction: column; gap: 8px; }
            .d-md-flex .btn-outline-secondary { margin-right: 0 !important; }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
            .btn { font-size: 0.8rem; padding: 6px 14px; }
        }

        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-4 { padding: 32px !important; }
            .btn { font-size: 0.85rem; padding: 8px 20px; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR with responsive toggler ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/nurse/nurse-appointments" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card p-3 p-md-4">
                    <h4 class="h5"><i class="bi bi-calendar-check"></i> Appointment Details</h4>
                    <hr>

                    <!-- Status -->
                    <div class="mb-3">
                        <span class="detail-label">Status</span>
                        <div class="mt-1">
                            <span class="status-badge status-<%= appointment.status %>">
                                <i class="bi bi-<%= appointment.status === 'pending' ? 'clock' : appointment.status === 'confirmed' ? 'check-circle' : appointment.status === 'cancelled' ? 'x-circle' : 'check-all' %>"></i>
                                <%= appointment.status.charAt(0).toUpperCase() + appointment.status.slice(1) %>
                            </span>
                        </div>
                    </div>

                    <!-- Patient Info – two columns on larger screens -->
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-person"></i> Patient Name</span>
                            <div class="detail-value"><%= appointment.patientName %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-envelope"></i> Email</span>
                            <div class="detail-value"><%= appointment.patientEmail %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-telephone"></i> Phone</span>
                            <div class="detail-value"><%= appointment.patientPhone %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-calendar-date"></i> Date</span>
                            <div class="detail-value"><%= new Date(appointment.date).toLocaleDateString() %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-clock"></i> Time</span>
                            <div class="detail-value"><%= appointment.time %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-textarea"></i> Description</span>
                            <div class="detail-value"><%= appointment.description %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-calendar"></i> Created</span>
                            <div class="detail-value"><%= new Date(appointment.createdAt).toLocaleString() %></div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                        <a href="/nurse/nurse-appointments" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <a href="/nurse/nurse-appointments" class="btn btn-primary">
                            <i class="bi bi-calendar-check"></i> Manage Appointments
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>