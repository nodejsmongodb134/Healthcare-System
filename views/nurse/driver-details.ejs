<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
        .btn-primary { background: #667eea; border: none; }
        .btn-primary:hover { background: #5a67d8; }
        .btn-outline-secondary { color: #667eea; border-color: #667eea; }
        .btn-outline-secondary:hover { background: #667eea; color: white; }
        .btn-warning { background: #ffc107; border: none; color: #856404; }
        .btn-warning:hover { background: #e0a800; color: #856404; }
        .btn-info { background: #17a2b8; border: none; color: white; }
        .btn-info:hover { background: #138496; color: white; }
        .btn-danger { background: #dc3545; border: none; }
        .btn-danger:hover { background: #c82333; }
        .alert {
            animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ========== STATUS BADGE ========== */
        .status-badge {
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-active { background: #28a745; color: white; }
        .status-inactive { background: #dc3545; color: white; }
        .status-on-leave { background: #ffc107; color: #856404; }

        /* ========== PASSWORD BOX ========== */
        .password-box {
            background: #fff3cd;
            border: 2px dashed #ffc107;
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }
        .password-box .password-text {
            font-size: 1.3rem;
            font-weight: bold;
            color: #856404;
            letter-spacing: 2px;
            font-family: monospace;
            word-break: break-all;
        }
        @media (max-width: 575.98px) {
            .password-box .password-text {
                font-size: 1.1rem;
            }
        }

        /* ========== STATUS CARD ========== */
        .status-card {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 15px;
            border-radius: 10px;
            margin: 10px 0;
        }
        .status-card.status-active { border-left-color: #28a745; }
        .status-card.status-inactive { border-left-color: #dc3545; }
        .status-card.status-on-leave { border-left-color: #ffc107; }

        /* ========== DETAIL LABELS & VALUES ========== */
        .detail-label {
            font-weight: 600;
            color: #555;
            display: block;
            margin-bottom: 2px;
        }
        .detail-value {
            padding: 8px 12px;
            background: #f8f9fa;
            border-radius: 8px;
            word-break: break-word;
        }

        /* ========== MODAL ========== */
        .modal-content { border-radius: 15px; }
        .modal-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px 15px 0 0;
        }
        .modal-header .btn-close { filter: brightness(0) invert(1); }

        /* ========== PASSWORD STRENGTH ========== */
        .password-strength {
            height: 5px;
            margin-top: 5px;
            border-radius: 5px;
            transition: all 0.3s;
        }
        .password-requirements {
            font-size: 0.85rem;
            color: #666;
        }
        .password-requirements .valid { color: #28a745; }
        .password-requirements .invalid { color: #dc3545; }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
            .status-badge { font-size: 0.75rem; padding: 4px 10px; }
            .detail-value { padding: 6px 10px; }
            .password-box .password-text { font-size: 1rem; }
            .d-grid .btn { width: 100%; margin-bottom: 6px; }
            .d-md-flex { flex-direction: column; gap: 8px; }
            .d-md-flex .btn-outline-secondary { margin-right: 0 !important; }
            .password-box .col-md-5.text-end { text-align: left !important; margin-top: 10px; }
            .password-box .col-md-5 .btn { width: 100%; margin-top: 4px; }
            .status-card .col-md-6.text-end { text-align: left !important; margin-top: 10px; }
            .status-card .col-md-6 .btn { width: 100%; }
            .modal-dialog { margin: 10px; }
            .copy-btn { display: block; width: 100%; }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
            .btn { font-size: 0.8rem; padding: 6px 14px; }
        }

        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-4 { padding: 32px !important; }
            .btn { font-size: 0.85rem; padding: 8px 20px; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR with responsive toggler ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/nurse/create-driver" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                
                <!--------- Flash Messages -------------->

                <%- include('../partials/flash') %>


                <div class="card p-3 p-md-4">
                    <h4 class="h5"><i class="bi bi-person-badge"></i> Driver Details</h4>
                    <hr>

                    <!-- Password Box -->
                    <div class="password-box">
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <strong><i class="bi bi-key"></i> Driver Login Credentials:</strong>
                                <br>
                                <span class="text-muted">Email:</span> <strong><%= driver.email %></strong>
                                <br>
                                <span class="text-muted">Password:</span>
                                <span class="password-text" id="driverPassword">
                                    <%= driver.plainPassword || 'Password not available' %>
                                </span>
                                <br>
                                <small class="text-muted"><i class="bi bi-info-circle"></i> Give this password to the driver for login</small>
                            </div>
                            <div class="col-md-5 text-md-end">
                                <button class="btn btn-warning btn-sm copy-btn w-100 w-md-auto" onclick="copyPassword()">
                                    <i class="bi bi-clipboard"></i> Copy Password
                                </button>
                                <br>
                                <button class="btn btn-info btn-sm copy-btn w-100 w-md-auto mt-1" onclick="copyCredentials()">
                                    <i class="bi bi-clipboard-check"></i> Copy All
                                </button>
                                <br>
                                <button class="btn btn-danger btn-sm copy-btn w-100 w-md-auto mt-1" onclick="openResetModal()">
                                    <i class="bi bi-arrow-counterclockwise"></i> Reset Password
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Status Card -->
                    <div class="status-card status-<%= driver.status %>">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <strong><i class="bi bi-toggle-on"></i> Driver Status</strong>
                                <br>
                                <span class="status-badge status-<%= driver.status %>" style="font-size: 1rem; padding: 8px 16px;">
                                    <i class="bi bi-<%= driver.status === 'active' ? 'check-circle' : driver.status === 'on-leave' ? 'clock' : 'x-circle' %>"></i>
                                    <%= driver.status.charAt(0).toUpperCase() + driver.status.slice(1) %>
                                </span>
                                <br>
                                <small class="text-muted">
                                    <% if (driver.status === 'active') { %>
                                        <i class="bi bi-check-circle text-success"></i> Driver can login and accept orders
                                    <% } else if (driver.status === 'on-leave') { %>
                                        <i class="bi bi-clock text-warning"></i> Driver is temporarily unavailable
                                    <% } else { %>
                                        <i class="bi bi-x-circle text-danger"></i> Driver cannot login or accept orders
                                    <% } %>
                                </small>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <button class="btn btn-primary btn-sm w-100 w-md-auto" onclick="openStatusModal()">
                                    <i class="bi bi-pencil"></i> Change Status
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Driver Info – responsive two‑column layout -->
                    <div class="row g-2 mt-3">
                        <div class="col-sm-6">
                            <span class="detail-label">Full Name</span>
                            <div class="detail-value"><%= driver.name %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-credit-card-2-front"></i> ID Number</span>
                            <div class="detail-value"><%= driver.idNumber %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-telephone"></i> Phone</span>
                            <div class="detail-value"><%= driver.phone %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-envelope"></i> Email</span>
                            <div class="detail-value"><%= driver.email %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-calendar-event"></i> Date of Birth</span>
                            <div class="detail-value"><%= new Date(driver.dateOfBirth).toLocaleDateString() %></div>
                        </div>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-clock"></i> Age</span>
                            <div class="detail-value"><%= driver.age %> years</div>
                        </div>
                        <% if (driver.licenseNumber) { %>
                            <div class="col-sm-6">
                                <span class="detail-label"><i class="bi bi-card-list"></i> License Number</span>
                                <div class="detail-value"><%= driver.licenseNumber %></div>
                            </div>
                        <% } %>
                        <% if (driver.vehicleType) { %>
                            <div class="col-sm-6">
                                <span class="detail-label"><i class="bi bi-truck"></i> Vehicle Type</span>
                                <div class="detail-value"><%= driver.vehicleType.charAt(0).toUpperCase() + driver.vehicleType.slice(1) %></div>
                            </div>
                        <% } %>
                        <% if (driver.vehiclePlate) { %>
                            <div class="col-sm-6">
                                <span class="detail-label"><i class="bi bi-car-front"></i> Vehicle Plate</span>
                                <div class="detail-value"><%= driver.vehiclePlate %></div>
                            </div>
                        <% } %>
                        <div class="col-sm-6">
                            <span class="detail-label"><i class="bi bi-calendar"></i> Registered On</span>
                            <div class="detail-value"><%= new Date(driver.createdAt).toLocaleString() %></div>
                        </div>
                        <div class="col-sm-12">
                            <span class="detail-label"><i class="bi bi-box-arrow-in-right"></i> Driver Login URL</span>
                            <div class="detail-value d-flex flex-wrap align-items-center gap-2">
                                <a href="/driver/login" target="_blank" class="text-primary">http://localhost:3000/driver/login</a>
                                <button class="btn btn-sm btn-outline-primary" onclick="copyLoginUrl()">
                                    <i class="bi bi-clipboard"></i> Copy URL
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                        <a href="/nurse/create-driver" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <a href="/nurse/driver/edit/<%= driver._id %>" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Driver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Password Modal -->
    <div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-arrow-counterclockwise"></i> Reset Driver Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/nurse/driver/reset-password/<%= driver._id %>" method="POST" id="resetPasswordForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-person"></i> Driver</label>
                            <input type="text" class="form-control" value="<%= driver.name %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-envelope"></i> Email</label>
                            <input type="text" class="form-control" value="<%= driver.email %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label"><i class="bi bi-lock-fill"></i> New Password *</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="newPassword" name="newPassword" placeholder="Enter new password" minlength="6" required onkeyup="checkPasswordStrength(this.value)">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('newPassword', 'toggleNew')">
                                    <i class="bi bi-eye" id="toggleNew"></i>
                                </button>
                            </div>
                            <div class="password-strength" id="passwordStrength"></div>
                            <div class="password-requirements mt-2">
                                <small>Password must contain:</small>
                                <ul class="list-unstyled mt-1">
                                    <li id="reqLength" class="invalid"><i class="bi bi-x-circle"></i> At least 6 characters</li>
                                    <li id="reqLowercase" class="invalid"><i class="bi bi-x-circle"></i> At least one lowercase letter</li>
                                    <li id="reqUppercase" class="invalid"><i class="bi bi-x-circle"></i> At least one uppercase letter</li>
                                    <li id="reqNumber" class="invalid"><i class="bi bi-x-circle"></i> At least one number</li>
                                    <li id="reqSpecial" class="invalid"><i class="bi bi-x-circle"></i> At least one special character (!@#$%^&*)</li>
                                </ul>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label"><i class="bi bi-check-circle"></i> Confirm Password *</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required onkeyup="checkPasswordMatch()">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', 'toggleConfirm')">
                                    <i class="bi bi-eye" id="toggleConfirm"></i>
                                </button>
                            </div>
                            <small id="passwordMatch" class="text-muted"></small>
                        </div>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Warning:</strong> This will immediately change the driver's password. The driver will need to use the new password to login.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-arrow-counterclockwise"></i> Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Status Change Modal -->
    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-toggle-on"></i> Change Driver Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/nurse/driver/status/<%= driver._id %>" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-person"></i> Driver</label>
                            <input type="text" class="form-control" value="<%= driver.name %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-envelope"></i> Email</label>
                            <input type="text" class="form-control" value="<%= driver.email %>" readonly>
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label"><i class="bi bi-toggle-on"></i> Status *</label>
                            <select class="form-control" id="status" name="status" required>
                                <option value="active" <%= driver.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="on-leave" <%= driver.status === 'on-leave' ? 'selected' : '' %>>On Leave</option>
                                <option value="inactive" <%= driver.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i>
                                <strong>Active:</strong> Driver can login and accept orders<br>
                                <strong>On Leave:</strong> Driver is temporarily unavailable<br>
                                <strong>Inactive:</strong> Driver cannot login or accept orders
                            </small>
                        </div>
                        <div class="alert alert-warning" id="statusChangeWarning" style="display:none;">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Note:</strong> Changing the driver's status will affect their ability to login and accept orders.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Update Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // ========== COPY FUNCTIONS ==========
        function copyPassword() {
            const password = document.getElementById('driverPassword').textContent;
            if (password && password !== 'Password not available') {
                navigator.clipboard.writeText(password).then(() => alert('✅ Password copied to clipboard!'))
                    .catch(() => {
                        const input = document.createElement('input');
                        input.value = password;
                        document.body.appendChild(input);
                        input.select();
                        document.execCommand('copy');
                        document.body.removeChild(input);
                        alert('✅ Password copied to clipboard!');
                    });
            } else {
                alert('⚠️ Password not available. Please reset the password.');
            }
        }

        function copyCredentials() {
            const email = '<%= driver.email %>';
            const password = document.getElementById('driverPassword').textContent;
            const loginUrl = 'http://localhost:3000/driver/login';
            if (password && password !== 'Password not available') {
                const text = `🔐 Driver Login Credentials\n\nEmail: ${email}\nPassword: ${password}\nLogin URL: ${loginUrl}`;
                navigator.clipboard.writeText(text).then(() => alert('✅ All credentials copied!'))
                    .catch(() => {
                        const input = document.createElement('input');
                        input.value = text;
                        document.body.appendChild(input);
                        input.select();
                        document.execCommand('copy');
                        document.body.removeChild(input);
                        alert('✅ All credentials copied!');
                    });
            } else {
                alert('⚠️ Password not available. Please reset the password first.');
            }
        }

        function copyLoginUrl() {
            const url = 'http://localhost:3000/driver/login';
            navigator.clipboard.writeText(url).then(() => alert('✅ Login URL copied!'))
                .catch(() => {
                    const input = document.createElement('input');
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand('copy');
                    document.body.removeChild(input);
                    alert('✅ Login URL copied!');
                });
        }

        // ========== MODAL FUNCTIONS ==========
        function openResetModal() {
            const modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            modal.show();
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';
            document.getElementById('passwordMatch').textContent = '';
            document.getElementById('passwordStrength').style.width = '0%';
            document.getElementById('passwordStrength').style.backgroundColor = '';
            ['reqLength','reqLowercase','reqUppercase','reqNumber','reqSpecial'].forEach(id => {
                const el = document.getElementById(id);
                el.className = 'invalid';
                el.innerHTML = '<i class="bi bi-x-circle"></i> ' + el.textContent.replace(/[✓✗]/g, '').trim();
            });
        }

        function openStatusModal() {
            const modal = new bootstrap.Modal(document.getElementById('statusModal'));
            modal.show();
        }

        // ========== PASSWORD TOGGLE ==========
        function togglePassword(inputId, toggleId) {
            const input = document.getElementById(inputId);
            const toggle = document.getElementById(toggleId);
            if (input.type === 'password') {
                input.type = 'text';
                toggle.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                toggle.className = 'bi bi-eye';
            }
        }

        // ========== PASSWORD STRENGTH ==========
        function checkPasswordStrength(password) {
            const bar = document.getElementById('passwordStrength');
            let strength = 0;
            const hasLength = password.length >= 6;
            const hasLowercase = /[a-z]/.test(password);
            const hasUppercase = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[!@#$%^&*]/.test(password);

            updateRequirement('reqLength', hasLength);
            updateRequirement('reqLowercase', hasLowercase);
            updateRequirement('reqUppercase', hasUppercase);
            updateRequirement('reqNumber', hasNumber);
            updateRequirement('reqSpecial', hasSpecial);

            if (hasLength) strength++;
            if (hasLowercase) strength++;
            if (hasUppercase) strength++;
            if (hasNumber) strength++;
            if (hasSpecial) strength++;

            if (password.length === 0) {
                bar.style.backgroundColor = '';
                bar.style.width = '0%';
            } else if (strength <= 2) {
                bar.style.backgroundColor = '#dc3545';
                bar.style.width = '20%';
            } else if (strength === 3) {
                bar.style.backgroundColor = '#ffc107';
                bar.style.width = '50%';
            } else if (strength === 4) {
                bar.style.backgroundColor = '#17a2b8';
                bar.style.width = '75%';
            } else {
                bar.style.backgroundColor = '#28a745';
                bar.style.width = '100%';
            }
            checkPasswordMatch();
        }

        function updateRequirement(id, isValid) {
            const el = document.getElementById(id);
            const text = el.textContent.replace(/[✓✗]/g, '').trim();
            if (isValid) {
                el.className = 'valid';
                el.innerHTML = '<i class="bi bi-check-circle"></i> ' + text;
            } else {
                el.className = 'invalid';
                el.innerHTML = '<i class="bi bi-x-circle"></i> ' + text;
            }
        }

        function checkPasswordMatch() {
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const match = document.getElementById('passwordMatch');
            if (confirmPwd.length === 0) {
                match.textContent = '';
                match.className = 'text-muted';
                return;
            }
            if (newPwd === confirmPwd) {
                match.textContent = '✓ Passwords match!';
                match.className = 'text-success';
            } else {
                match.textContent = '✗ Passwords do not match';
                match.className = 'text-danger';
            }
        }

        // ========== STATUS CHANGE WARNING ==========
        document.addEventListener('DOMContentLoaded', function() {
            const statusSelect = document.getElementById('status');
            if (statusSelect) {
                statusSelect.addEventListener('change', function() {
                    const warning = document.getElementById('statusChangeWarning');
                    warning.style.display = (this.value !== '<%= driver.status %>') ? 'block' : 'none';
                });
            }
            // Auto-dismiss flash messages
            document.querySelectorAll('.alert').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
        });

        // ========== FORM VALIDATION ==========
        document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            if (!newPwd || !confirmPwd) { e.preventDefault(); alert('Please fill in all fields'); return false; }
            if (newPwd !== confirmPwd) { e.preventDefault(); alert('Passwords do not match!'); return false; }
            if (newPwd.length < 6) { e.preventDefault(); alert('Password must be at least 6 characters'); return false; }
            if (!/[a-z]/.test(newPwd) || !/[A-Z]/.test(newPwd) || !/[0-9]/.test(newPwd) || !/[!@#$%^&*]/.test(newPwd)) {
                e.preventDefault();
                alert('Password must contain lowercase, uppercase, number, and special character');
                return false;
            }
            return true;
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>