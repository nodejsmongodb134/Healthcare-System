<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f0f2f5; font-size: 14px; line-height: 1.6; }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand { font-size: 1.1rem; font-weight: 600; }
        .navbar-text { font-size: 0.85rem; }
        .btn-outline-light { border-color: rgba(255,255,255,0.5); color: white; }
        .btn-outline-light:hover { background: rgba(255,255,255,0.2); border-color: white; }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
        }
        .btn-primary { background: #667eea; border: none; }
        .btn-primary:hover { background: #5a67d8; }
        .btn-outline-secondary { color: #667eea; border-color: #667eea; }
        .btn-outline-secondary:hover { background: #667eea; color: white; }
        .form-label { font-weight: 600; color: #555; }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25);
        }
        .announcement-icon {
            font-size: 3rem;
            color: #667eea;
        }
        .char-counter {
            font-size: 0.85rem;
        }
        .char-counter.success { color: #28a745; }
        .char-counter.warning { color: #ffc107; }
        .char-counter.danger { color: #dc3545; }
        .preview-box {
            background: #f8f9fa;
            border-left: 4px solid #667eea;
            padding: 12px 15px;
            border-radius: 8px;
            font-family: monospace;
            font-size: 0.85rem;
            white-space: pre-wrap;
            word-wrap: break-word;
            min-height: 60px;
        }
        .alert { animation: slideDown 0.5s ease-out; }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .announcement-icon { font-size: 2.2rem; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/nurse-dashboard" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Header -->
        <div class="alert alert-info shadow-sm">
            <h4 class="h5"><i class="bi bi-megaphone"></i> Send Announcement</h4>
            <p class="mb-0">Broadcast a message to all patients via SMS.</p>
        </div>

        <!-- Flash Messages -->
        <%- include('../partials/flash') %>

        <div class="row g-4">
            <!-- ========== FORM ========== -->
            <div class="col-lg-8">
                <div class="card p-3 p-md-4">
                    <div class="text-center mb-3">
                        <i class="bi bi-megaphone announcement-icon"></i>
                    </div>

                    <h5 class="h6 mb-3"><i class="bi bi-pencil-square"></i> Compose Announcement</h5>
                    <hr>

                    <% if (!smsEnabled) { %>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>SMS is currently disabled.</strong>
                            Set <code>SMS_ENABLED=true</code> and provide a valid API key to send announcements.
                        </div>
                    <% } %>

                    <form action="/nurse/announcement/send" method="POST" id="announcementForm">

                        <!-- Subject -->
                        <div class="mb-3">
                            <label for="subject" class="form-label">
                                <i class="bi bi-tag"></i> Subject <span class="text-danger">*</span>
                            </label>
                            <input
                                type="text"
                                class="form-control"
                                id="subject"
                                name="subject"
                                placeholder="e.g. Clinic Closure Notice"
                                maxlength="80"
                                required
                            >
                            <small class="text-muted char-counter" id="subjectCount">0 / 80 characters</small>
                        </div>

                        <!-- Message -->
                        <div class="mb-3">
                            <label for="message" class="form-label">
                                <i class="bi bi-textarea"></i> Message <span class="text-danger">*</span>
                            </label>
                            <textarea
                                class="form-control"
                                id="message"
                                name="message"
                                rows="6"
                                placeholder="Type the announcement message..."
                                maxlength="500"
                                required
                            ></textarea>
                            <small class="text-muted char-counter" id="messageCount">0 / 500 characters</small>
                        </div>

                        <!-- Recipients Info -->
                        <div class="alert alert-info">
                            <i class="bi bi-people"></i>
                            This announcement will be sent to
                            <strong><%= totalPatients %> patients</strong> who have a phone number on file.
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-wrap gap-2 justify-content-end">
                            <a href="/auth/nurse-dashboard" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button
                                type="submit"
                                class="btn btn-primary"
                                id="submitBtn"
                                <%= !smsEnabled ? 'disabled' : '' %>
                            >
                                <i class="bi bi-send"></i> Send Announcement
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ========== LIVE PREVIEW ========== -->
            <div class="col-lg-4">
                <div class="card p-3 p-md-4">
                    <h6 class="h6"><i class="bi bi-eye"></i> SMS Preview</h6>
                    <hr>
                    <p class="text-muted small mb-2">This is what patients will receive:</p>
                    <div class="preview-box" id="preview">
                        📢 <span class="text-muted">Your subject here</span>

                        <span class="text-muted">Your message here...</span>
                    </div>
                </div>

                <!-- Tips -->
                <div class="card p-3 mt-3">
                    <h6 class="h6"><i class="bi bi-lightbulb"></i> Tips</h6>
                    <hr>
                    <ul class="small mb-0 ps-3">
                        <li>Keep the subject short and clear.</li>
                        <li>Avoid abbreviations – SMS is for everyone.</li>
                        <li>For SMS, aim for under 160 characters per segment.</li>
                        <li>Long messages are split into multiple SMS.</li>
                        <li>Patients receive this as a broadcast – no replies.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== SCRIPTS ========== -->
    <script>
        const subjectInput = document.getElementById('subject');
        const messageInput = document.getElementById('message');
        const preview = document.getElementById('preview');

        // Character counters
        subjectInput.addEventListener('input', function () {
            const count = this.value.length;
            const counter = document.getElementById('subjectCount');
            counter.textContent = count + ' / 80 characters';
            counter.className = 'text-muted char-counter ' +
                (count > 70 ? 'danger' : count > 55 ? 'warning' : 'success');
            updatePreview();
        });

        messageInput.addEventListener('input', function () {
            const count = this.value.length;
            const counter = document.getElementById('messageCount');
            counter.textContent = count + ' / 500 characters';
            counter.className = 'text-muted char-counter ' +
                (count > 450 ? 'danger' : count > 350 ? 'warning' : 'success');
            updatePreview();
        });

        // Live preview
        function updatePreview() {
            const subject = subjectInput.value.trim() || 'Your subject here';
            const message = messageInput.value.trim() || 'Your message here...';
            preview.innerHTML = '📢 ' + escapeHtml(subject) + '\n\n' + escapeHtml(message);
        }

        // Escape HTML in preview (prevents XSS inside the preview box)
        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // Form validation before submit
        document.getElementById('announcementForm').addEventListener('submit', function (e) {
            const subject = subjectInput.value.trim();
            const message = messageInput.value.trim();
            if (subject.length < 3) {
                e.preventDefault();
                alert('Subject must be at least 3 characters');
                return false;
            }
            if (message.length < 10) {
                e.preventDefault();
                alert('Message must be at least 10 characters');
                return false;
            }
            // Confirm before sending
            const confirmed = confirm(
                'Send this announcement to all patients with a phone number? This cannot be undone.'
            );
            if (!confirmed) {
                e.preventDefault();
                return false;
            }
            // Disable the button to prevent double‑submit
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').innerHTML =
                '<i class="bi bi-hourglass-split"></i> Sending...';
            return true;
        });

        // Auto-dismiss flash messages
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.alert:not(.alert-info)').forEach(function (a) {
                setTimeout(function () {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(function () { a.style.display = 'none'; }, 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>