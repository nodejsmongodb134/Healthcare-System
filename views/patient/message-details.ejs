<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL RESET ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-secondary {
            color: #667eea;
            border-color: #667eea;
        }
        .btn-outline-secondary:hover {
            background: #667eea;
            color: white;
        }
        .btn-outline-warning {
            color: #ffc107;
            border-color: #ffc107;
        }
        .btn-outline-warning:hover {
            background: #ffc107;
            color: #212529;
        }
        .btn-outline-danger {
            color: #dc3545;
            border-color: #dc3545;
        }
        .btn-outline-danger:hover {
            background: #dc3545;
            color: white;
        }

        /* ========== STATUS BADGE ========== */
        .status-badge {
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-unread { background: #dc3545; color: white; }
        .status-read { background: #17a2b8; color: white; }
        .status-replied { background: #28a745; color: white; }

        /* ========== MESSAGE CONTENT ========== */
        .message-content {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #667eea;
            word-wrap: break-word;
            white-space: pre-wrap;
        }
        .reply-content {
            background: #e8f5e9;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #28a745;
            word-wrap: break-word;
            white-space: pre-wrap;
        }
        .image-display {
            max-width: 100%;
            max-height: 300px;
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 5px;
        }

        /* ========== ALERTS ========== */
        .alert {
            animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
            .status-badge { font-size: 0.75rem; padding: 4px 10px; }
            .message-content, .reply-content {
                padding: 12px;
            }
            .d-grid .btn {
                width: 100%;
                margin-bottom: 6px;
            }
            .d-md-flex {
                flex-direction: column;
                gap: 6px;
            }
            .d-md-flex .btn-outline-secondary {
                margin-right: 0 !important;
            }
            .d-md-flex .btn-outline-warning {
                margin-right: 0 !important;
            }
            .image-display {
                max-height: 200px;
            }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
            .btn { font-size: 0.8rem; padding: 6px 14px; }
        }

        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-4 { padding: 32px !important; }
            .btn { font-size: 0.85rem; padding: 8px 20px; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR with responsive toggler ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/patient/message" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Back to Messages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card p-4">
                    <h4 class="mb-3"><i class="bi bi-envelope-paper"></i> Message Details</h4>
                    <hr>

                    <!-- Status -->
                    <div class="mb-3">
                        <strong>Status:</strong>
                        <span class="status-badge status-<%= message.status %>">
                            <i class="bi bi-<%= message.status === 'unread' ? 'envelope' : message.status === 'read' ? 'envelope-open' : 'reply-all' %>"></i>
                            <%= message.status.charAt(0).toUpperCase() + message.status.slice(1) %>
                        </span>
                    </div>

                    <!-- Subject -->
                    <div class="mb-3">
                        <strong><i class="bi bi-tag"></i> Subject:</strong>
                        <h5 class="mt-1"><%= message.subject %></h5>
                    </div>

                    <!-- ===== SENDER INFO ===== -->
                    <div class="mb-3">
                        <strong><i class="bi bi-person"></i> From:</strong>
                        <p><%= message.senderRole === 'nurse' ? (message.nurseName || 'Nurse') : message.patientName %></p>
                        <% if (message.senderRole === 'nurse') { %>
                            <span class="badge bg-info">Nurse</span>
                        <% } %>
                    </div>

                    <!-- Sender contact details -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <strong><i class="bi bi-envelope"></i> Email:</strong>
                            <p><%= message.patientEmail %></p>
                        </div>
                        <div class="col-sm-6">
                            <strong><i class="bi bi-telephone"></i> Phone:</strong>
                            <p><%= message.patientPhone %></p>
                        </div>
                        <div class="col-sm-6">
                            <strong><i class="bi bi-calendar"></i> Sent:</strong>
                            <p><%= new Date(message.createdAt).toLocaleString() %></p>
                        </div>
                        <% if (message.parentId) { %>
                            <div class="col-sm-6">
                                <strong><i class="bi bi-reply"></i> Reply to:</strong>
                                <p>Original message</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Message body -->
                    <div class="mb-3">
                        <strong><i class="bi bi-textarea"></i> Message:</strong>
                        <div class="message-content mt-1">
                            <p class="mb-0"><%= message.message %></p>
                        </div>
                    </div>

                    <!-- Patient attached image (if any) -->
                    <% if (message.imageUrl) { %>
                        <div class="mb-3">
                            <strong><i class="bi bi-image"></i> Attached Image:</strong>
                            <div class="mt-2">
                                <img src="<%= message.imageUrl %>" alt="Attached image" class="image-display">
                            </div>
                        </div>
                    <% } %>

                    <!-- Reply (if any) -->
                    <% if (message.nurseReply) { %>
                        <div class="mb-3">
                            <strong><i class="bi bi-reply"></i> Nurse Reply:</strong>
                            <div class="reply-content mt-1">
                                <p class="mb-0"><%= message.nurseReply %></p>
                                <!-- Display reply image if exists -->
                                <% if (message.nurseReplyImageUrl) { %>
                                    <div class="mt-2">
                                        <img src="<%= message.nurseReplyImageUrl %>" alt="Reply image" style="max-width: 100%; max-height: 200px; border-radius: 8px; border: 1px solid #ddd; padding: 5px;">
                                    </div>
                                <% } %>
                                <small class="text-muted mt-2 d-block">
                                    <i class="bi bi-calendar"></i> Replied on: <%= new Date(message.replyDate).toLocaleString() %>
                                </small>
                            </div>
                        </div>
                    <% } %>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                        <a href="/patient/message" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back
                        </a>
                        <!-- ===== REPLY BUTTON ===== -->
                        <a href="/patient/message/reply/<%= message._id %>" class="btn btn-primary">
                            <i class="bi bi-reply"></i> Reply
                        </a>
                        <% if (message.status !== 'replied') { %>
                            <a href="/patient/message/edit/<%= message._id %>" class="btn btn-outline-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button class="btn btn-outline-danger" onclick="deleteMessage('<%= message._id %>')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Delete message
        function deleteMessage(id) {
            if (confirm('Are you sure you want to delete this message? This action cannot be undone.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/patient/message/delete/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Auto‑dismiss flash messages (if any)
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>