<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    /* ========== GLOBAL RESET & BASE ========== */
    body {
      background: #f0f2f5;
      font-size: 14px;
      line-height: 1.6;
    }
    .navbar {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 10px 0;
    }
    .navbar-brand {
      font-size: 1.1rem;
      font-weight: 600;
    }
    .navbar-text {
      font-size: 0.85rem;
    }
    .card {
      border-radius: 15px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.08);
      border: none;
    }
    .btn {
      border-radius: 25px;
      font-weight: 500;
      font-size: 0.85rem;
      padding: 6px 16px;
    }
    .btn-sm {
      font-size: 0.75rem;
      padding: 4px 12px;
    }
    .btn-outline-light {
      border-color: rgba(255,255,255,0.5);
      color: white;
    }
    .btn-outline-light:hover {
      background: rgba(255,255,255,0.2);
      border-color: white;
    }

    /* ========== STATUS BADGE ========== */
    .status-badge {
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 500;
      display: inline-block;
    }
    .status-pending { background: #ffc107; color: #856404; }
    .status-confirmed { background: #28a745; color: white; }
    .status-cancelled { background: #dc3545; color: white; }
    .status-completed { background: #17a2b8; color: white; }

    /* ========== INFO ROWS ========== */
    .info-row {
      display: flex;
      padding: 8px 0;
      border-bottom: 1px solid #eee;
      flex-wrap: wrap;
    }
    .info-label {
      font-weight: 600;
      color: #555;
      min-width: 100px;
      width: 35%;
    }
    .info-value {
      flex: 1;
      word-break: break-word;
    }

    /* ========== RESPONSIVE TWEAKS ========== */

    /* Small devices (phones, < 576px) */
    @media (max-width: 575.98px) {
      body {
        font-size: 13px;
      }
      .container {
        padding-left: 12px;
        padding-right: 12px;
      }
      .navbar-brand {
        font-size: 0.95rem;
      }
      .navbar-text {
        font-size: 0.75rem;
      }
      .card .p-4 {
        padding: 16px !important;
      }
      .btn {
        font-size: 0.75rem;
        padding: 5px 12px;
      }
      .btn-sm {
        font-size: 0.65rem;
        padding: 3px 8px;
      }
      .status-badge {
        font-size: 0.75rem;
        padding: 4px 10px;
      }
      /* Stack info rows vertically */
      .info-row {
        flex-direction: column;
        align-items: flex-start;
      }
      .info-label {
        width: 100%;
        margin-bottom: 2px;
      }
      .info-value {
        width: 100%;
      }
      /* Back button full width on mobile */
      .btn-secondary {
        display: block;
        width: 100%;
        text-align: center;
      }
    }

    /* Medium devices (tablets, 576px – 991.98px) */
    @media (min-width: 576px) and (max-width: 991.98px) {
      .container {
        padding-left: 20px;
        padding-right: 20px;
      }
      .card .p-4 {
        padding: 24px !important;
      }
      .info-label {
        min-width: 120px;
      }
    }

    /* Large devices (desktops, ≥ 992px) */
    @media (min-width: 992px) {
      .container {
        padding-left: 40px;
        padding-right: 40px;
      }
      .card .p-4 {
        padding: 32px !important;
      }
      .info-label {
        min-width: 140px;
      }
    }
  </style>
</head>
<body>
  <!-- ========== NAVBAR with responsive toggler ========== -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
      <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <span class="navbar-text text-white me-3">
              <i class="bi bi-person-circle"></i> <%= user.name %>
              <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
            </span>
          </li>
          <li class="nav-item">
            <a href="/patient/view-appointments" class="btn btn-outline-light btn-sm me-2">
              <i class="bi bi-arrow-left"></i> Back
            </a>
          </li>
          <li class="nav-item">
            <a href="/auth/logout" class="btn btn-outline-light btn-sm">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- ========== MAIN CONTENT ========== -->
  <div class="container mt-4">
    <div class="card p-4 shadow-sm">
      <h4 class="mb-3"><i class="bi bi-calendar-check"></i> Appointment Details</h4>
      <hr>

      <!-- Two columns on desktop, single column on mobile -->
      <div class="row g-3">
        <div class="col-md-6">
          <div class="info-row">
            <span class="info-label"><i class="bi bi-person"></i> Patient</span>
            <span class="info-value"><%= appointment.patientName %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-envelope"></i> Email</span>
            <span class="info-value"><%= appointment.patientEmail %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-telephone"></i> Phone</span>
            <span class="info-value"><%= appointment.patientPhone %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-calendar-date"></i> Date</span>
            <span class="info-value"><%= new Date(appointment.date).toLocaleDateString() %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-clock"></i> Time</span>
            <span class="info-value"><%= appointment.time %></span>
          </div>
        </div>

        <div class="col-md-6">
          <div class="info-row">
            <span class="info-label"><i class="bi bi-tag"></i> Status</span>
            <span class="info-value">
              <span class="status-badge status-<%= appointment.status %>">
                <%= appointment.status.charAt(0).toUpperCase() + appointment.status.slice(1) %>
              </span>
            </span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-textarea"></i> Description</span>
            <span class="info-value"><%= appointment.description %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-calendar-plus"></i> Created</span>
            <span class="info-value"><%= new Date(appointment.createdAt).toLocaleString() %></span>
          </div>
          <div class="info-row">
            <span class="info-label"><i class="bi bi-calendar-check"></i> Updated</span>
            <span class="info-value"><%= new Date(appointment.updatedAt).toLocaleString() %></span>
          </div>
        </div>
      </div>

      <div class="mt-4 d-grid d-md-flex gap-2">
        <a href="/patient/view-appointments" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Back to Appointments
        </a>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS for toggler -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>