<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL RESET ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-secondary {
            color: #667eea;
            border-color: #667eea;
        }
        .btn-outline-secondary:hover {
            background: #667eea;
            color: white;
        }
        .form-label {
            font-weight: 600;
            color: #555;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        /* ========== PASSWORD STRENGTH ========== */
        .password-strength {
            height: 5px;
            margin-top: 5px;
            border-radius: 5px;
            transition: all 0.3s;
            background-color: #e9ecef;
        }
        .password-requirements {
            font-size: 0.85rem;
            color: #666;
        }
        .password-requirements .valid {
            color: #28a745;
        }
        .password-requirements .invalid {
            color: #dc3545;
        }

        /* ========== ALERTS ========== */
        .alert {
            animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ========== VALIDATION SUMMARY ========== */
        .validation-summary {
            border-left: 4px solid #dc3545;
            background-color: #f8d7da;
            padding: 10px;
            border-radius: 5px;
            display: none;
        }
        .validation-summary.show {
            display: block;
        }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
            .input-group .btn {
                font-size: 0.75rem;
                padding: 6px 10px;
            }
            .form-label { font-size: 0.85rem; }
            .form-control { font-size: 0.9rem; padding: 8px 10px; }
            .password-requirements { font-size: 0.8rem; }
            .d-grid .btn {
                width: 100%;
                margin-bottom: 6px;
            }
            .d-md-flex {
                flex-direction: column;
                gap: 6px;
            }
            .d-md-flex .btn-outline-secondary {
                margin-right: 0 !important;
            }
            .validation-summary ul { padding-left: 20px; font-size: 0.85rem; }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
            .btn { font-size: 0.8rem; padding: 6px 14px; }
            .form-control { font-size: 0.95rem; }
        }

        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-4 { padding: 32px !important; }
            .btn { font-size: 0.85rem; padding: 8px 20px; }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR with responsive toggler ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/patient/profile" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-arrow-left"></i> Back to Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card p-4">
                    <h4 class="mb-3"><i class="bi bi-key"></i> Change Password</h4>
                    <hr>

                    <!-- Flash Messages -->

                    <%- include('../partials/flash') %>

                    <form action="/patient/change-password" method="POST" id="changePasswordForm" onsubmit="return validateForm()">
                        <!-- Current Password -->
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label"><i class="bi bi-lock"></i> Current Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('currentPassword', 'toggleCurrent')">
                                    <i class="bi bi-eye" id="toggleCurrent"></i>
                                </button>
                            </div>
                            <small id="currentPasswordError" class="text-danger"></small>
                        </div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label for="newPassword" class="form-label"><i class="bi bi-lock-fill"></i> New Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" onkeyup="validateNewPassword(this.value)">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('newPassword', 'toggleNew')">
                                    <i class="bi bi-eye" id="toggleNew"></i>
                                </button>
                            </div>
                            <div class="password-strength" id="passwordStrength"></div>
                            <div class="password-requirements mt-2">
                                <small>Password must contain:</small>
                                <ul class="list-unstyled mt-1">
                                    <li id="reqLength" class="invalid"><i class="bi bi-x-circle"></i> At least 6 characters</li>
                                    <li id="reqLowercase" class="invalid"><i class="bi bi-x-circle"></i> At least one lowercase letter</li>
                                    <li id="reqUppercase" class="invalid"><i class="bi bi-x-circle"></i> At least one uppercase letter</li>
                                    <li id="reqNumber" class="invalid"><i class="bi bi-x-circle"></i> At least one number</li>
                                    <li id="reqSpecial" class="invalid"><i class="bi bi-x-circle"></i> At least one special character (!@#$%^&*)</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label"><i class="bi bi-check-circle"></i> Confirm New Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required onkeyup="checkPasswordMatch()">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('confirmPassword', 'toggleConfirm')">
                                    <i class="bi bi-eye" id="toggleConfirm"></i>
                                </button>
                            </div>
                            <small id="passwordMatch" class="text-muted"></small>
                        </div>

                        <!-- Validation Summary -->
                        <div id="validationSummary" class="validation-summary">
                            <strong><i class="bi bi-exclamation-triangle"></i> Please fix the following:</strong>
                            <ul id="validationList" class="mb-0 mt-1"></ul>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                            <a href="/patient/profile" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Update Password</button>
                        </div>
                    </form>

                    <!-- Security Tips -->
                    <div class="mt-4 p-3 bg-light rounded">
                        <h6><i class="bi bi-shield-lock"></i> Security Tips:</h6>
                        <ul class="mb-0 small">
                            <li>Use a unique password that you don't use for other accounts</li>
                            <li>Make it at least 12 characters long for better security</li>
                            <li>Use a mix of letters, numbers, and special characters</li>
                            <li>Avoid using personal information like your name or birthdate</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== SCRIPTS (unchanged functionality) ========== -->
    <script>
        // Toggle password visibility
        function togglePassword(inputId, toggleId) {
            const input = document.getElementById(inputId);
            const toggle = document.getElementById(toggleId);
            if (input.type === 'password') {
                input.type = 'text';
                toggle.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                toggle.className = 'bi bi-eye';
            }
        }

        // Validate new password
        function validateNewPassword(password) {
            const hasLength = password.length >= 6;
            const hasLowercase = /[a-z]/.test(password);
            const hasUppercase = /[A-Z]/.test(password);
            const hasNumber = /[0-9]/.test(password);
            const hasSpecial = /[!@#$%^&*]/.test(password);

            updateRequirement('reqLength', hasLength);
            updateRequirement('reqLowercase', hasLowercase);
            updateRequirement('reqUppercase', hasUppercase);
            updateRequirement('reqNumber', hasNumber);
            updateRequirement('reqSpecial', hasSpecial);

            updatePasswordStrength(password);
            checkPasswordMatch();
            updateValidationSummary();
        }

        function updateRequirement(id, isValid) {
            const element = document.getElementById(id);
            const text = element.textContent.replace(/[✓✗]/g, '').trim();
            if (isValid) {
                element.className = 'valid';
                element.innerHTML = '<i class="bi bi-check-circle"></i> ' + text;
            } else {
                element.className = 'invalid';
                element.innerHTML = '<i class="bi bi-x-circle"></i> ' + text;
            }
        }

        function updatePasswordStrength(password) {
            const bar = document.getElementById('passwordStrength');
            let strength = 0;
            if (password.length >= 6) strength++;
            if (/[a-z]/.test(password)) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[!@#$%^&*]/.test(password)) strength++;
            if (password.length === 0) {
                bar.style.backgroundColor = '';
                bar.style.width = '0%';
            } else if (strength <= 2) {
                bar.style.backgroundColor = '#dc3545';
                bar.style.width = '20%';
            } else if (strength === 3) {
                bar.style.backgroundColor = '#ffc107';
                bar.style.width = '50%';
            } else if (strength === 4) {
                bar.style.backgroundColor = '#17a2b8';
                bar.style.width = '75%';
            } else {
                bar.style.backgroundColor = '#28a745';
                bar.style.width = '100%';
            }
        }

        function checkPasswordMatch() {
            const newPwd = document.getElementById('newPassword').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const match = document.getElementById('passwordMatch');
            if (confirmPwd.length === 0) {
                match.textContent = '';
                match.className = 'text-muted';
                return;
            }
            if (newPwd === confirmPwd) {
                match.textContent = '✓ Passwords match!';
                match.className = 'text-success';
            } else {
                match.textContent = '✗ Passwords do not match';
                match.className = 'text-danger';
            }
        }

        function updateValidationSummary() {
            const summary = document.getElementById('validationSummary');
            const list = document.getElementById('validationList');
            const errors = [];
            const current = document.getElementById('currentPassword').value;
            if (!current) errors.push('Current password is required');
            const newPwd = document.getElementById('newPassword').value;
            if (!newPwd) {
                errors.push('New password is required');
            } else {
                if (newPwd.length < 6) errors.push('Password must be at least 6 characters');
                if (!/[a-z]/.test(newPwd)) errors.push('Password must contain at least one lowercase letter');
                if (!/[A-Z]/.test(newPwd)) errors.push('Password must contain at least one uppercase letter');
                if (!/[0-9]/.test(newPwd)) errors.push('Password must contain at least one number');
                if (!/[!@#$%^&*]/.test(newPwd)) errors.push('Password must contain at least one special character (!@#$%^&*)');
            }
            const confirm = document.getElementById('confirmPassword').value;
            if (!confirm) errors.push('Confirm password is required');
            else if (newPwd && newPwd !== confirm) errors.push('Passwords do not match');

            if (errors.length > 0) {
                summary.className = 'validation-summary show';
                list.innerHTML = errors.map(e => `<li>• ${e}</li>`).join('');
            } else {
                summary.className = 'validation-summary';
                list.innerHTML = '';
            }
        }

        function validateForm() {
            const current = document.getElementById('currentPassword').value;
            const newPwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            if (!current || !newPwd || !confirm) {
                alert('Please fill in all fields');
                return false;
            }
            const hasLength = newPwd.length >= 6;
            const hasLower = /[a-z]/.test(newPwd);
            const hasUpper = /[A-Z]/.test(newPwd);
            const hasNum = /[0-9]/.test(newPwd);
            const hasSpecial = /[!@#$%^&*]/.test(newPwd);
            if (!hasLength || !hasLower || !hasUpper || !hasNum || !hasSpecial) {
                alert('Password must meet all requirements:\n- At least 6 characters\n- Lowercase, uppercase, number, and special character');
                return false;
            }
            if (newPwd !== confirm) {
                alert('New password and confirm password do not match');
                return false;
            }
            return true;
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
            ['currentPassword', 'newPassword', 'confirmPassword'].forEach(id => {
                document.getElementById(id).addEventListener('input', updateValidationSummary);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>