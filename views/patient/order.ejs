<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background: #f0f2f5; font-size: 14px; line-height: 1.6; }
        .navbar { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 10px 0; }
        .navbar-brand { font-size: 1.1rem; font-weight: 600; }
        .navbar-text { font-size: 0.85rem; }
        .btn-outline-light { border-color: rgba(255,255,255,0.5); color: white; }
        .btn-outline-light:hover { background: rgba(255,255,255,0.2); border-color: white; }
        .card { border-radius: 15px; box-shadow: 0 4px 6px rgba(0,0,0,0.08); border: none; transition: transform 0.2s; }
        .card:hover { transform: translateY(-2px); }
        .btn-primary { background: #667eea; border: none; }
        .btn-primary:hover { background: #5a67d8; }
        .btn-outline-secondary { color: #667eea; border-color: #667eea; }
        .btn-outline-secondary:hover { background: #667eea; color: white; }
        .form-label { font-weight: 600; color: #555; }
        .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25); }
        .alert { animation: slideDown 0.5s ease-out; }
        @keyframes slideDown { from { opacity:0; transform:translateY(-20px); } to { opacity:1; transform:translateY(0); } }

        /* Priority badges */
        .priority-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize; letter-spacing: 0.2px; display: inline-block; margin-top: 4px; }
        .priority-high { background: #dc3545; color: white; }
        .priority-medium { background: #ffc107; color: #856404; }
        .priority-low { background: #17a2b8; color: white; }

        /* Status badges */
        .status-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 500; display: inline-block; }
        .status-pending { background: #ffc107; color: #856404; }
        .status-in-transit { background: #17a2b8; color: white; }
        .status-delivered { background: #28a745; color: white; }
        .status-cancelled { background: #dc3545; color: white; }

        /* Chronic banner */
        .chronic-card { border-left: 4px solid #dc3545; background: #fff5f5; }
        .chronic-badge { background: #dc3545; color: white; }
        .refill-days { font-weight: 700; }
        .refill-days.due-soon { color: #dc3545; }
        .refill-days.normal { color: #ffc107; }

        /* Order card */
        .order-card { transition: all 0.3s; border-left: 4px solid #667eea; background: white; }
        .order-card:hover { transform: translateX(5px); box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .order-card.status-pending { border-left-color: #ffc107; }
        .order-card.status-in-transit { border-left-color: #17a2b8; }
        .order-card.status-delivered { border-left-color: #28a745; }
        .order-card.status-cancelled { border-left-color: #dc3545; }

        .order-list-container { max-height: 600px; overflow-y: auto; border-radius: 10px; }
        .order-list-container::-webkit-scrollbar { width: 6px; }
        .order-list-container::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
        .order-list-container::-webkit-scrollbar-thumb { background: #667eea; border-radius: 10px; }
        .order-list-container::-webkit-scrollbar-thumb:hover { background: #5a67d8; }

        /* ========== TABS ========== */
        .nav-tabs {
            border-bottom: 2px solid #e9ecef;
            gap: 4px;
        }
        .nav-tabs .nav-link {
            border: none;
            border-radius: 30px 30px 0 0;
            font-weight: 600;
            color: #6c757d;
            padding: 12px 24px;
            font-size: 0.9rem;
            transition: all 0.2s;
            background: transparent;
        }
        .nav-tabs .nav-link:hover {
            color: #667eea;
            background: #f8f9fa;
        }
        .nav-tabs .nav-link.active {
            color: #667eea;
            background: #ffffff;
            border-bottom: 3px solid #667eea;
        }
        .nav-tabs .nav-link i {
            margin-right: 6px;
        }
        .nav-tabs .nav-link .badge {
            font-size: 0.7rem;
            padding: 3px 8px;
            margin-left: 6px;
        }

        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .card .p-3 { padding: 12px !important; }
            .btn { font-size: 0.75rem; padding: 5px 12px; }
            .priority-badge { font-size: 0.65rem; padding: 2px 8px; }
            .status-badge { font-size: 0.7rem; padding: 3px 8px; }
            .order-card .row > div { text-align: left; margin-bottom: 4px; }
            .nav-tabs .nav-link { padding: 10px 14px; font-size: 0.8rem; }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
        }
    
        /* ========== MOBILE-FRIENDLY PATIENT NAVBAR ========== */
        .patient-welcome {
            color: rgba(255,255,255,0.92);
            font-size: 0.85rem;
            padding: 10px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            margin-bottom: 8px;
        }
        .patient-welcome i { margin-right: 4px; }
        .patient-nav .nav-link {
            color: rgba(255,255,255,0.9);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.15s;
            margin: 2px 0;
        }
        .patient-nav .nav-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .patient-nav .nav-link:hover,
        .patient-nav .nav-link.active { background: rgba(255,255,255,0.15); color: white; }
        .patient-logout .nav-link { color: #ffb3b3; }
        .patient-logout .nav-link:hover { background: rgba(220,53,69,0.25); color: white; }
        @media (min-width: 992px) {
            .patient-welcome {
                border-bottom: none;
                border-right: 1px solid rgba(255,255,255,0.2);
                margin-bottom: 0;
                margin-right: 8px;
                padding: 6px 14px 6px 0;
                display: flex;
                align-items: center;
                gap: 4px;
            }
            .patient-nav .nav-link { padding: 8px 12px; font-size: 0.85rem; }
            .patient-logout {
                margin-left: 8px;
                padding-left: 8px;
                border-left: 1px solid rgba(255,255,255,0.2);
            }
        }
        @media (max-width: 991.98px) {
            .navbar-collapse {
                background: rgba(255,255,255,0.08);
                border-radius: 12px;
                padding: 10px;
                margin-top: 10px;
            }
            .patient-welcome { color: white; }
            .patient-nav .nav-link { padding: 12px 14px; font-size: 0.95rem; min-height: 44px; }
            .patient-nav .nav-link i { font-size: 1.15rem; }
        }

    </style>
</head>
<body>

    <!-- ========== NAVBAR ========== -->
        <!-- ========== NAVBAR (mobile-friendly) ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/auth/patient-dashboard">
                <i class="bi bi-heart-pulse"></i> Patient Portal
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="patient-welcome">
                    <i class="bi bi-person-circle"></i>
                    Welcome, <strong><%= user.name %></strong>
                    <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                </div>

                <ul class="navbar-nav ms-auto align-items-lg-center patient-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/patient-dashboard">
                            <i class="bi bi-house-door"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/appointment">
                            <i class="bi bi-calendar-plus"></i> Book Appointment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/view-appointments">
                            <i class="bi bi-calendar-check"></i> My Appointments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/message">
                            <i class="bi bi-envelope"></i> Messages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/order">
                            <i class="bi bi-prescription"></i> Order
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/profile">
                            <i class="bi bi-person-badge"></i> Profile
                        </a>
                    </li>
                    <li class="nav-item patient-logout">
                        <a class="nav-link" href="/auth/logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <!-- Flash Messages -->
        <%- include('../partials/flash') %>

        <!-- ========== CHRONIC MEDICATION BANNER ========== -->
        <% if (patient && patient.isChronic) { %>
            <div class="alert alert-warning chronic-card d-flex flex-wrap align-items-center gap-2">
                <i class="bi bi-heart-pulse fs-4 text-danger"></i>
                <div class="flex-grow-1">
                    <strong>Chronic Patient</strong>
                    <span class="badge chronic-badge ms-1">Active</span>
                    <br>
                    <small><i class="bi bi-capsule"></i> <%= patient.medicationName || 'Medication not specified' %></small>
                    <% if (patient.nextRefillDate) { %>
                        <% const daysLeft = Math.ceil((patient.nextRefillDate - new Date()) / (1000 * 60 * 60 * 24)); %>
                        <br>
                        <small class="refill-days <%= daysLeft <= 7 ? 'due-soon' : 'normal' %>">
                            <i class="bi bi-hourglass"></i> Next refill in <%= daysLeft <= 0 ? 'NOW (overdue)' : daysLeft + ' days' %>
                        </small>
                        <br>
                        <small class="text-muted">Expected refill date: <%= new Date(patient.nextRefillDate).toLocaleDateString() %></small>
                    <% } else { %>
                        <br>
                        <small class="text-muted">No refill timer set.</small>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="alert alert-light border">
                <small><i class="bi bi-info-circle"></i> You are not marked as a chronic patient.</small>
            </div>
        <% } %>

        <!-- ========== TABS CARD ========== -->
        <div class="card p-3 p-md-4">
            <ul class="nav nav-tabs mb-4" id="orderTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="place-tab" data-bs-toggle="tab" data-bs-target="#place" type="button" role="tab" aria-controls="place" aria-selected="true">
                        <i class="bi bi-plus-circle"></i> Place Order
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab" aria-controls="orders" aria-selected="false">
                        <i class="bi bi-list-task"></i> All Orders
                        <% if (orders && orders.length > 0) { %>
                            <span class="badge bg-primary"><%= orders.length %></span>
                        <% } %>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="orderTabsContent">

                <!-- ========== TAB 1: PLACE ORDER ========== -->
                <div class="tab-pane fade show active" id="place" role="tabpanel" aria-labelledby="place-tab">
                    <h5 class="h6 mb-3"><i class="bi bi-prescription"></i> New Prescription Order</h5>

                    <form action="/patient/order/place" method="POST" id="orderForm" enctype="multipart/form-data">
                        <!-- Patient Name -->
                        <div class="mb-3">
                            <label for="patientName" class="form-label"><i class="bi bi-person"></i> Your Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="patientName" name="patientName" value="<%= user.name %>" readonly>
                        </div>
                        <!-- Email -->
                        <div class="mb-3">
                            <label for="patientEmail" class="form-label"><i class="bi bi-envelope"></i> Your Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="patientEmail" name="patientEmail" value="<%= user.email %>" readonly>
                        </div>
                        <!-- Phone -->
                        <div class="mb-3">
                            <label for="patientPhone" class="form-label"><i class="bi bi-telephone"></i> Your Phone Number <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="patientPhone" name="patientPhone" value="<%= patient.phone || '' %>" placeholder="Enter your phone number" required>
                        </div>
                        <!-- Prescription Name -->
                        <div class="mb-3">
                            <label for="prescriptionName" class="form-label"><i class="bi bi-capsule"></i> Prescription Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="prescriptionName" name="prescriptionName" placeholder="e.g. Amoxicillin 500mg" required>
                        </div>
                        <!-- Priority -->
                        <div class="mb-3">
                            <label for="priority" class="form-label"><i class="bi bi-flag"></i> Priority</label>
                            <select class="form-control" id="priority" name="priority">
                                <option value="medium" selected>Medium</option>
                                <option value="high">High</option>
                                <option value="low">Low</option>
                            </select>
                        </div>
                        <!-- Prescription Photo -->
                        <div class="mb-3">
                            <label for="prescriptionPhoto" class="form-label"><i class="bi bi-image"></i> Prescription Photo (Optional)</label>
                            <input type="file" class="form-control" id="prescriptionPhoto" name="prescriptionPhoto" accept="image/*">
                            <small class="text-muted">Upload a photo of your prescription (optional)</small>
                        </div>
                        <!-- Location -->
                        <div class="mb-3">
                            <label for="location" class="form-label"><i class="bi bi-geo-alt"></i> Delivery Location <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="location" name="location" placeholder="Enter your delivery address" required>
                                <button class="btn btn-outline-primary" type="button" onclick="getLocation()" title="Get Current Location">
                                    <i class="bi bi-crosshair"></i>
                                </button>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted" id="locationStatus"><i class="bi bi-info-circle"></i> Click the crosshair button to get your current location</small>
                            </div>
                            <input type="hidden" id="latitude" name="latitude" value="">
                            <input type="hidden" id="longitude" name="longitude" value="">
                        </div>
                        <!-- Notes -->
                        <div class="mb-3">
                            <label for="notes" class="form-label"><i class="bi bi-chat"></i> Additional Notes (Optional)</label>
                            <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Any additional information…" maxlength="500"></textarea>
                            <small class="text-muted" id="notesCount">0 / 500 characters</small>
                        </div>

                        <div class="d-flex flex-wrap gap-2 justify-content-end mt-3">
                            <a href="/auth/patient-dashboard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Cancel</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Place Order</button>
                        </div>
                    </form>
                </div>

                <!-- ========== TAB 2: ALL ORDERS ========== -->
                <div class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="h6 mb-0"><i class="bi bi-list-task"></i> Order History</h5>
                        <% if (orders && orders.length > 0) { %>
                            <span class="badge bg-secondary"><%= orders.length %> order<%= orders.length > 1 ? 's' : '' %></span>
                        <% } %>
                    </div>

                    <% if (orders && orders.length > 0) { %>
                        <div class="order-list-container">
                            <% orders.forEach(function(order) { %>
                                <div class="order-card card p-3 mb-2 status-<%= order.status %>" data-status="<%= order.status %>">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-12 col-md-3">
                                            <div class="fw-bold"><i class="bi bi-capsule"></i> <%= order.prescriptionName %></div>
                                            <small class="text-muted"><i class="bi bi-calendar"></i> <%= new Date(order.orderDate).toLocaleDateString() %></small>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <span class="status-badge status-<%= order.status %>">
                                                <i class="bi bi-<%= order.status === 'pending' ? 'clock' : order.status === 'in-transit' ? 'truck' : order.status === 'delivered' ? 'check-circle' : 'x-circle' %>"></i>
                                                <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                                            </span>
                                            <br>
                                            <span class="priority-badge priority-<%= order.priority || 'medium' %>">
                                                <i class="bi bi-flag"></i> <%= (order.priority || 'medium').charAt(0).toUpperCase() + (order.priority || 'medium').slice(1) %>
                                            </span>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <small class="text-muted"><i class="bi bi-geo-alt"></i> <%= order.location.substring(0, 25) %><%= order.location.length > 25 ? '…' : '' %></small>
                                            <br>
                                            <small class="text-muted"><i class="bi bi-telephone"></i> <%= order.patientPhone %></small>
                                        </div>
                                        <div class="col-12 col-md-3 text-md-end">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-primary" onclick="viewOrder('<%= order._id %>')" title="View"><i class="bi bi-eye"></i></button>
                                                <% if (order.status === 'pending' || order.status === 'in-transit') { %>
                                                    <button class="btn btn-outline-danger" onclick="cancelOrder('<%= order._id %>')" title="Cancel"><i class="bi bi-x-lg"></i></button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state text-center py-5">
                            <i class="bi bi-prescription" style="font-size:3rem; color:#dee2e6;"></i>
                            <h4 class="mt-3">No Orders Found</h4>
                            <p class="text-muted">You haven't placed any orders yet.</p>
                            <button class="btn btn-primary" onclick="switchToPlaceTab()">
                                <i class="bi bi-plus-circle"></i> Place Your First Order
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </div>

    <script>
        // Character counter for notes
        const notesEl = document.getElementById('notes');
        if (notesEl) {
            notesEl.addEventListener('input', function() {
                const count = this.value.length;
                const el = document.getElementById('notesCount');
                el.textContent = count + ' / 500 characters';
                el.style.color = count > 400 ? '#dc3545' : count > 300 ? '#ffc107' : '#6c757d';
            });
        }

        // Get current location
        function getLocation() {
            const statusEl = document.getElementById('locationStatus');
            statusEl.innerHTML = '<i class="bi bi-spinner bi-spin"></i> Getting your location...';
            statusEl.style.color = '#17a2b8';

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        document.getElementById('latitude').value = lat;
                        document.getElementById('longitude').value = lng;

                        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                            .then(response => response.json())
                            .then(data => {
                                const address = data.display_name || 'Location found';
                                document.getElementById('location').value = address;
                                statusEl.innerHTML = '<i class="bi bi-check-circle text-success"></i> Location captured successfully!';
                                statusEl.style.color = '#28a745';
                            })
                            .catch(() => {
                                document.getElementById('location').value = `Lat: ${lat}, Lng: ${lng}`;
                                statusEl.innerHTML = '<i class="bi bi-check-circle text-success"></i> Location captured (coordinates)';
                                statusEl.style.color = '#28a745';
                            });
                    },
                    function(error) {
                        let errorMsg = 'Unable to get location. ';
                        switch(error.code) {
                            case error.PERMISSION_DENIED: errorMsg += 'Please allow location access.';
                                break;
                            case error.POSITION_UNAVAILABLE: errorMsg += 'Location information is unavailable.';
                                break;
                            case error.TIMEOUT: errorMsg += 'The request timed out.';
                                break;
                            default: errorMsg += 'Please enter your address manually.';
                        }
                        statusEl.innerHTML = `<i class="bi bi-exclamation-triangle text-danger"></i> ${errorMsg}`;
                        statusEl.style.color = '#dc3545';
                    },
                    { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
                );
            } else {
                statusEl.innerHTML = '<i class="bi bi-exclamation-triangle text-danger"></i> Geolocation is not supported. Please enter address manually.';
                statusEl.style.color = '#dc3545';
            }
        }

        // View order details
        function viewOrder(id) {
            window.location.href = `/patient/order/${id}`;
        }

        // Cancel order
        function cancelOrder(id) {
            if (confirm('Are you sure you want to cancel this order?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/patient/order/cancel/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Switch to Place Order tab
        function switchToPlaceTab() {
            const tab = new bootstrap.Tab(document.getElementById('place-tab'));
            tab.show();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Form validation
        const orderForm = document.getElementById('orderForm');
        if (orderForm) {
            orderForm.addEventListener('submit', function(e) {
                const phone = document.getElementById('patientPhone').value;
                const prescription = document.getElementById('prescriptionName').value.trim();
                const location = document.getElementById('location').value.trim();
                if (!phone.match(/^[0-9+\-\s()]{10,15}$/)) { e.preventDefault(); alert('Please enter a valid phone number'); return; }
                if (prescription.length < 3) { e.preventDefault(); alert('Prescription name must be at least 3 characters'); return; }
                if (location.length < 5) { e.preventDefault(); alert('Please enter a valid delivery location'); return; }
            });
        }

        // Auto-dismiss flash messages ONLY, NOT the chronic card
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert:not(.chronic-card):not(.alert-light)').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Socket.IO real-time order updates -->
    <script src="https://cdn.jsdelivr.net/npm/socket.io-client@4.7.2/dist/socket.io.min.js"></script>
    <script>
        const socket = io();

        socket.on('connect', () => {
            console.log('✅ Patient order socket connected');
        });

        socket.on('data-updated', (data) => {
            if (data.type === 'order') {
                console.log('📦 Order updated, reloading page...');
                window.location.reload();
            }
        });
    </script>

</body>
</html>