<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-2px);
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-secondary {
            color: #667eea;
            border-color: #667eea;
        }
        .btn-outline-secondary:hover {
            background: #667eea;
            color: white;
        }
        .btn-danger {
            background: #dc3545;
            border: none;
        }
        .btn-danger:hover {
            background: #c82333;
        }
        .alert {
            animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }

        /* ========== STATUS BADGE ========== */
        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-block;
        }
        .status-pending { background: #ffc107; color: #856404; }
        .status-in-transit { background: #17a2b8; color: white; }
        .status-delivered { background: #28a745; color: white; }
        .status-cancelled { background: #dc3545; color: white; }

        /* ========== INFO ROWS ========== */
        .info-row {
            display: flex;
            padding: 10px 0;
            border-bottom: 1px solid #eee;
            flex-wrap: wrap;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: 600;
            color: #555;
            min-width: 140px;
            width: 30%;
        }
        .info-value {
            flex: 1;
            word-break: break-word;
        }

        /* ========== PRESCRIPTION IMAGE ========== */
        .prescription-image {
            max-width: 100%;
            max-height: 400px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .prescription-image-container {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }

        /* ========== LOCATION LINK ========== */
        .location-link {
            color: #667eea;
            text-decoration: none;
        }
        .location-link:hover {
            text-decoration: underline;
        }

        /* ========== TIMELINE ========== */
        .order-timeline {
            position: relative;
            padding-left: 30px;
        }
        .order-timeline::before {
            content: '';
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }
        .timeline-item {
            position: relative;
            padding-bottom: 20px;
        }
        .timeline-item:last-child {
            padding-bottom: 0;
        }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -24px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #667eea;
            border: 2px solid white;
            box-shadow: 0 0 0 2px #667eea;
        }
        .timeline-item.active::before {
            background: #28a745;
            box-shadow: 0 0 0 2px #28a745;
        }
        .timeline-item.completed::before {
            background: #28a745;
            box-shadow: 0 0 0 2px #28a745;
        }
        .timeline-item.cancelled::before {
            background: #dc3545;
            box-shadow: 0 0 0 2px #dc3545;
        }
        .timeline-item .timeline-content {
            background: #f8f9fa;
            padding: 10px 15px;
            border-radius: 8px;
        }
        .timeline-item .timeline-content .timeline-title {
            font-weight: 600;
            margin-bottom: 2px;
        }
        .timeline-item .timeline-content .timeline-date {
            font-size: 0.85rem;
            color: #6c757d;
        }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card { border-radius: 10px; }
            .card .p-4 { padding: 16px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .btn-sm { font-size: 0.65rem; padding: 4px 8px; }
            .status-badge { font-size: 0.75rem; padding: 4px 12px; }
            .info-row { flex-direction: column; align-items: flex-start; }
            .info-label { width: 100%; margin-bottom: 2px; }
            .info-value { width: 100%; }
            .order-timeline { padding-left: 20px; }
            .timeline-item::before { left: -18px; width: 10px; height: 10px; }
            .d-grid .btn { width: 100%; margin-bottom: 6px; }
            .d-md-flex { flex-direction: column; gap: 8px; }
            .d-md-flex .btn-outline-secondary { margin-right: 0 !important; }
            .prescription-image { max-height: 250px; }
            .prescription-image-container { padding: 12px; }
            h4 { font-size: 1.2rem; }
            h6 { font-size: 1rem; }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .container { padding-left: 20px; padding-right: 20px; }
            .card .p-4 { padding: 24px !important; }
            .btn { font-size: 0.8rem; padding: 6px 14px; }
            .info-label { min-width: 120px; }
        }

        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-4 { padding: 32px !important; }
            .btn { font-size: 0.85rem; padding: 8px 20px; }
            .info-label { min-width: 150px; }
        }
    
        /* ========== MOBILE-FRIENDLY PATIENT NAVBAR ========== */
        .patient-welcome {
            color: rgba(255,255,255,0.92);
            font-size: 0.85rem;
            padding: 10px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            margin-bottom: 8px;
        }
        .patient-welcome i { margin-right: 4px; }
        .patient-nav .nav-link {
            color: rgba(255,255,255,0.9);
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.15s;
            margin: 2px 0;
        }
        .patient-nav .nav-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .patient-nav .nav-link:hover,
        .patient-nav .nav-link.active { background: rgba(255,255,255,0.15); color: white; }
        .patient-logout .nav-link { color: #ffb3b3; }
        .patient-logout .nav-link:hover { background: rgba(220,53,69,0.25); color: white; }
        @media (min-width: 992px) {
            .patient-welcome {
                border-bottom: none;
                border-right: 1px solid rgba(255,255,255,0.2);
                margin-bottom: 0;
                margin-right: 8px;
                padding: 6px 14px 6px 0;
                display: flex;
                align-items: center;
                gap: 4px;
            }
            .patient-nav .nav-link { padding: 8px 12px; font-size: 0.85rem; }
            .patient-logout {
                margin-left: 8px;
                padding-left: 8px;
                border-left: 1px solid rgba(255,255,255,0.2);
            }
        }
        @media (max-width: 991.98px) {
            .navbar-collapse {
                background: rgba(255,255,255,0.08);
                border-radius: 12px;
                padding: 10px;
                margin-top: 10px;
            }
            .patient-welcome { color: white; }
            .patient-nav .nav-link { padding: 12px 14px; font-size: 0.95rem; min-height: 44px; }
            .patient-nav .nav-link i { font-size: 1.15rem; }
        }

    </style>
</head>
<body>

    <!-- ========== NAVBAR with responsive toggler ========== -->
        <!-- ========== NAVBAR (mobile-friendly) ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/auth/patient-dashboard">
                <i class="bi bi-heart-pulse"></i> Patient Portal
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="patient-welcome">
                    <i class="bi bi-person-circle"></i>
                    Welcome, <strong><%= user.name %></strong>
                    <span class="badge bg-light text-dark ms-1"><%= user.role %></span>
                </div>

                <ul class="navbar-nav ms-auto align-items-lg-center patient-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/patient-dashboard">
                            <i class="bi bi-house-door"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/appointment">
                            <i class="bi bi-calendar-plus"></i> Book Appointment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/view-appointments">
                            <i class="bi bi-calendar-check"></i> My Appointments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/message">
                            <i class="bi bi-envelope"></i> Messages
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/order">
                            <i class="bi bi-prescription"></i> Order
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/patient/profile">
                            <i class="bi bi-person-badge"></i> Profile
                        </a>
                    </li>
                    <li class="nav-item patient-logout">
                        <a class="nav-link" href="/auth/logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card p-3 p-md-4">
                    <!-- Header: Order ID + Status -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <h4 class="mb-0"><i class="bi bi-prescription"></i> Order Details</h4>
                        <span class="status-badge status-<%= order.status %>">
                            <i class="bi bi-<%= order.status === 'pending' ? 'clock' : order.status === 'in-transit' ? 'truck' : order.status === 'delivered' ? 'check-circle' : 'x-circle' %>"></i>
                            <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </span>
                    </div>
                    <hr>

                    <!-- Order info -->
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="info-row"><span class="info-label"><i class="bi bi-hash"></i> Order ID</span><span class="info-value"><%= order._id.toString().substring(0, 8).toUpperCase() %></span></div>
                            <div class="info-row"><span class="info-label"><i class="bi bi-calendar"></i> Order Date</span><span class="info-value"><%= new Date(order.orderDate).toLocaleString() %></span></div>
                            <div class="info-row"><span class="info-label"><i class="bi bi-calendar-check"></i> Last Updated</span><span class="info-value"><%= new Date(order.updatedAt).toLocaleString() %></span></div>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-row"><span class="info-label"><i class="bi bi-person-badge"></i> Patient</span><span class="info-value"><%= order.patientName %></span></div>
                            <div class="info-row"><span class="info-label"><i class="bi bi-envelope"></i> Email</span><span class="info-value"><%= order.patientEmail %></span></div>
                            <div class="info-row"><span class="info-label"><i class="bi bi-telephone"></i> Phone</span><span class="info-value"><%= order.patientPhone %></span></div>
                        </div>
                    </div>

                    <!-- Prescription -->
                    <h6 class="mt-3"><i class="bi bi-capsule"></i> Prescription Information</h6>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="info-row"><span class="info-label"><i class="bi bi-prescription"></i> Medication</span><span class="info-value"><%= order.prescriptionName %></span></div>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-row">
                                <span class="info-label"><i class="bi bi-image"></i> Prescription</span>
                                <span class="info-value">
                                    <% if (order.prescriptionPhoto) { %>
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewPrescription('<%= order.prescriptionPhoto %>')">
                                            <i class="bi bi-eye"></i> View
                                        </button>
                                    <% } else { %>
                                        <span class="text-muted">No photo uploaded</span>
                                    <% } %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- Prescription image container (hidden) -->
                    <div class="prescription-image-container mt-2" id="prescriptionContainer" style="display:none;">
                        <img src="<%= order.prescriptionPhoto %>" alt="Prescription" class="prescription-image" id="prescriptionImage">
                        <div class="mt-2 d-flex flex-wrap justify-content-center gap-2">
                            <button class="btn btn-sm btn-secondary" onclick="closePrescription()"><i class="bi bi-x-circle"></i> Close</button>
                            <a href="<%= order.prescriptionPhoto %>" download class="btn btn-sm btn-success"><i class="bi bi-download"></i> Download</a>
                        </div>
                    </div>

                    <!-- Delivery -->
                    <h6 class="mt-3"><i class="bi bi-geo-alt"></i> Delivery Information</h6>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="info-row">
                                <span class="info-label"><i class="bi bi-geo-alt"></i> Location</span>
                                <span class="info-value">
                                    <% if (order.latitude && order.longitude) { %>
                                        <a href="https://www.google.com/maps?q=<%= order.latitude %>,<%= order.longitude %>" target="_blank" class="location-link">
                                            <i class="bi bi-map"></i> <%= order.location %>
                                        </a>
                                    <% } else { %>
                                        <%= order.location %>
                                    <% } %>
                                </span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <% if (order.latitude && order.longitude) { %>
                                <div class="info-row">
                                    <span class="info-label"><i class="bi bi-pin-map"></i> Coordinates</span>
                                    <span class="info-value">
                                        <a href="https://www.google.com/maps?q=<%= order.latitude %>,<%= order.longitude %>" target="_blank" class="location-link">
                                            <%= order.latitude %>, <%= order.longitude %>
                                        </a>
                                    </span>
                                </div>
                            <% } %>
                        </div>
                        <% if (order.deliveryDate) { %>
                            <div class="col-sm-6">
                                <div class="info-row">
                                    <span class="info-label"><i class="bi bi-truck"></i> Delivered On</span>
                                    <span class="info-value"><%= new Date(order.deliveryDate).toLocaleString() %></span>
                                </div>
                            </div>
                        <% } %>
                        <% if (order.notes) { %>
                            <div class="col-sm-12">
                                <div class="info-row">
                                    <span class="info-label"><i class="bi bi-chat"></i> Notes</span>
                                    <span class="info-value"><%= order.notes %></span>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Timeline -->
                    <h6 class="mt-3"><i class="bi bi-clock-history"></i> Order Timeline</h6>
                    <div class="order-timeline">
                        <div class="timeline-item completed">
                            <div class="timeline-content">
                                <div class="timeline-title"><i class="bi bi-check-circle text-success"></i> Order Placed</div>
                                <div class="timeline-date"><%= new Date(order.createdAt).toLocaleString() %></div>
                            </div>
                        </div>
                        <% if (order.status === 'pending' || order.status === 'in-transit' || order.status === 'delivered') { %>
                            <div class="timeline-item <%= order.status === 'pending' ? 'active' : 'completed' %>">
                                <div class="timeline-content">
                                    <div class="timeline-title">
                                        <i class="bi <%= order.status === 'pending' ? 'bi-clock text-warning' : 'bi-check-circle text-success' %>"></i>
                                        <%= order.status === 'pending' ? 'Order Confirmed' : 'Confirmed' %>
                                    </div>
                                    <div class="timeline-date"><%= new Date(order.createdAt).toLocaleString() %></div>
                                </div>
                            </div>
                        <% } %>
                        <% if (order.status === 'in-transit' || order.status === 'delivered') { %>
                            <div class="timeline-item <%= order.status === 'in-transit' ? 'active' : 'completed' %>">
                                <div class="timeline-content">
                                    <div class="timeline-title">
                                        <i class="bi <%= order.status === 'in-transit' ? 'bi-truck text-info' : 'bi-check-circle text-success' %>"></i>
                                        <%= order.status === 'in-transit' ? 'In Transit' : 'Transit' %>
                                    </div>
                                    <div class="timeline-date"><%= order.status === 'in-transit' ? 'Currently in transit' : new Date(order.updatedAt).toLocaleString() %></div>
                                </div>
                            </div>
                        <% } %>
                        <% if (order.status === 'delivered') { %>
                            <div class="timeline-item completed">
                                <div class="timeline-content">
                                    <div class="timeline-title"><i class="bi bi-check-circle text-success"></i> Delivered</div>
                                    <div class="timeline-date"><%= order.deliveryDate ? new Date(order.deliveryDate).toLocaleString() : new Date(order.updatedAt).toLocaleString() %></div>
                                </div>
                            </div>
                        <% } %>
                        <% if (order.status === 'cancelled') { %>
                            <div class="timeline-item cancelled">
                                <div class="timeline-content">
                                    <div class="timeline-title"><i class="bi bi-x-circle text-danger"></i> Cancelled</div>
                                    <div class="timeline-date"><%= new Date(order.updatedAt).toLocaleString() %></div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                        <a href="/patient/order" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Orders</a>
                        <% if (order.status === 'pending' || order.status === 'in-transit') { %>
                            <button class="btn btn-danger" onclick="cancelOrder('<%= order._id %>')">
                                <i class="bi bi-x-lg"></i> Cancel Order
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // View prescription image
        function viewPrescription(imageUrl) {
            const container = document.getElementById('prescriptionContainer');
            const img = document.getElementById('prescriptionImage');
            if (container.style.display === 'none') {
                container.style.display = 'block';
                container.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                container.style.display = 'none';
            }
        }
        function closePrescription() {
            document.getElementById('prescriptionContainer').style.display = 'none';
        }

        // Cancel order
        function cancelOrder(id) {
            if (confirm('Are you sure you want to cancel this order? This action cannot be undone.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/patient/order/cancel/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Auto-dismiss flash messages
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>