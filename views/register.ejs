<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Palm Valley Medical Center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/jpeg" href="/images/palmvalley-logo.jpg">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px 0;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        .card {
            border-radius: 24px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.35);
            border: none;
            overflow: hidden;
        }
        .card-body { padding: 0; }

        /* ========== FULL-WIDTH LOGO BANNER ========== */
        .logo-banner {
            width: 100%;
            background: #ffffff;
            border-bottom: 1px solid #edf2f7;
            overflow: hidden;
            line-height: 0;
        }
        .logo-banner img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        /* ========== FORM AREA ========== */
        .form-area { padding: 36px 40px 32px; }

        /* ========== HEADING ========== */
        .page-title {
            text-align: center;
            color: #1a202c;
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .page-subtitle {
            text-align: center;
            color: #4a5568;
            font-size: 0.85rem;
            letter-spacing: 0.2px;
            margin-bottom: 24px;
        }

        /* ========== FORM ========== */
        .form-label {
            font-weight: 600;
            color: #4a5568;
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
        }
        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.6rem 0.9rem;
            font-size: 0.95rem;
            background: #f7fafc;
            transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
            background: #fff;
        }
        .form-text {
            font-size: 0.75rem;
            color: #718096;
            margin-top: 0.25rem;
            display: block;
        }

        /* ========== PASSWORD TOGGLE ========== */
        .input-group > .form-control {
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }
        .input-group > .btn-toggle-pw {
            border: 1.5px solid #e2e8f0;
            border-left: none;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
            background: #f7fafc;
            color: #4a5568;
            padding: 0 0.85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s, background 0.15s;
            min-width: 46px;
        }
        .input-group > .btn-toggle-pw:hover,
        .input-group > .btn-toggle-pw:focus {
            background: #edf2f7;
            color: #1a4d5c;
            outline: none;
            box-shadow: none;
        }
        .input-group > .btn-toggle-pw i { font-size: 1.05rem; }
        .input-group:focus-within > .btn-toggle-pw { border-color: #667eea; }

        /* ========== PASSWORD REQUIREMENTS ========== */
        .pw-reqs {
            font-size: 0.75rem;
            color: #718096;
            margin-top: 0.35rem;
            line-height: 1.6;
        }
        .pw-reqs .req {
            display: inline-block;
            margin-right: 12px;
            transition: color 0.15s;
        }
        .pw-reqs .req i {
            font-size: 0.7rem;
            margin-right: 3px;
        }
        .pw-reqs .req.valid { color: #28a745; }
        .pw-reqs .req.invalid { color: #a0aec0; }

        /* ========== BUTTON ========== */
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.65rem 1rem;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(102,126,234,0.35);
            transition: transform 0.15s, box-shadow 0.2s;
        }
        .btn-primary:hover,
        .btn-primary:focus {
            background: linear-gradient(135deg, #5a67d8 0%, #6b3fa0 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(102,126,234,0.45);
        }

        /* ========== LINKS ========== */
        .link-row {
            text-align: center;
            margin-top: 14px;
            font-size: 0.85rem;
            color: #4a5568;
        }
        .link-row a {
            color: #1a4d5c;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.15s;
        }
        .link-row a:hover {
            color: #0e9f6e;
            text-decoration: underline;
        }

        /* ========== FOOTER ========== */
        .pv-footer {
            text-align: center;
            color: rgba(255,255,255,0.85);
            margin-top: 18px;
            font-size: 0.78rem;
        }
        .pv-footer i { color: #ffd166; margin-right: 4px; }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 575.98px) {
            body { padding: 10px 0; }
            .card { border-radius: 18px; margin: 0 10px; }
            .form-area { padding: 24px 20px 22px; }
            .page-title { font-size: 1.05rem; }
            .page-subtitle { font-size: 0.78rem; margin-bottom: 18px; }
            .form-control { font-size: 0.95rem; padding: 0.55rem 0.8rem; }
            .link-row { font-size: 0.8rem; }
            .pw-reqs { font-size: 0.7rem; }
            .pw-reqs .req { display: block; margin-right: 0; }
            .input-group > .btn-toggle-pw { min-width: 42px; padding: 0 0.7rem; }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .form-area { padding: 32px 32px 28px; }
        }
        @media (min-width: 992px) {
            .form-area { padding: 40px 44px 36px; }
        }
        @media (prefers-reduced-motion: reduce) {
            * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card">

                    <!-- ===================== FULL-WIDTH LOGO BANNER ===================== -->
                    <div class="logo-banner">
                        <img src="/images/palmvalley-logo.jpg"
                             alt="Palm Valley Medical Center">
                    </div>

                    <!-- ===================== FORM AREA ===================== -->
                    <div class="form-area">

                        <p class="page-title">
                            <i class="bi bi-person-plus"></i> Register
                        </p>
                        <p class="page-subtitle">Create your account</p>

                        <%- include('./partials/flash') %>

                        <form action="/auth/register" method="POST">

                            <div class="mb-3">
                                <label for="name" class="form-label">
                                    <i class="bi bi-person"></i> Full Name
                                </label>
                                <input type="text"
                                       class="form-control"
                                       id="name"
                                       name="name"
                                       placeholder="Name"
                                       autocomplete="name"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">
                                    <i class="bi bi-envelope"></i> Email
                                </label>
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="email"
                                       placeholder="you@example.com"
                                       autocomplete="email"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">
                                    <i class="bi bi-lock"></i> Password
                                </label>
                                <div class="input-group">
                                    <input type="password"
                                           class="form-control"
                                           id="password"
                                           name="password"
                                           placeholder="Create a strong password"
                                           autocomplete="new-password"
                                           onkeyup="checkPassword(this.value)"
                                           required minlength="6">
                                    <button type="button"
                                            class="btn btn-toggle-pw"
                                            data-toggle-password="password"
                                            aria-label="Show password"
                                            aria-pressed="false"
                                            title="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>

                                <!-- Live password requirement indicators -->
                                <div class="pw-reqs">
                                    <span class="req invalid" id="reqLen">
                                        <i class="bi bi-circle"></i> 6+ chars
                                    </span>
                                    <span class="req invalid" id="reqLower">
                                        <i class="bi bi-circle"></i> lowercase
                                    </span>
                                    <span class="req invalid" id="reqUpper">
                                        <i class="bi bi-circle"></i> uppercase
                                    </span>
                                    <span class="req invalid" id="reqNum">
                                        <i class="bi bi-circle"></i> number
                                    </span>
                                    <span class="req invalid" id="reqSpec">
                                        <i class="bi bi-circle"></i> !@#$%^&amp;*
                                    </span>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-person-plus"></i> Create Account
                                </button>
                            </div>
                        </form>

                        <div class="link-row">
                            Already have an account?
                            <a href="/auth/login">Login here</a>
                        </div>
                        <div class="link-row">
                            Already registered but not verified?
                            <a href="/auth/resend-verification">Resend verification</a>
                        </div>

                    </div><!-- /.form-area -->

                </div>

                <p class="pv-footer">
                    <i class="bi bi-heart-pulse"></i>
                    &copy; <%= new Date().getFullYear() %> Palm Valley Medical Center &mdash; All rights reserved
                </p>

            </div>
        </div>
    </div>

    <!-- ===================== LIVE PASSWORD CHECKER ===================== -->
    <script>
        function checkPassword(pw) {
            var rules = [
                { id: 'reqLen',   ok: pw.length >= 6 },
                { id: 'reqLower', ok: /[a-z]/.test(pw) },
                { id: 'reqUpper', ok: /[A-Z]/.test(pw) },
                { id: 'reqNum',   ok: /[0-9]/.test(pw) },
                { id: 'reqSpec',  ok: /[!@#$%^&*]/.test(pw) }
            ];
            rules.forEach(function (r) {
                var el = document.getElementById(r.id);
                if (!el) return;
                el.className = 'req ' + (r.ok ? 'valid' : 'invalid');
                var icon = el.querySelector('i');
                if (icon) {
                    icon.className = r.ok ? 'bi bi-check-circle-fill' : 'bi bi-circle';
                }
            });
        }
    </script>

    <!-- ===================== PASSWORD TOGGLE (generic) ===================== -->
    <script>
        (function () {
            document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-toggle-password'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    var icon = btn.querySelector('i');
                    if (icon) icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                    btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    btn.setAttribute('title', show ? 'Hide password' : 'Show password');
                    input.focus();
                });
            });
        })();
    </script>
</body>
</html>