<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* ========== GLOBAL ========== */
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px 0;
        }
        .card {
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        a {
            color: #667eea;
            text-decoration: none;
        }
        a:hover {
            color: #5a67d8;
            text-decoration: underline;
        }

        /* ========== RESPONSIVE TWEAKS ========== */
        @media (max-width: 575.98px) {
            body {
                padding: 10px 0;
            }
            .card {
                border-radius: 15px;
                margin: 0 10px;
            }
            .card .p-5 {
                padding: 24px !important;
            }
            h2 {
                font-size: 1.6rem;
            }
            .form-label {
                font-size: 0.9rem;
            }
            .form-control {
                font-size: 1rem;
                padding: 10px 12px;
            }
            .btn {
                font-size: 1rem;
                padding: 12px;
            }
            .alert {
                font-size: 0.9rem;
                padding: 10px 12px;
            }
            .mt-3.text-center small,
            .mt-2.text-center small {
                font-size: 0.85rem;
            }
            .mt-3, .mt-2 {
                margin-top: 0.75rem !important;
            }
            small.text-muted {
                font-size: 0.8rem;
            }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .card .p-5 {
                padding: 40px !important;
            }
            h2 {
                font-size: 2rem;
            }
            .btn {
                font-size: 1rem;
                padding: 10px;
            }
            .form-control {
                font-size: 1rem;
            }
        }

        @media (min-width: 992px) {
            .card .p-5 {
                padding: 48px !important;
            }
            h2 {
                font-size: 2.2rem;
            }
            .btn {
                font-size: 1.1rem;
                padding: 12px 24px;
            }
            .form-control {
                font-size: 1.05rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card p-5">
                    <h2 class="text-center mb-4">📝 Register</h2>

                    <%- include('./partials/flash') %>


                    <form action="/auth/register" method="POST">
                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Password</label>
                            <input type="password" class="form-control" id="password" name="password" required minlength="6">
                            <small class="text-muted">Must be at least 6 characters</small>
                        </div>
                        
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Register</button>
                        </div>
                    </form>

                    <div class="mt-3 text-center">
                        <small>Already have an account? <a href="/auth/login">Login here</a></small>
                    </div>
                    <div class="mt-2 text-center">
                        <small>Already registered but not verified? <a href="/auth/resend-verification">Resend verification</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>