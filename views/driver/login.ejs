<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Palm Valley Medical Center</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/jpeg" href="/images/palmvalley-logo.jpg">
    <style>
        /* ========== DRIVER THEME — TEAL ========== */
        body {
            background: linear-gradient(135deg, #0e9f6e 0%, #1a4d5c 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 20px 0;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        .card {
            border-radius: 24px;
            box-shadow: 0 25px 70px rgba(0,0,0,0.35);
            border: none;
            overflow: hidden;
        }
        .card-body { padding: 0; }

        .logo-banner {
            width: 100%;
            background: #ffffff;
            border-bottom: 1px solid #edf2f7;
            overflow: hidden;
            line-height: 0;
        }
        .logo-banner img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        .form-area { padding: 36px 40px 32px; }

        .page-title {
            text-align: center;
            color: #1a202c;
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .page-subtitle {
            text-align: center;
            color: #4a5568;
            font-size: 0.85rem;
            margin-bottom: 24px;
        }

        .driver-badge {
            display: block;
            width: fit-content;
            margin: 0 auto 18px;
            padding: 4px 14px;
            background: #e6fffa;
            color: #0e9f6e;
            border: 1px solid #b2f5ea;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .form-label {
            font-weight: 600;
            color: #4a5568;
            font-size: 0.85rem;
            margin-bottom: 0.25rem;
        }
        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            padding: 0.6rem 0.9rem;
            font-size: 0.95rem;
            background: #f7fafc;
            transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
        }
        .form-control:focus {
            border-color: #0e9f6e;
            box-shadow: 0 0 0 3px rgba(14,159,110,0.15);
            background: #fff;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0e9f6e 0%, #1a4d5c 100%);
            border: none;
            font-weight: 600;
            letter-spacing: 0.3px;
            padding: 0.65rem 1rem;
            border-radius: 10px;
            box-shadow: 0 6px 18px rgba(14,159,110,0.35);
            transition: transform 0.15s, box-shadow 0.2s;
        }
        .btn-primary:hover,
        .btn-primary:focus {
            background: linear-gradient(135deg, #057a55 0%, #0d3340 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(14,159,110,0.45);
        }

        .info-note {
            text-align: center;
            margin-top: 18px;
            padding: 12px 14px;
            background: #f0fdf4;
            border-left: 3px solid #0e9f6e;
            border-radius: 8px;
            font-size: 0.8rem;
            color: #22543d;
        }
        .info-note i {
            color: #0e9f6e;
            margin-right: 4px;
        }

        .pv-footer {
            text-align: center;
            color: rgba(255,255,255,0.9);
            margin-top: 18px;
            font-size: 0.78rem;
        }
        .pv-footer i { color: #ffd166; margin-right: 4px; }

        @media (max-width: 575.98px) {
            body { padding: 10px 0; }
            .card { border-radius: 18px; margin: 0 10px; }
            .form-area { padding: 24px 20px 22px; }
            .page-title { font-size: 1.05rem; }
            .page-subtitle { font-size: 0.78rem; margin-bottom: 18px; }
            .form-control { font-size: 0.95rem; padding: 0.55rem 0.8rem; }
            .info-note { font-size: 0.75rem; padding: 10px; }
        }
        @media (min-width: 576px) and (max-width: 991.98px) {
            .form-area { padding: 32px 32px 28px; }
        }
        @media (min-width: 992px) {
            .form-area { padding: 40px 44px 36px; }
        }
        @media (prefers-reduced-motion: reduce) {
            * { transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card">

                    <div class="logo-banner">
                        <img src="/images/palmvalley-logo.jpg"
                             alt="Palm Valley Medical Center">
                    </div>

                    <div class="form-area">

                        <span class="driver-badge">
                            <i class="bi bi-truck"></i> Driver Portal
                        </span>

                        <p class="page-title">
                            <i class="bi bi-box-arrow-in-right"></i> Driver Login
                        </p>
                        <p class="page-subtitle">
                            Sign in to manage your deliveries
                        </p>

                        <%- include('../partials/flash') %>

                        <form action="/driver/login" method="POST">

                            <div class="mb-3">
                                <label for="email" class="form-label">
                                    <i class="bi bi-envelope"></i> Email
                                </label>
                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       name="email"
                                       placeholder="driver@example.com"
                                       autocomplete="email"
                                       required>
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">
                                    <i class="bi bi-lock"></i> Password
                                </label>
                                <input type="password"
                                       class="form-control"
                                       id="password"
                                       name="password"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </button>
                            </div>
                        </form>

                        <div class="info-note">
                            <i class="bi bi-info-circle"></i>
                            Contact your administrator if you have trouble logging in
                        </div>

                    </div><!-- /.form-area -->

                </div>

                <p class="pv-footer">
                    <i class="bi bi-truck"></i>
                    &copy; <%= new Date().getFullYear() %> Palm Valley Medical Center &mdash; Driver Portal
                </p>

            </div>
        </div>
    </div>
</body>
</html>