<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.6;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-3px);
        }
        .btn {
            border-radius: 25px;
            font-weight: 500;
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #667eea;
        }
        .alert {
            animation: slideDown 0.5s ease-out;
        }
        @keyframes slideDown {
            from { opacity:0; transform:translateY(-20px); }
            to { opacity:1; transform:translateY(0); }
        }
        @media (max-width: 575.98px) {
            body { font-size: 13px; }
            .container { padding-left: 12px; padding-right: 12px; }
            .navbar-brand { font-size: 0.95rem; }
            .navbar-text { font-size: 0.75rem; }
            .card .p-3 { padding: 12px !important; }
            .btn { font-size: 0.75rem; padding: 6px 12px; }
            .stat-number { font-size: 1.6rem; }
        }
        @media (min-width: 992px) {
            .container { padding-left: 40px; padding-right: 40px; }
            .card .p-3 { padding: 20px !important; }
        }
    </style>
    <link rel="stylesheet" href="/css/admin-responsive.css">
</head>
<body>
    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="bi bi-calendar-check"></i> Appointment Booking</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/nurse/profile" class="btn btn-outline-light btn-sm me-2">
                            <i class="bi bi-person-gear"></i> Profile
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <!--------- Flash Messages -------------->

        <%- include('../partials/flash') %>

        <!-- Welcome -->
        <div class="row">
            <div class="col-12">
                <div class="alert alert-success shadow-sm">
                    <h4 class="h5"><i class="bi bi-activity"></i> Nurse Dashboard</h4>
                    <p class="mb-0">Welcome to your nurse portal. Manage appointments, messages, patients, drivers, orders, and SMS campaigns.</p>
                </div>
            </div>
        </div>
        <!-- Dashboard Stats -->
        <div class="row g-2 g-md-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <div class="stat-number"><%= (stats && stats.total) || 0 %></div>
                    <small class="text-muted">Total Appointments</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <div class="stat-number text-warning"><%= (stats && stats.pending) || 0 %></div>
                    <small class="text-muted">Pending</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <div class="stat-number text-success"><%= (stats && stats.confirmed) || 0 %></div>
                    <small class="text-muted">Confirmed</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <div class="stat-number text-danger"><%= (stats && stats.cancelled) || 0 %></div>
                    <small class="text-muted">Cancelled</small>
                </div>
            </div>
        </div>
        

        <!-- Row 1: Quick Actions -->
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-calendar-check" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Appointments</h5>
                    <p class="small text-muted">Manage patient appointments.</p>
                    <a href="/nurse/nurse-appointments" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View All
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-envelope" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Messages</h5>
                    <p class="small text-muted">View patient messages.</p>
                    <a href="/nurse/nurse-messages" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View Messages
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-people" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Patients</h5>
                    <p class="small text-muted">Manage all patients.</p>
                    <a href="/nurse/nurse-patients" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View All
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-truck" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Drivers</h5>
                    <p class="small text-muted">Manage delivery drivers.</p>
                    <a href="/nurse/drivers" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View Drivers
                    </a>
                </div>
            </div>
        </div>

        <!-- Row 2: Orders, SMS, Track Drivers, Info -->
        <div class="row g-3 mt-3">
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-prescription" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Orders</h5>
                    <p class="small text-muted">Manage patient orders & dispatch.</p>
                    <a href="/nurse/nurse-orders" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View Orders
                    </a>
                </div>
            </div>

            <!-- SMS Campaigns -->
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-envelope-paper" style="font-size:2rem; color:#28a745;"></i>
                    <h5 class="mt-2">SMS Campaigns</h5>
                    <p class="small text-muted">Send automated notifications to patients.</p>
                    <div class="d-grid gap-2 mt-2">
                        <form action="/nurse/sms/birthday/send" method="POST">
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="bi bi-gift"></i> Send Birthday SMS
                            </button>
                        </form>
                        <form action="/nurse/sms/appointments/remind" method="POST">
                            <button type="submit" class="btn btn-info btn-sm w-100">
                                <i class="bi bi-calendar"></i> Send Appointment Reminders
                            </button>
                        </form>
                        <button class="btn btn-success btn-sm w-100" onclick="testSMS()">
                            <i class="bi bi-robot"></i> Test SMS Connection
                        </button>
                    </div>
                </div>
            </div>


                        <!-- Row 3: Announcement -->
            
                <div class="col-6 col-md-3">
                    <div class="card p-3 text-center">
                        <i class="bi bi-megaphone" style="font-size:2rem; color:#dc3545;"></i>
                        <h5 class="mt-2">Announcement</h5>
                        <p class="small text-muted">Send a broadcast SMS to all patients.</p>
                        <a href="/nurse/announcement" class="btn btn-danger btn-sm mt-auto">
                            <i class="bi bi-megaphone"></i> Send Announcement
                        </a>
                    </div>
                </div>
            


            <!-- ========== NEW: TRACK DRIVERS CARD ========== -->
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-geo-alt" style="font-size:2rem; color:#17a2b8;"></i>
                    <h5 class="mt-2">Track Drivers</h5>
                    <p class="small text-muted">View real-time driver locations.</p>
                    <a href="/nurse/track-drivers" class="btn btn-info btn-sm mt-auto">
                        <i class="bi bi-map"></i> Open Map
                    </a>
                </div>
            </div>

            <!-- Your Information -->
            <div class="col-6 col-md-3">
                <div class="card p-3 p-md-4">
                    <h5 class="h6"><i class="bi bi-person-badge"></i> Your Information</h5>
                    <hr>
                    <p><strong>Name:</strong> <%= user.name %></p>
                    <p><strong>Email:</strong> <%= user.email %></p>
                    <p><strong>Role:</strong> <span class="badge bg-primary"><%= user.role %></span></p>
                    <p><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function testSMS() {
            fetch('/nurse/sms/test')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ SMS connection successful!');
                    } else {
                        alert('❌ SMS connection failed: ' + (data.error || 'Unknown error'));
                    }
                })
                .catch(err => {
                    alert('❌ Error testing SMS: ' + err.message);
                });
        }

        // Auto-dismiss flash messages
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.alert').forEach(a => {
                setTimeout(() => {
                    a.style.transition = 'opacity 0.5s ease';
                    a.style.opacity = '0';
                    setTimeout(() => a.style.display = 'none', 500);
                }, 5000);
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>