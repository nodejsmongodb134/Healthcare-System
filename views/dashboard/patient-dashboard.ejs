<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        /* ========== GLOBAL RESET & BASE ========== */
        body {
            background: #f0f2f5;
            font-size: 14px;
            line-height: 1.5;
        }
        .navbar {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 10px 0;
        }
        .navbar-brand {
            font-size: 1.1rem;
            font-weight: 600;
        }
        .navbar-text {
            font-size: 0.85rem;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.08);
            border: none;
            transition: transform 0.2s;
            height: 100%;
        }
        .card:hover {
            transform: translateY(-3px);
        }
        .card .btn {
            border-radius: 25px;
            font-weight: 500;
        }
        .alert-info {
            background: #e3f2fd;
            border: none;
            color: #0d47a1;
            border-radius: 15px;
        }
        .alert-info h4 {
            font-size: 1.1rem;
        }
        .alert-info p {
            font-size: 0.9rem;
            margin-bottom: 0;
        }
        .btn-primary {
            background: #667eea;
            border: none;
        }
        .btn-primary:hover {
            background: #5a67d8;
        }
        .btn-outline-light {
            border-color: rgba(255,255,255,0.5);
            color: white;
        }
        .btn-outline-light:hover {
            background: rgba(255,255,255,0.2);
            border-color: white;
        }

        /* ========== RESPONSIVE TWEAKS ========== */

        /* Small devices (phones, < 576px) */
        @media (max-width: 575.98px) {
            body {
                font-size: 13px;
            }
            .container {
                padding-left: 12px;
                padding-right: 12px;
            }
            .navbar-brand {
                font-size: 0.95rem;
            }
            .navbar-text {
                font-size: 0.75rem;
            }
            .navbar .btn {
                font-size: 0.7rem;
                padding: 4px 8px;
            }
            .card {
                border-radius: 10px;
            }
            .card .p-3 {
                padding: 16px !important;
            }
            .card .p-4 {
                padding: 16px !important;
            }
            .btn {
                font-size: 0.7rem;
                padding: 5px 10px;
            }
            .alert-info h4 {
                font-size: 0.95rem;
            }
            .alert-info p {
                font-size: 0.8rem;
            }
            /* Make action cards stack with equal height */
            .row.g-3 > .col-md-3 {
                margin-bottom: 12px;
            }
            /* Improve info card */
            .card .p-4 h5 {
                font-size: 1rem;
            }
            .card .p-4 p {
                font-size: 0.85rem;
                margin-bottom: 4px;
            }
        }

        /* Medium devices (tablets, 576px – 991.98px) */
        @media (min-width: 576px) and (max-width: 991.98px) {
            .container {
                padding-left: 20px;
                padding-right: 20px;
            }
            .card .p-3 {
                padding: 20px !important;
            }
            .card .p-4 {
                padding: 20px !important;
            }
            .row.g-3 > .col-md-3 {
                margin-bottom: 16px;
            }
        }

        /* Large devices (desktops, ≥ 992px) */
        @media (min-width: 992px) {
            .container {
                padding-left: 40px;
                padding-right: 40px;
            }
            .row.g-3 > .col-md-3 {
                margin-bottom: 0;
            }
        }

        /* ========== UTILITIES ========== */
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .shadow-hover {
            transition: box-shadow 0.2s;
        }
        .shadow-hover:hover {
            box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        }
    </style>
</head>
<body>
    <!-- ========== NAVBAR with responsive toggler ========== -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-calendar-check"></i> Appointment Booking
            </a>
            <!-- Toggler button for mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <span class="navbar-text text-white me-3">
                            <i class="bi bi-person-circle"></i> Welcome, <%= user.name %>
                            <span class="badge bg-light text-dark ms-2"><%= user.role %></span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a href="/auth/logout" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- ========== HEADER ========== -->
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info shadow-sm">
                    <h4><i class="bi bi-activity"></i> Patient Dashboard</h4>
                    <p>Welcome to your patient portal. Here you can manage your appointments, messages, orders, and profile.</p>
                </div>
            </div>
        </div>

        <!-- ========== ACTION CARDS ========== -->
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center shadow-hover">
                    <i class="bi bi-calendar-plus" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Book Appointment</h5>
                    <p class="small text-muted">Schedule a new appointment with a nurse.</p>
                    <a href="/patient/appointment" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-plus-circle"></i> Book Now
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center shadow-hover">
                    <i class="bi bi-calendar-check" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">My Appointments</h5>
                    <p class="small text-muted">View your upcoming appointments.</p>
                    <a href="/patient/view-appointments" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-eye"></i> View All
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center shadow-hover">
                    <i class="bi bi-envelope" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Messages</h5>
                    <p class="small text-muted">Send a message to a nurse.</p>
                    <a href="/patient/message" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-plus-circle"></i> Send Message
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card p-3 text-center shadow-hover">
                    <i class="bi bi-prescription" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Orders</h5>
                    <p class="small text-muted">Order your prescription medications.</p>
                    <a href="/patient/order" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-plus-circle"></i> Place Order
                    </a>
                </div>
            </div>
        </div>

        <!-- ========== PROFILE & INFO ========== -->
        <div class="row g-3 mt-3">
            <div class="col-md-4">
                <div class="card p-3 text-center shadow-hover">
                    <i class="bi bi-person-gear" style="font-size:2rem; color:#667eea;"></i>
                    <h5 class="mt-2">Profile</h5>
                    <p class="small text-muted">Update your profile information.</p>
                    <a href="/patient/profile" class="btn btn-primary btn-sm mt-auto">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </a>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card p-3 p-md-4 shadow-hover">
                    <h5><i class="bi bi-person-badge"></i> Your Information</h5>
                    <hr>
                    <div class="row">
                        <div class="col-sm-6">
                            <p><strong>Name:</strong> <%= user.name %></p>
                            <p><strong>Email:</strong> <%= user.email %></p>
                        </div>
                        <div class="col-sm-6">
                            <p><strong>Role:</strong> <span class="badge bg-primary"><%= user.role %></span></p>
                            <p><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS bundle (for toggler and other components) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>